{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StartStatesFile",
  "description": "`start-states.yaml`.",
  "type": "object",
  "properties": {
    "states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StartState"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "states"
  ],
  "$defs": {
    "StartState": {
      "description": "A ready-made point to start from, with earlier steps already accounted for.",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "done": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepId"
          }
        },
        "id": {
          "type": "string"
        },
        "phase": {
          "description": "The phase to open.",
          "type": "string"
        },
        "set": {
          "description": "Options this start selects.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "skip": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepId"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "phase"
      ]
    },
    "StepId": {
      "description": "A stable step id: `<pack-id>.<phase>.<short-name>`, e.g. `demo-aircraft.preflight.irs-mode`.\nAn id never changes once published, even if the step is reworded or moved to another phase.",
      "type": "string"
    }
  }
}
