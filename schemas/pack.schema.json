{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PackManifest",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Optional path to `pack.schema.json`, so editors offer autocomplete. Ignored by the app.",
      "type": [
        "string",
        "null"
      ]
    },
    "aliases": {
      "type": [
        "string",
        "null"
      ]
    },
    "attribution": {
      "description": "Credit and terms notes.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "basisTags": {
      "description": "The `basis` tags this pack's lists may use: kinds of material, never document names.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "briefings": {
      "type": [
        "string",
        "null"
      ]
    },
    "cdu": {
      "type": [
        "string",
        "null"
      ]
    },
    "checklists": {
      "description": "Checklist files, in display order, relative to the pack folder.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependencies": {
      "description": "Other packs this one includes, with the versions it accepts.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "engine": {
      "description": "App versions this pack works with, e.g. `>=0.1, <1`.",
      "type": "string"
    },
    "faults": {
      "type": [
        "string",
        "null"
      ]
    },
    "glossary": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "description": "Lower-case id with dots and dashes, e.g. `ifly-737-max8` or `lib.boeing-cdu`.",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/PackKind"
    },
    "license": {
      "description": "SPDX licence id for the pack content, e.g. `CC-BY-NC-SA-4.0`.",
      "type": "string"
    },
    "lights": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "panels": {
      "description": "Panel files, in display order.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phases": {
      "description": "Phases, stages and options. Required for an aircraft pack.",
      "type": [
        "string",
        "null"
      ]
    },
    "schemaVersion": {
      "description": "Pack format version; the app rejects packs newer than it understands.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "startStates": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "schemaVersion",
    "kind",
    "engine",
    "license",
    "checklists"
  ],
  "$defs": {
    "PackKind": {
      "oneOf": [
        {
          "description": "A flyable aircraft (e.g. `ifly-737-max8`).",
          "type": "string",
          "const": "aircraft"
        },
        {
          "description": "Shared content other packs include (e.g. `lib.boeing-cdu`).",
          "type": "string",
          "const": "library"
        }
      ]
    }
  }
}
