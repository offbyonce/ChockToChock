{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlossaryFile",
  "description": "`glossary.yaml`.",
  "type": "object",
  "properties": {
    "terms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GlossaryEntry"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "terms"
  ],
  "$defs": {
    "GlossaryEntry": {
      "description": "One term and its meaning.",
      "type": "object",
      "properties": {
        "meaning": {
          "type": "string"
        },
        "term": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "term",
        "meaning"
      ]
    }
  }
}
