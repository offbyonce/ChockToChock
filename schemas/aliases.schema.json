{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AliasesFile",
  "description": "`aliases.yaml`.",
  "type": "object",
  "properties": {
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Alias"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "aliases"
  ],
  "$defs": {
    "Alias": {
      "description": "An old saved id and what replaced it. Lets saved progress carry over.",
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AliasKind"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "from",
        "to"
      ]
    },
    "AliasKind": {
      "description": "What an alias renames. Covers everything the previous release saved.",
      "oneOf": [
        {
          "description": "`to` is a step id.",
          "type": "string",
          "const": "step"
        },
        {
          "description": "`to` is a briefing item id.",
          "type": "string",
          "const": "briefing_item"
        },
        {
          "description": "A value typed into a blank. `to` is `<step-id>#<n>`, counting blanks from 0.",
          "type": "string",
          "const": "blank"
        },
        {
          "description": "`to` is a start state id.",
          "type": "string",
          "const": "start_state"
        },
        {
          "description": "A chosen option. `from` and `to` are `<option>:<value>`.",
          "type": "string",
          "const": "option_value"
        },
        {
          "description": "A saved flight value. `to` is a name from the app's fill list.",
          "type": "string",
          "const": "fill_field"
        },
        {
          "description": "`to` is a list id.",
          "type": "string",
          "const": "list"
        },
        {
          "description": "`to` is a phase id.",
          "type": "string",
          "const": "phase"
        },
        {
          "description": "`to` is a zone id.",
          "type": "string",
          "const": "zone"
        }
      ]
    }
  }
}
