{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Checklist",
  "description": "An ordered list of steps: a checklist, a flow or a non-normal procedure.",
  "type": "object",
  "properties": {
    "basis": {
      "description": "Kinds of material this list was checked against, from the tags the pack declares.\nNever a document name or a link.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ListKind"
    },
    "memory": {
      "description": "Part of the memory items.",
      "type": "boolean"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Step"
      }
    },
    "title": {
      "type": "string"
    },
    "when": {
      "description": "When to use this list.",
      "type": [
        "string",
        "null"
      ]
    },
    "why": {
      "description": "Why this list matters.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "kind",
    "basis",
    "steps"
  ],
  "$defs": {
    "AutoStart": {
      "description": "Starts a timer from the time earlier steps were ticked.",
      "type": "object",
      "properties": {
        "from": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepId"
          }
        },
        "pick": {
          "$ref": "#/$defs/AutoStartPick"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "pick"
      ]
    },
    "AutoStartPick": {
      "description": "Which of several ticked steps starts a timer.",
      "type": "string",
      "enum": [
        "earliest",
        "latest"
      ]
    },
    "Confirmation": {
      "description": "An internal maintenance record (decision 0013): the kind of source and the day it was\nrecorded, never who or which document. The app never shows it.",
      "type": "object",
      "properties": {
        "date": {
          "description": "`YYYY-MM-DD`.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ConfirmationKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "date"
      ]
    },
    "ConfirmationKind": {
      "description": "What a step or light note was confirmed against (decision 0013, which defines each kind).\nThe list grows by adding a kind there and here.",
      "oneOf": [
        {
          "description": "Matches the aircraft developer's documentation for the simulated aircraft.",
          "type": "string",
          "const": "vendor-docs"
        },
        {
          "description": "Matches an official public document from an aviation authority.",
          "type": "string",
          "const": "regulator-docs"
        }
      ]
    },
    "FillField": {
      "description": "The fixed list of flight values the app can fill in. Packs cannot add names; a new one\nneeds an app release.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "origin",
            "destination",
            "flight_number",
            "route",
            "runway",
            "sid",
            "transition",
            "initial_altitude",
            "squawk",
            "ground_frequency",
            "departure_frequency",
            "qnh",
            "heading",
            "takeoff_flaps",
            "landing_flaps",
            "v1",
            "vr",
            "v2",
            "vref",
            "cg",
            "takeoff_trim",
            "autobrake",
            "minimums",
            "landing_altitude",
            "minimum_takeoff_fuel",
            "fuel",
            "zfw",
            "takeoff_weight",
            "passengers",
            "cargo",
            "reserves",
            "cost_index",
            "cruise_level",
            "cruise_wind",
            "assumed_temperature",
            "thrust_reduction_altitude",
            "acceleration_altitude",
            "isa_deviation",
            "transition_altitude",
            "transition_level",
            "utc_time",
            "utc_date"
          ]
        },
        {
          "description": "A blank the pilot types in, with no linked value. Only valid in a step's `fill`.",
          "type": "string",
          "const": "manual"
        },
        {
          "description": "`LB` or `KG`, for fuel and weights.",
          "type": "string",
          "const": "weight_unit"
        },
        {
          "description": "`inHg` or `hPa`, for the QNH.",
          "type": "string",
          "const": "qnh_unit"
        },
        {
          "description": "`BARO` or `RADIO`, for the minimums.",
          "type": "string",
          "const": "minimums_type"
        },
        {
          "description": "Fuel in thousands, rounded up to the next tenth (calculated).",
          "type": "string",
          "const": "fuel_thousands"
        },
        {
          "description": "Fuel plus zero fuel weight, in thousands (calculated).",
          "type": "string",
          "const": "gross_weight"
        },
        {
          "description": "Outside air temperature at top of climb (calculated).",
          "type": "string",
          "const": "top_of_climb_oat"
        },
        {
          "description": "Latitude and longitude of the departure airport.",
          "type": "string",
          "const": "origin_position"
        },
        {
          "description": "The navigation database cycle (calculated).",
          "type": "string",
          "const": "nav_database"
        },
        {
          "description": "The dates that cycle is active (calculated).",
          "type": "string",
          "const": "nav_active_dates"
        },
        {
          "description": "One row of the route. Only valid in CDU text, with an `index` and a `part`.",
          "type": "string",
          "const": "route_leg"
        }
      ]
    },
    "HintPart": {
      "description": "One piece of a hint shown beside a step, e.g. `GND` and the ground frequency.",
      "type": "object",
      "properties": {
        "field": {
          "$ref": "#/$defs/FillField"
        },
        "prefix": {
          "description": "Literal text before the value, including any space, e.g. `SQUAWK `.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "prefix",
        "field"
      ]
    },
    "LightState": {
      "description": "The state a step expects a light in.",
      "type": "string",
      "enum": [
        "on",
        "out"
      ]
    },
    "ListKind": {
      "description": "What kind of list this is.",
      "oneOf": [
        {
          "description": "Read and confirm after the work is done.",
          "type": "string",
          "const": "checklist"
        },
        {
          "description": "A sequence of actions done from memory or by following along.",
          "type": "string",
          "const": "flow"
        },
        {
          "description": "For abnormal situations.",
          "type": "string",
          "const": "non-normal"
        }
      ]
    },
    "OptionTest": {
      "description": "One test against a pilot-chosen option. The options are declared by the pack.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "equals": {
              "type": "string"
            },
            "option": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "option",
            "equals"
          ]
        },
        {
          "type": "object",
          "properties": {
            "one_of": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "option": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "option",
            "one_of"
          ]
        }
      ]
    },
    "Quick": {
      "description": "When a step still shows in quick mode.",
      "type": "string",
      "enum": [
        "always",
        "turnaround"
      ]
    },
    "ShowIf": {
      "description": "When something is shown. Deliberately small: tests combine one level deep, with no\nnegation, comparisons, step state or expressions.",
      "anyOf": [
        {
          "$ref": "#/$defs/OptionTest"
        },
        {
          "type": "object",
          "properties": {
            "all_of": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/OptionTest"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "all_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "any_of": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/OptionTest"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "any_of"
          ]
        }
      ]
    },
    "Step": {
      "description": "One challenge and response line.",
      "type": "object",
      "properties": {
        "callout": {
          "description": "What the crew says.",
          "type": [
            "string",
            "null"
          ]
        },
        "check": {
          "type": [
            "string",
            "null"
          ]
        },
        "check_detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmed_by": {
          "description": "Internal record of what this step was confirmed against (decision 0013).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Confirmation"
          }
        },
        "controls": {
          "description": "Ids from the pack's controls file.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expect": {
          "description": "The expected response or position, e.g. \"NAV\". Always text, never a boolean.\n`___` marks a blank the pilot fills in.",
          "type": "string"
        },
        "explain": {
          "description": "Id of a shared explanation.",
          "type": [
            "string",
            "null"
          ]
        },
        "fill": {
          "description": "One field per `___` in `expect`, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FillField"
          }
        },
        "hint": {
          "description": "Flight values shown beside the expected response.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/HintPart"
          }
        },
        "how": {
          "description": "Id of a shared \"how to do it\" note.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/StepId"
        },
        "if_not": {
          "type": [
            "string",
            "null"
          ]
        },
        "if_not_detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "description": "Overrides the location text of the step's first control.",
          "type": [
            "string",
            "null"
          ]
        },
        "look_for": {
          "type": [
            "string",
            "null"
          ]
        },
        "non_recall": {
          "description": "In a memory list: read this step rather than recalling it.",
          "type": "boolean"
        },
        "not_simulated": {
          "description": "The simulator does not model this step, so it is left out of progress.",
          "type": "boolean"
        },
        "note": {
          "description": "Optional note shown under the step.",
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "description": "Printed number; absent for steps that are not numbered.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "opens": {
          "description": "Id of a CDU walkthrough this step can open.",
          "type": [
            "string",
            "null"
          ]
        },
        "panel_lights": {
          "description": "Panel lights this step refers to: control id, then light labels.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "quick": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quick"
            },
            {
              "type": "null"
            }
          ]
        },
        "section": {
          "description": "Starts a new titled section at this step.",
          "type": [
            "string",
            "null"
          ]
        },
        "show_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShowIf"
            },
            {
              "type": "null"
            }
          ]
        },
        "sim_simplified": {
          "description": "The simulator simplifies the real aircraft here.",
          "type": "boolean"
        },
        "simulator_model": {
          "description": "The step's note describes how the simulator behaves, not the real aircraft.",
          "type": "boolean"
        },
        "targets": {
          "description": "The panel items the step involves and the state it asks of each, which the control\ndrawings show exactly (decision 0018). `pack check` holds them to the step's wording.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepTarget"
          }
        },
        "text": {
          "description": "The challenge, e.g. \"IRS mode selectors\".",
          "type": "string"
        },
        "timer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timer"
            },
            {
              "type": "null"
            }
          ]
        },
        "walkaround": {
          "anyOf": [
            {
              "$ref": "#/$defs/WalkaroundPoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "why": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "expect"
      ]
    },
    "StepId": {
      "description": "A stable step id: `<pack-id>.<phase>.<short-name>`, e.g. `demo-aircraft.preflight.irs-mode`.\nAn id never changes once published, even if the step is reworded or moved to another phase.",
      "type": "string"
    },
    "StepTarget": {
      "description": "One panel item a step involves, and what the step asks of it (decision 0018).",
      "type": "object",
      "properties": {
        "at": {
          "description": "The item, as `panel/section/LABEL/n`: the n-th item (from 1) with that label in the\nsection, as light notes name them.",
          "type": "string"
        },
        "light": {
          "description": "The state the step expects a light in. Leave it out for a light that may cycle (window\nheat ON lights), so a drawing never claims a state the light may not be in.",
          "anyOf": [
            {
              "$ref": "#/$defs/LightState"
            },
            {
              "type": "null"
            }
          ]
        },
        "open": {
          "description": "The step's wording names one of the item's positions, but leaves it open: a condition\n(\"ON IF MORE THAN 1,000 LB\"), an option, one engine of two, or the word belongs to\nsomething else. The drawing claims no position, and `pack check` accepts the wording.",
          "type": "boolean"
        },
        "set": {
          "description": "The position the step sets a switch, selector, lever or handle to: one of its\n`positions`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "at"
      ]
    },
    "Timer": {
      "description": "A wait attached to a step.",
      "type": "object",
      "properties": {
        "auto_start": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutoStart"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "seconds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "seconds",
        "label"
      ]
    },
    "WalkaroundPoint": {
      "description": "A stop on the walkaround drawing.",
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    }
  }
}
