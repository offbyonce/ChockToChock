{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ControlsFile",
  "description": "`controls.yaml`.",
  "type": "object",
  "properties": {
    "controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Control"
      }
    },
    "overview": {
      "anyOf": [
        {
          "$ref": "#/$defs/Overview"
        },
        {
          "type": "null"
        }
      ]
    },
    "zones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Zone"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "zones",
    "controls"
  ],
  "$defs": {
    "Control": {
      "description": "A switch, lever or other control a step refers to.",
      "type": "object",
      "properties": {
        "function": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "zone": {
          "description": "Absent for controls with no place in the cockpit, such as a briefing.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "location",
        "function"
      ]
    },
    "Overview": {
      "description": "A schematic of the whole cockpit, in our own layout.",
      "type": "object",
      "properties": {
        "areas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OverviewArea"
          }
        },
        "captions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OverviewCaption"
          }
        },
        "height": {
          "type": "number",
          "format": "double"
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OverviewRegion"
          }
        },
        "width": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "areas"
      ]
    },
    "OverviewArea": {
      "description": "A rectangle on the cockpit overview map. A zone can have several.",
      "type": "object",
      "properties": {
        "height": {
          "type": "number",
          "format": "double"
        },
        "label": {
          "description": "Overrides the zone's short title on the map.",
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": "number",
          "format": "double"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zone": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "zone",
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "OverviewCaption": {
      "description": "A caption on the cockpit overview map.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "text",
        "x",
        "y"
      ]
    },
    "OverviewRegion": {
      "description": "A part of the cockpit on the overview map, e.g. the forward overhead panel. A map of one\nregion shows the areas whose centers fall inside its rectangle (the first region that\nholds them), with its captions around the edges.",
      "type": "object",
      "properties": {
        "bottom": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "description": "A short reference shown after the name, e.g. \"P5\".",
          "type": [
            "string",
            "null"
          ]
        },
        "height": {
          "type": "number",
          "format": "double"
        },
        "left": {
          "type": [
            "string",
            "null"
          ]
        },
        "locate": {
          "description": "Where to look from the seat, for \"Where is this?\".",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "right": {
          "type": [
            "string",
            "null"
          ]
        },
        "top": {
          "description": "Captions for the edges, saying which way each faces.",
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": "number",
          "format": "double"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "Zone": {
      "description": "An area of the cockpit.",
      "type": "object",
      "properties": {
        "area": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "short_title": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "area",
        "title",
        "short_title"
      ]
    }
  }
}
