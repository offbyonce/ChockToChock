{
  "options": [
    {
      "id": "power",
      "title": "Power source",
      "values": [
        "gpu",
        "apu"
      ],
      "default": "gpu"
    },
    {
      "id": "start",
      "title": "Start type",
      "values": [
        "cold",
        "turn"
      ],
      "default": "cold"
    },
    {
      "id": "approach",
      "title": "Approach type",
      "values": [
        "ils",
        "rnav",
        "vis"
      ],
      "default": "ils"
    }
  ],
  "stages": [
    {
      "title": "Preflight",
      "phases": [
        {
          "phase": "cold-dark",
          "show_if": {
            "option": "start",
            "equals": "cold"
          }
        },
        {
          "phase": "gpu-power",
          "show_if": {
            "all_of": [
              {
                "option": "power",
                "equals": "gpu"
              },
              {
                "option": "start",
                "equals": "cold"
              }
            ]
          }
        },
        {
          "phase": "apu-power",
          "show_if": {
            "all_of": [
              {
                "option": "power",
                "equals": "apu"
              },
              {
                "option": "start",
                "equals": "cold"
              }
            ]
          }
        },
        {
          "phase": "exterior"
        },
        {
          "phase": "preflight"
        }
      ]
    },
    {
      "title": "Departure",
      "phases": [
        {
