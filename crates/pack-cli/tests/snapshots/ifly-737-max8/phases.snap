    {
      "id": "memory",
      "title": "Memory items",
      "reference": true,
      "intro": [
        {
          "text": "Simulator training only. Not for real-world use."
        },
        {
          "heading": "What these are",
          "text": "Steps for events so urgent there is no time to read a checklist. You learn them by heart and do them in order."
        },
        {
          "heading": "When to use them",
          "text": "As soon as you recognize the event. Fly the airplane first."
        },
        {
          "heading": "What comes next",
          "text": "Once the recall steps are done, open the QRH to confirm them and finish the checklist. Steps marked Follow-up are read, not memorized."
        }
      ],
      "lists": [
        "memory-runaway-stabilizer",
        "memory-airspeed-unreliable",
        "memory-cabin-altitude-warning-or-rapid-depressurization",
        "memory-smoke-fire-or-fumes"
      ]
    },
    {
      "id": "quick-reference",
      "title": "Quick reference",
      "reference": true,
      "intro": [
        {
          "heading": "What these are",
          "text": "Short checklists for time-critical events, kept where you can reach them quickly."
        },
        {
          "heading": "When to use them",
          "text": "When a warning or event calls for one. The pilot monitoring usually reads each step, and the crew confirms before moving a critical control."
        },
        {
          "heading": "How they differ from memory items",
          "text": "You read these rather than recite them, although operators differ and many require some from memory. Finish with the full QRH checklist."
        }
      ],
      "lists": [
        "quick-reference-aborted-engine-start",
        "quick-reference-engine-fire-severe-damage-or-separation",
        "quick-reference-engine-limit-surge-or-stall",
        "quick-reference-engine-overheat",
        "quick-reference-loss-of-thrust-on-both-engines",
        "quick-reference-apu-fire",
        "quick-reference-emergency-descent",
        "quick-reference-overspeed",
        "quick-reference-engine-tailpipe-fire",
        "quick-reference-lower-compartment-cargo-fire",
        "quick-reference-wheel-well-fire",
        "quick-reference-landing-configuration-warning",
        "quick-reference-passenger-evacuation"
      ]
    },
    {
      "id": "procedures",
      "title": "Non-normal procedures",
      "reference": true,
      "intro": [
        {
          "text": "Maneuvers, go-around and MAX trim and airspeed procedures for situations outside the normal flow."
