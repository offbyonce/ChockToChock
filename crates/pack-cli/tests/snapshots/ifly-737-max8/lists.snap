  {
    "id": "secure-secure-procedure",
    "title": "Secure procedure",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.secure.irs",
        "number": 1,
        "text": "IRS",
        "expect": "OFF",
        "controls": [
          "irs"
        ],
        "targets": [
          {
            "at": "aft/irs/IRS L/1",
            "set": "OFF"
          },
          {
            "at": "aft/irs/IRS R/1",
            "set": "OFF"
          }
        ],
        "quick": "always",
        "note": "Stops the navigation system. It must realign before the next flight.",
        "why": "Must realign before the next flight",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.secure.emergency-exit-lights",
        "number": 2,
        "text": "EMERGENCY EXIT LIGHTS",
        "expect": "OFF",
        "controls": [
          "emerext"
        ],
        "targets": [
          {
            "at": "oh/col/NOT ARMED/1",
            "light": "on"
          },
          {
            "at": "oh/col/EMER EXIT LIGHTS/1",
            "set": "OFF"
          }
        ],
        "quick": "always",
        "why": "ARMED would light the exit lights when power goes off",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.secure.window-heat-switches",
        "text": "WINDOW HEAT SWITCHES",
        "expect": "OFF",
        "controls": [
          "wheat"
        ],
        "targets": [
          {
            "at": "oh/heat/L SIDE/1",
            "set": "OFF"
          },
          {
            "at": "oh/heat/L FWD/1",
            "set": "OFF"
          },
          {
            "at": "oh/heat/R FWD/1",
            "set": "OFF"
          },
          {
            "at": "oh/heat/R SIDE/1",
            "set": "OFF"
          }
        ],
        "quick": "always",
        "why": "Not needed once the airplane is secured",
        "check": "All four window heat switches OFF",
        "check_detail": "Green ON lights out",
        "if_not": "An ON light stays lit",
        "if_not_detail": "That switch is still on",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.secure.pack-switches",
        "number": 3,
        "text": "PACK SWITCHES",
        "expect": "OFF",
        "controls": [
          "packs"
        ],
        "targets": [
          {
            "at": "oh/bleed/L PACK/1",
            "set": "OFF"
          },
          {
            "at": "oh/bleed/R PACK/1",
            "set": "OFF"
          }
        ],
        "why": "Stops the packs before the air source goes off",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.secure.apu-or-ground-power",
        "number": 4,
        "text": "APU OR GROUND POWER",
        "expect": "OFF",
        "controls": [
          "apub"
        ],
        "targets": [
          {
            "at": "oh/elecl/GEN 1/1",
            "set": "OFF"
          },
          {
            "at": "oh/elecl/APU GEN/1",
            "set": "OFF"
          },
          {
            "at": "oh/elecl/APU GEN/2",
            "set": "OFF"
          },
          {
            "at": "oh/elecl/GEN 2/1",
            "set": "OFF"
          }
        ],
        "quick": "always",
        "note": "Do this just before the battery goes off.",
        "why": "Removes AC power from the airplane",
        "panel_lights": {
          "apub": [
            "APU GEN"
          ]
        },
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.secure.before-battery-off",
        "text": "BEFORE BATTERY OFF",
        "expect": "IF THE APU RAN, WAIT ABOUT 5 MINUTES AFTER THE APU GEN OFF BUS LIGHT GOES OUT",
        "controls": [
          "genbus"
        ],
        "targets": [
          {
            "at": "oh/elecl/APU GEN OFF BUS/1",
            "light": "out"
          }
        ],
        "quick": "always",
        "why": "Lets the APU finish its shutdown before power is removed",
        "timer": {
          "seconds": 300,
          "label": "APU shutdown wait",
          "note": "Starts by itself when you tick APU or ground power off.",
          "auto_start": {
            "from": [
              "ifly-737-max8.secure.apu-or-ground-power",
              "ifly-737-max8.secure.apu-or-ground-power-check"
            ],
            "pick": "earliest"
          }
        },
        "panel_lights": {
          "genbus": [
            "APU GEN OFF BUS"
          ]
        }
      },
      {
        "id": "ifly-737-max8.secure.battery",
        "number": 5,
        "text": "BATTERY",
        "expect": "OFF",
        "controls": [
          "bat"
        ],
        "targets": [
          {
            "at": "oh/elecu/BATTERY/1",
            "set": "OFF"
          }
        ],
        "quick": "always",
        "note": "The last switch.",
        "why": "Stops battery drain",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      }
    ]
  },
