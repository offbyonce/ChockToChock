  {
    "id": "landing-before-landing-procedure",
    "title": "Before landing procedure",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.landing.flap-lever",
        "number": 1,
        "text": "FLAP LEVER",
        "expect": "EXTEND PER SPEED SCHEDULE. BE STABILIZED BY 1,000 FT IMC OR 500 FT VMC",
        "controls": [
          "flaplever",
          "speedt"
        ],
        "targets": [
          {
            "at": "con/st/FLAP LEVER/1",
            "set": "1"
          }
        ],
        "quick": "always",
        "why": "Configure early so you are stable by 1,000 ft in cloud or 500 ft in visual conditions",
        "how": "flapdn",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.landing.landing-gear-lever",
        "number": 2,
        "text": "LANDING GEAR LEVER",
        "expect": "DOWN WHEN SPEED ALLOWS",
        "controls": [
          "gearlever"
        ],
        "targets": [
          {
            "at": "mn/ctr/LEFT GEAR/2",
            "light": "on"
          },
