  {
    "id": "taxi-taxi",
    "title": "Taxi",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.taxi.taxi-clearance",
        "number": 1,
        "text": "TAXI CLEARANCE",
        "expect": "OBTAIN",
        "controls": [
          "atcclr"
        ],
        "targets": [
          {
            "at": "con/r1/VHF RADIO 1/1"
          }
        ],
        "hint": [
          {
            "prefix": "GND ",
            "field": "ground_frequency"
          }
        ],
        "why": "Request it and read it back",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.taxi.taxi-and-runway-turnoff-lights",
        "number": 2,
        "text": "TAXI AND RUNWAY TURNOFF LIGHTS",
        "expect": "ON",
        "controls": [
          "lldg",
          "turnoff"
        ],
        "targets": [
          {
            "at": "oh/ltl/TAXI/1",
            "set": "ON"
          },
          {
            "at": "oh/ltl/TURNOFF L/1",
            "set": "ON"
          },
          {
            "at": "oh/ltl/TURNOFF R/1",
            "set": "ON"
          }
        ],
        "quick": "always",
        "note": "Lets you and others see the taxiway at night or in low visibility.",
        "why": "See and be seen on the taxiway"
      },
      {
        "id": "ifly-737-max8.taxi.wing-light",
        "text": "WING LIGHT",
        "expect": "ON",
        "controls": [
          "winglt"
        ],
        "targets": [
          {
            "at": "oh/lte/WING/1",
            "set": "ON"
          }
        ],
        "why": "Makes the airplane visible and lights the wing for ice checks",
        "check": "Wing leading edges lit"
      },
      {
        "id": "ifly-737-max8.taxi.parking-brake",
        "number": 3,
        "text": "PARKING BRAKE",
        "expect": "RELEASE",
        "controls": [
          "pbrake"
        ],
        "targets": [
          {
            "at": "con/lo/PARKING BRAKE/1",
            "set": "RELEASED"
          }
        ],
        "quick": "always",
        "why": "Brakes off to taxi",
        "check": "Parking brake light OUT"
      },
      {
        "id": "ifly-737-max8.taxi.taxi-thrust",
        "text": "TAXI THRUST",
        "expect": "ABOUT 30% N1 TO START MOVING, THEN 22 TO 25% N1, 15 KNOTS OR LESS",
        "why": "More thrust is needed to break away than to keep rolling.",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      }
    ]
  },
