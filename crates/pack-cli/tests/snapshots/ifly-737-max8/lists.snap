        ],
        "targets": [
          {
            "at": "oh/start/ENGINE START 1/1",
            "set": "FLT"
          },
          {
            "at": "oh/start/ENGINE START 2/1",
            "set": "FLT"
          }
        ],
        "panel_lights": {
          "starts": [
            "ENGINE START 1",
            "ENGINE START 2"
          ]
        }
      },
      {
        "id": "ifly-737-max8.quick-reference.start-levers-both",
        "number": 3,
        "text": "START LEVERS (BOTH)",
        "expect": "CUTOFF",
        "controls": [
          "slever"
        ],
        "targets": [
          {
            "at": "con/lo/START LEVER 1/1",
            "set": "CUTOFF"
          },
          {
            "at": "con/lo/START LEVER 2/1",
            "set": "CUTOFF"
          }
        ]
      },
      {
        "id": "ifly-737-max8.quick-reference.when-egt-decreases",
        "number": 4,
        "text": "ONCE EGT STARTS FALLING",
        "expect": "BOTH START LEVERS TO IDLE",
        "controls": [
          "slever"
        ],
        "targets": [
          {
            "at": "con/lo/START LEVER 1/1",
            "set": "IDLE"
          },
          {
            "at": "con/lo/START LEVER 2/1",
            "set": "IDLE"
          }
        ]
      },
      {
        "id": "ifly-737-max8.quick-reference.if-egt-reaches-a-redline-or-does-not-rise-in-30",
        "number": 5,
        "text": "EGT AT REDLINE, OR FLAT FOR 30 SECONDS",
        "expect": "THAT START LEVER TO CUTOFF, THEN BACK TO IDLE. REPEAT IF NEEDED",
