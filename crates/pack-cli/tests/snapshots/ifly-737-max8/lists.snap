        "why": "Holds the airplane while parked",
        "check": "Parking brake light ON",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.engine-start-levers-check",
        "text": "ENGINE START LEVERS",
        "expect": "CUTOFF",
        "controls": [
          "slever"
