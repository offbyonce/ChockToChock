  {
    "id": "quick-reference-loss-of-thrust-on-both-engines",
    "title": "Loss of thrust on both engines",
    "kind": "non-normal",
    "basis": [
      "prior-release"
    ],
    "when": "Both engines lose thrust.",
    "why": "Set airspeed for a restart and use the ignition and restart sequence. Start the APU for power.",
    "steps": [
      {
        "id": "ifly-737-max8.quick-reference.airspeed",
        "number": 1,
        "text": "AIRSPEED",
