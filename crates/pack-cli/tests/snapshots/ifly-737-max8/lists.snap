      {
        "id": "ifly-737-max8.exterior.left-aft-fuselage",
        "number": 12,
        "text": "LEFT AFT FUSELAGE",
        "expect": "CHECKED",
        "controls": [
          "extins"
        ],
        "walkaround": {
          "x": 128,
          "y": 300
        },
        "look_for": "Unused doors closed. Negative pressure relief door closed. Outflow valve and fuselage detectors clear.",
        "location": "Left side, behind the wing."
      },
      {
        "id": "ifly-737-max8.exterior.left-main-gear",
        "number": 13,
        "text": "LEFT MAIN GEAR",
        "expect": "CHECKED",
        "controls": [
          "extins"
        ],
        "walkaround": {
          "x": 130,
          "y": 212
        },
        "look_for": "Gear pin installed; the ground crew removes it before pushback. Tires, wheels, gear strut, hydraulic lines and brakes undamaged, with no leaks. Check brake wear indicators with the parking brake set.",
        "location": "Under the left wing root."
      },
      {
        "id": "ifly-737-max8.exterior.left-trailing-edge",
        "number": 14,
        "text": "LEFT TRAILING EDGE",
        "expect": "CHECKED",
        "controls": [
          "extins"
        ],
        "walkaround": {
          "x": 70,
          "y": 236
        },
        "look_for": "Aileron and trailing edge flaps undamaged, with no leaks.",
        "location": "Rear edge of the left wing."
      },
      {
        "id": "ifly-737-max8.exterior.left-wing-tip",
        "number": 15,
        "text": "LEFT WING TIP",
        "expect": "CHECKED",
        "controls": [
          "extins"
        ],
        "walkaround": {
          "x": 10,
          "y": 226
        },
        "look_for": "Position, strobe and winglet aft marker lights intact. Static discharge wicks in place.",
        "location": "End of the left wing."
      },
      {
        "id": "ifly-737-max8.exterior.left-wing-and-leading-edge",
        "number": 16,
        "text": "LEFT WING AND LEADING EDGE",
        "expect": "CHECKED",
        "controls": [
          "extins"
        ],
        "walkaround": {
          "x": 50,
          "y": 180
        },
        "look_for": "No ice, frost or contamination on the upper surface or leading edge. Leading edge flaps and slats undamaged.",
        "location": "Front edge and top of the left wing."
      },
      {
        "id": "ifly-737-max8.exterior.engine-1",
        "number": 17,
        "text": "ENGINE 1",
