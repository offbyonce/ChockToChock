        "expect": "VERIFY LEVEL AND MODES",
        "controls": [
          "fma"
        ],
        "targets": [
          {
            "at": "mn/cd/OUTBOARD DU: PFD/1"
          }
        ],
        "note": "Confirm the airplane has leveled, and read the FMA.",
        "why": "Confirms the capture",
        "check": "Level at cruise",
        "check_detail": "FMA correct"
      },
      {
        "id": "ifly-737-max8.cruise.fuel",
        "number": 2,
        "text": "FUEL",
        "expect": "CONFIRM ENOUGH TO REACH THE DESTINATION",
        "controls": [
          "fuelq"
        ],
        "targets": [
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          }
        ],
        "note": "Compare fuel used with your plan, and check the tanks stay balanced.",
        "why": "Catches a problem early",
        "check": "PROGRESS page fuel at the destination above reserves",
        "check_detail": "Tanks balanced",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.cruise.center-fuel-pumps",
        "number": 3,
