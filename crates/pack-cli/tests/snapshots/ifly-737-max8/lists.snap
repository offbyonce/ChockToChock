        "targets": [
          {
            "at": "con/st/STAB TRIM WHEEL/1"
          },
          {
            "at": "con/st/STAB TRIM WHEEL/2"
          }
        ],
        "fill": [
          "takeoff_trim"
        ],
        "why": "Sets the pitch forces at rotation",
        "check": "Trim matches the takeoff data",
        "check_detail": "In the green band",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      }
    ]
  },
  {
    "id": "takeoff-line-up",
    "title": "Line up",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.takeoff.engine-warm-up",
        "number": 1,
        "text": "ENGINE WARM-UP",
        "expect": "MINIMUM 3 MINUTES AT IDLE, OIL AT LEAST 31C BEFORE TAKEOFF THRUST",
        "controls": [
          "engmon"
        ],
        "targets": [
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          },
          {
            "at": "con/ed/ENG/1"
          }
        ],
        "note": "Cold engines need time at idle before takeoff thrust.",
        "why": "Cold engines need time at idle",
        "check": "3 minutes at idle",
        "check_detail": "Oil at least 31C",
        "timer": {
          "seconds": 180,
          "label": "Engine warm-up",
          "note": "Starts by itself from your last start lever tick in Engine start.",
          "auto_start": {
            "from": [
              "ifly-737-max8.engine-start.engine-2-start-lever",
              "ifly-737-max8.engine-start.engine-1-start-lever"
            ],
            "pick": "latest"
          }
        }
      },
      {
        "id": "ifly-737-max8.takeoff.engine-start-switches",
        "number": 2,
        "text": "ENGINE START SWITCHES",
        "expect": "CONT",
        "controls": [
          "starts"
        ],
        "targets": [
          {
            "at": "oh/start/ENGINE START 1/1",
            "set": "CONT"
          },
          {
            "at": "oh/start/ENGINE START 2/1",
            "set": "CONT"
          }
        ],
        "why": "Igniters ready against a flameout on takeoff",
        "panel_lights": {
          "starts": [
            "ENGINE START 1",
            "ENGINE START 2"
          ]
        }
      },
      {
        "id": "ifly-737-max8.takeoff.position-light",
        "number": 3,
        "text": "POSITION LIGHT",
        "expect": "STROBE & STEADY",
        "controls": [
          "poslt"
        ],
        "targets": [
          {
            "at": "oh/lte/POSITION/1",
            "set": "STROBE & STEADY"
          }
        ],
        "quick": "always",
        "why": "Strobes on for takeoff and flight",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.takeoff.takeoff-clearance",
        "number": 4,
        "text": "TAKEOFF CLEARANCE",
        "expect": "OBTAIN",
        "controls": [
          "atcclr"
        ],
        "targets": [
          {
            "at": "con/r1/VHF RADIO 1/1"
          }
        ],
        "why": "Request it and read it back",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.takeoff.landing-lights",
        "number": 5,
        "text": "LANDING LIGHTS",
        "expect": "ON",
        "controls": [
          "landlt"
        ],
        "targets": [
          {
            "at": "oh/ltl/LANDING L/1",
            "set": "ON"
          },
          {
            "at": "oh/ltl/LANDING R/1",
            "set": "ON"
          }
        ],
        "quick": "always",
        "note": "Turning on the landing lights shows others you are about to roll.",
        "why": "Shows others you are about to roll",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.takeoff.transponder",
        "number": 6,
        "text": "TRANSPONDER",
        "expect": "MODE SELECTOR TA/RA",
        "controls": [
          "xpndr"
        ],
        "targets": [
          {
            "at": "con/atc/MODE/1",
            "set": "TA/RA"
          }
        ],
        "quick": "always",
        "note": "TA/RA gives you full TCAS alerts in the air.",
        "why": "Full TCAS alerts in the air",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.takeoff.heading",
        "number": 7,
        "text": "HEADING",
        "expect": "AGREES WITH THE RUNWAY",
        "controls": [
          "pfdhdg"
        ],
        "targets": [
          {
            "at": "mn/cd/OUTBOARD DU: PFD/1"
          }
        ],
        "why": "Last check of the runway",
        "check": "Heading matches the runway",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.takeoff.runway-and-entry-point",
        "number": 8,
        "text": "RUNWAY AND ENTRY POINT",
        "expect": "CORRECT RUNWAY AND ENTRY",
        "controls": [
          "pfdhdg"
        ],
        "targets": [
          {
            "at": "mn/cd/OUTBOARD DU: PFD/1"
          }
        ],
        "hint": [
          {
            "prefix": "RWY ",
            "field": "runway"
          }
        ],
        "note": "Check the runway signs and your position on the ND, to be sure you are lining up on the right runway.",
        "why": "Be sure it is the right runway",
        "check": "Runway signs and ND agree",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      }
    ]
  },
  {
    "id": "takeoff-takeoff-roll",
    "title": "Takeoff roll",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.takeoff.thrust-levers",
        "number": 1,
        "text": "THRUST LEVERS",
        "expect": "ADVANCE TO ABOUT 40% N1, LET ENGINES STABILIZE",
        "controls": [
          "thrust"
        ],
        "targets": [
          {
            "at": "con/st/THRUST LEVERS 1 AND 2/1"
          }
        ],
        "quick": "always",
        "note": "Advance to about 40% N1 and let both engines settle before TO/GA.",
        "why": "Stable engines before TO/GA",
        "check": "Both engines steady",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.takeoff.to-ga",
        "number": 2,
        "text": "TO/GA",
        "expect": "PUSH",
        "controls": [
          "toga"
        ],
        "targets": [
          {
            "at": "con/st/TO/GA/1"
          }
        ],
        "quick": "always",
        "note": "Sets takeoff thrust and takeoff guidance. Check the FMA.",
        "why": "Sets takeoff thrust and guidance",
        "check": "FMA shows N1 and TO/GA",
        "check_detail": "Thrust levers move forward",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.takeoff.takeoff-thrust",
        "number": 3,
        "text": "TAKEOFF THRUST",
        "expect": "TAKEOFF N1 SET, INDICATIONS NORMAL",
        "controls": [
          "engmon"
        ],
        "targets": [
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          },
          {
            "at": "con/ed/ENG/1"
          }
        ],
        "note": "Check the thrust reaches takeoff N1 and all engine indications are normal.",
        "why": "Takeoff thrust should be set by about 60 knots, before the autothrottle stops adjusting it.",
        "check": "Thrust at takeoff N1",
        "check_detail": "Engine indications normal",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.takeoff.80-knots",
        "number": 4,
        "text": "80 KNOTS",
        "expect": "AIRSPEEDS AGREE",
        "controls": [
          "speedt"
        ],
        "targets": [
          {
            "at": "mn/cd/OUTBOARD DU: PFD/1"
          }
        ],
        "note": "Both airspeed indicators should agree here. Below this speed you reject for more reasons than above it.",
        "why": "More reasons to reject below this speed",
        "check": "Both airspeeds agree",
        "callout": "Pilot monitoring: \"80 knots.\""
      },
      {
        "id": "ifly-737-max8.takeoff.v1",
        "number": 5,
        "text": "V1",
        "expect": "HANDS OFF THRUST LEVERS",
        "controls": [
          "speedt"
        ],
        "targets": [
          {
            "at": "mn/cd/OUTBOARD DU: PFD/1"
          }
        ],
        "note": "After V1, continue the takeoff. Hands come off the thrust levers so you do not reject by habit.",
        "why": "Hands off the levers so you do not reject out of habit after V1"
      },
      {
        "id": "ifly-737-max8.takeoff.vr",
        "number": 6,
        "text": "VR",
        "expect": "ROTATE TOWARD 15 DEGREES PITCH",
        "controls": [
          "speedt"
        ],
        "targets": [
          {
            "at": "mn/cd/OUTBOARD DU: PFD/1"
          }
        ],
        "quick": "always",
        "note": "Rotate smoothly toward 15 degrees pitch.",
        "why": "A smooth rotation avoids a tail strike and lets the airplane reach V2 in the climb",
        "callout": "Pilot monitoring: \"Rotate.\"",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.takeoff.positive-rate",
        "number": 7,
        "text": "POSITIVE RATE",
        "expect": "ALTIMETER AND VERTICAL SPEED INCREASING",
        "controls": [
          "fltinst"
        ],
        "targets": [
          {
            "at": "mn/cd/OUTBOARD DU: PFD/1"
          },
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          },
          {
            "at": "mn/fd/INBOARD DU: ND/1"
          },
          {
            "at": "mn/fd/OUTBOARD DU: PFD/1"
          }
        ],
        "note": "Confirm the airplane is climbing on two instruments before raising the gear.",
        "why": "Climb confirmed on two instruments",
        "check": "Altimeter and vertical speed rising",
        "callout": "Pilot monitoring: \"Positive rate.\" Pilot flying: \"Gear up.\"",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      }
    ]
  },
  {
    "id": "after-takeoff-after-takeoff-procedure",
    "title": "After takeoff procedure",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.after-takeoff.landing-gear-lever",
        "number": 1,
        "text": "LANDING GEAR LEVER",
        "expect": "UP",
        "controls": [
          "gearup"
        ],
        "targets": [
          {
            "at": "mn/ctr/LANDING GEAR LEVER/1",
            "set": "UP"
          }
        ],
        "quick": "always",
        "why": "Gear up and locked",
        "check": "Red and green gear lights OUT",
        "check_detail": "Raise the gear only after a positive rate of climb",
        "callout": "Pilot monitoring, when all gear lights are out: \"Gear is up.\"",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.after-takeoff.flap-lever",
        "number": 2,
        "text": "FLAP LEVER",
        "expect": "RETRACT ON SPEED SCHEDULE",
        "controls": [
          "flaplever",
          "speedt"
        ],
        "targets": [
          {
            "at": "con/st/FLAP LEVER/1"
          }
        ],
        "quick": "always",
        "why": "Retract one step at a time, at or above each flap mark on the speed tape. Retracting early loses lift",
        "how": "flapup",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.after-takeoff.pack-switches",
        "number": 3,
        "text": "PACK SWITCHES",
        "expect": "VERIFY AUTO",
        "controls": [
          "packs"
        ],
        "targets": [
          {
            "at": "oh/bleed/L PACK/1",
            "set": "AUTO"
          },
          {
            "at": "oh/bleed/R PACK/1",
            "set": "AUTO"
          }
        ],
        "why": "If the packs were off for takeoff, set them back to AUTO now so the cabin pressurizes",
        "check": "Both PACK switches at AUTO, PACK lights OUT",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      }
    ]
  },
  {
    "id": "after-takeoff-after-takeoff-checklist",
    "title": "After takeoff checklist",
    "kind": "checklist",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.after-takeoff.engine-bleeds",
