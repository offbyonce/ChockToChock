        "why": "Confirms the instruments before flight",
        "check": "Heading and altimeter agree",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.parking-brake-check",
        "text": "PARKING BRAKE",
        "expect": "SET",
        "controls": [
          "pbrake"
