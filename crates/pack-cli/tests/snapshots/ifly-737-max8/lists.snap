        "controls": [
          "fuelq",
          "fuelpumps"
        ],
        "targets": [
          {
            "at": "oh/fuel/CTR L/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/CTR R/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/AFT 1/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/FWD 1/1",
            "set": "ON"
