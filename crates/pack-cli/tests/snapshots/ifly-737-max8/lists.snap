        "expect": "OFF WHEN BOTH LOW PRESSURE LIGHTS COME ON",
        "controls": [
          "fuelpumps"
        ],
        "targets": [
          {
            "at": "oh/fuel/LOW PRESSURE/1",
            "light": "on"
          },
          {
            "at": "oh/fuel/LOW PRESSURE/2",
            "light": "on"
          },
          {
            "at": "oh/fuel/CTR L/1",
            "set": "OFF"
          },
          {
            "at": "oh/fuel/CTR R/1",
            "set": "OFF"
          }
        ],
        "quick": "always",
        "note": "Switch them off when the center tank is empty. Running them dry is a safety risk.",
        "why": "Running pumps dry is a safety risk",
        "check": "Both lights on first",
        "if_not": "One light on",
        "if_not_detail": "Leave both center pumps ON until both LOW PRESSURE lights are on",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.cruise.anti-ice",
