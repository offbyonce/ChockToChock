  {
    "id": "procedures-rejected-takeoff",
    "title": "Rejected takeoff",
    "kind": "non-normal",
    "basis": [
      "prior-release"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.procedures.below-80-knots",
        "number": 1,
        "text": "BELOW 80 KNOTS",
        "expect": "STOP FOR ANY OF THE ABOVE, OR: MASTER CAUTION, A SYSTEM FAILURE, ODD NOISE OR SHAKING, A BLOWN TIRE, SLUGGISH ACCELERATION, A CONFIG WARNING, OR A WINDOW COMING OPEN",
        "controls": [
          "speedt"
        ],
        "targets": [
          {
            "at": "mn/cd/OUTBOARD DU: PFD/1"
          }
        ]
      },
      {
        "id": "ifly-737-max8.procedures.80-knots-to-v1",
        "number": 2,
        "text": "80 KNOTS TO V1",
        "expect": "STOP ONLY FOR: ENGINE FAILURE, A FIRE OR ITS WARNING, A WINDSHEAR ALERT, OR AN AIRPLANE THAT CANNOT FLY SAFELY",
        "controls": [
          "speedt"
        ],
        "targets": [
          {
            "at": "mn/cd/OUTBOARD DU: PFD/1"
          }
        ]
      },
