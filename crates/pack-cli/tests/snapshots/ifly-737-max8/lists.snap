          },
          {
            "at": "gl/efisr/MODE/1"
          },
          {
            "at": "gl/efisr/RANGE/1"
          },
          {
            "at": "gl/efisr/WXR/1"
          },
          {
            "at": "gl/efisr/TERR/1"
          },
          {
            "at": "gl/efisr/POS/1"
          },
          {
