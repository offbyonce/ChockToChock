          "engmon"
        ],
        "targets": [
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          },
          {
            "at": "con/ed/ENG/1"
          }
        ]
      },
      {
        "id": "ifly-737-max8.quick-reference.engine-acceleration",
        "number": 6,
        "text": "ENGINE ACCELERATION",
        "expect": "MAY BE VERY SLOW. LEAVE THE START ALONE WHILE N2 CLIMBS AND EGT STAYS IN LIMITS",
        "controls": [
          "engmon"
        ],
        "targets": [
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          },
          {
            "at": "con/ed/ENG/1"
          }
        ]
      },
      {
        "id": "ifly-737-max8.quick-reference.apu-if-available",
        "number": 7,
        "text": "APU (IF AVAILABLE)",
        "expect": "START AND PUT ON BUSES. DO NOT WAIT FOR ENGINE START",
