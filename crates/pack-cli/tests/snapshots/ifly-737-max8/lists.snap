  {
    "id": "taxi-in-taxi-in",
    "title": "Taxi in",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.taxi-in.taxi-clearance",
        "number": 1,
        "text": "TAXI CLEARANCE",
        "expect": "OBTAIN",
        "controls": [
          "atcclr"
        ],
        "targets": [
          {
            "at": "con/r1/VHF RADIO 1/1"
          }
        ],
        "why": "Request it and read it back"
      },
      {
        "id": "ifly-737-max8.taxi-in.engine-cool-down",
        "number": 2,
        "text": "ENGINE COOL-DOWN",
        "expect": "AT OR NEAR IDLE 3 MINUTES BEFORE SHUTDOWN",
        "controls": [
          "engmon"
        ],
        "targets": [
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          },
          {
            "at": "con/ed/ENG/1"
          }
        ],
        "note": "Run the engines at or near idle before cutting them off, so they cool evenly.",
        "why": "So the engines cool evenly",
        "timer": {
          "seconds": 180,
          "label": "Engine cool-down",
          "note": "Starts by itself from your first tick in After landing.",
          "auto_start": {
            "from": [
              "ifly-737-max8.after-landing.autobrake",
              "ifly-737-max8.after-landing.weather-radar-and-terrain"
            ],
            "pick": "earliest"
          }
        },
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      }
    ]
  },
  {
    "id": "shutdown-shutdown-procedure",
    "title": "Shutdown procedure",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.shutdown.apu-generator-switches",
        "number": 1,
        "text": "APU GENERATOR SWITCHES",
        "expect": "BOTH ON",
        "controls": [
          "apugen"
        ],
        "targets": [
          {
            "at": "oh/elecl/APU GEN/1",
            "set": "ON"
          },
          {
            "at": "oh/elecl/APU GEN/2",
            "set": "ON"
          }
        ],
        "quick": "always",
        "note": "Take power from the APU before you stop the engines, or you lose normal AC power.",
        "why": "Puts APU power on both transfer buses",
        "check": "APU GEN OFF BUS light OUT",
        "how": "gens2",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
