        ],
        "targets": [
          {
            "at": "con/st/FLAP LEVER/1",
            "set": "UP"
          }
        ],
        "why": "Clean for the climb",
        "check": "Flaps UP",
        "check_detail": "No leading edge flap lights (TRANSIT or EXT)",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      }
    ]
  },
  {
    "id": "after-takeoff-after-takeoff-climb-out",
    "title": "After takeoff climb out",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.after-takeoff.roll-mode",
        "number": 1,
        "text": "ROLL MODE",
        "expect": "LNAV OR HDG SEL ABOVE 400 FT",
        "controls": [
          "rollmode"
        ],
        "targets": [
          {
            "at": "gl/mcp/HDG SEL/1"
          },
          {
            "at": "gl/mcp/LNAV/1"
          },
          {
            "at": "gl/mcp/VOR LOC/1"
          },
          {
            "at": "gl/mcp/APP/1"
          }
        ],
        "quick": "always",
        "note": "Select the lateral mode above 400 ft.",
        "why": "LNAV follows the FMC route. HDG SEL flies a heading you set",
        "check": "FMA shows the mode",
        "panel_lights": {
          "rollmode": [
            "HDG SEL",
            "LNAV"
          ]
        },
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.after-takeoff.pressurization",
        "number": 1,
        "text": "PRESSURIZATION",
        "expect": "CABIN ALTITUDE CLIMBING NORMALLY",
        "controls": [
          "press"
        ],
        "targets": [
          {
            "at": "oh/cab/CABIN ALT/1"
          },
          {
            "at": "oh/cab/CABIN CLIMB/1"
          },
          {
            "at": "oh/press/FLT ALT/1"
          },
          {
            "at": "oh/press/FLT ALT KNOB/1"
          },
          {
            "at": "oh/press/MODE/1"
          }
        ],
        "why": "Pressurization working",
        "check": "Cabin altitude climbing normally",
        "panel_lights": {
          "press": [
            "CABIN ALT",
            "CABIN CLIMB"
          ]
        }
      },
      {
        "id": "ifly-737-max8.after-takeoff.climb-thrust",
        "number": 2,
        "text": "CLIMB THRUST",
        "expect": "VERIFY AT ABOUT 1,500 FT",
        "controls": [
          "engmon"
        ],
        "targets": [
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          },
          {
            "at": "con/ed/ENG/1"
          }
        ],
        "note": "Thrust reduces automatically to climb thrust. Check N1 agrees.",
        "why": "Thrust reduces to climb automatically",
        "check": "N1 matches the CLB N1 limit",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.after-takeoff.autopilot",
        "number": 3,
        "text": "AUTOPILOT",
        "expect": "CMD A OR B",
        "controls": [
          "ap"
        ],
        "targets": [
          {
            "at": "gl/mcp/CMD A/1"
          },
          {
            "at": "gl/mcp/CMD B/1"
          }
        ],
        "note": "The autopilot refuses to engage unless the airplane is trimmed and you are not pushing on the controls. There is a minimum height after takeoff below which the autopilot should not be engaged.",
        "why": "The autopilot then flies the modes shown on the FMA",
        "check": "CMD shown on the PFD",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.after-takeoff.autobrake",
        "number": 4,
        "text": "AUTOBRAKE",
        "expect": "OFF AFTER FLAP RETRACTION",
        "controls": [
          "abrake"
        ],
        "targets": [
          {
            "at": "con/ed/AUTO BRAKE/1",
            "set": "OFF"
          }
        ],
        "quick": "always",
        "note": "RTO is for the takeoff roll only. Turn it OFF after takeoff. Left at RTO, autobrake will not work on landing.",
        "why": "Left at RTO, autobrake will not work on landing"
      },
      {
        "id": "ifly-737-max8.after-takeoff.engine-start-switches",
        "number": 5,
        "text": "ENGINE START SWITCHES",
        "expect": "OFF OR CONT AS CONDITIONS REQUIRE",
        "controls": [
          "starts"
        ],
        "targets": [
          {
            "at": "oh/start/ENGINE START 1/1"
          },
          {
            "at": "oh/start/ENGINE START 2/1"
          }
        ],
        "why": "CONT in heavy rain, icing or severe turbulence. Otherwise OFF",
        "panel_lights": {
          "starts": [
            "ENGINE START 1",
            "ENGINE START 2"
          ]
        }
      }
    ]
  },
  {
    "id": "climb-climb-procedure-above-10-000-ft",
    "title": "Climb procedure, above 10,000 ft",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.climb.center-fuel-pumps",
        "text": "CENTER FUEL PUMPS",
