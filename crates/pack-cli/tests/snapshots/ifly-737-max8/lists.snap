            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          },
          {
            "at": "con/ed/ENG/1"
          }
        ],
        "note": "Reversers are deployed when REV shows green.",
        "why": "Reversers are deployed",
        "check": "REV green on both engines"
      },
      {
        "id": "ifly-737-max8.landing-roll.60-knots",
        "number": 5,
        "text": "60 KNOTS",
        "expect": "BEGIN STOWING THE REVERSERS",
        "controls": [
          "thrust"
        ],
        "targets": [
          {
            "at": "con/st/THRUST LEVERS 1 AND 2/1"
          }
        ],
        "note": "Start reducing reverse so the engines reach reverse idle by taxi speed.",
        "why": "Limits debris thrown up at low speed",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.landing-roll.reverse-levers",
        "number": 6,
        "text": "REVERSE LEVERS",
        "expect": "FULL DOWN BEFORE TAXI SPEED",
        "controls": [
          "thrust"
        ],
        "targets": [
          {
            "at": "con/st/THRUST LEVERS 1 AND 2/1"
          }
        ],
        "quick": "always",
        "note": "Stow the reversers before you leave the runway.",
        "why": "Stowed before you leave the runway",
        "check": "Reversers stowed",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.landing-roll.autobrake",
        "number": 7,
        "text": "AUTOBRAKE",
        "expect": "DISARM BEFORE TAXI SPEED",
        "controls": [
          "abrake"
        ],
        "targets": [
          {
            "at": "con/ed/AUTO BRAKE/1"
          }
        ],
        "note": "Set the selector to OFF (pressing the toe brakes also disarms it), then brake with the toe brakes.",
        "why": "Take over with the toe brakes",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      }
    ]
