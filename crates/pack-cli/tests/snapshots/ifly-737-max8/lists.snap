            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.if-only-standby-airspeed-is-reliable",
        "number": 9,
        "text": "IF ONLY STANDBY AIRSPEED IS RELIABLE",
        "expect": "NO AUTOPILOT, AUTOTHROTTLE OR FLIGHT DIRECTORS",
        "controls": [
          "isfdc"
        ],
        "targets": [
          {
            "at": "mn/ctr/STANDBY DISPLAY/1"
          }
        ],
        "non_recall": true,
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.if-captain-or-fo-airspeed-is-reliable",
        "number": 10,
        "text": "IF CAPTAIN OR FO AIRSPEED IS RELIABLE",
        "expect": "USE THAT SIDE'S F/D AND AUTOPILOT IF NEEDED. KEEP AUTOTHROTTLE OFF",
        "controls": [
          "fd"
        ],
        "targets": [
          {
            "at": "gl/mcp/F/D L/1",
            "set": "OFF"
          },
          {
            "at": "gl/mcp/F/D R/1",
            "set": "OFF"
          }
        ],
        "non_recall": true,
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.if-no-reliable-airspeed",
        "number": 11,
        "text": "IF NO RELIABLE AIRSPEED",
        "expect": "PITCH AND THRUST FROM APPROVED TABLES",
        "controls": [
          "fltinst"
        ],
        "targets": [
          {
            "at": "mn/cd/OUTBOARD DU: PFD/1"
          },
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          },
          {
            "at": "mn/fd/INBOARD DU: ND/1"
          },
          {
            "at": "mn/fd/OUTBOARD DU: PFD/1"
          }
        ],
        "non_recall": true,
        "note": "Once trimmed and stable, compare each airspeed with the table. A gap above 20 knots or 0.03 Mach marks that indicator as unreliable.",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.transponder",
        "number": 12,
        "text": "TRANSPONDER",
        "expect": "USE THE RELIABLE SIDE WITH TRAFFIC ALERTS ONLY. ALTITUDE REPORTING OFF IF BOTH ARE UNRELIABLE",
        "controls": [
          "xpndr"
        ],
        "targets": [
          {
            "at": "con/atc/ALT SOURCE 1/1"
          },
          {
            "at": "con/atc/XPNDR/1"
          },
          {
            "at": "con/atc/CODE/1"
          },
          {
            "at": "con/atc/MODE/1"
          },
          {
            "at": "con/atc/ALT SOURCE 2/1"
          }
        ],
        "non_recall": true,
        "note": "The airplane may no longer meet RVSM requirements.",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.approach-and-go-around-airspeed-unreliable",
        "text": "APPROACH AND GO-AROUND",
        "expect": "BARO MINIMUMS ON THE RELIABLE PFD ONLY. NO TO/GA IF ONLY STANDBY AIRSPEED IS RELIABLE",
        "non_recall": true,
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      }
    ]
