        "panel_lights": {
          "mcpset": [
            "IAS/MACH"
          ]
        }
      },
      {
        "id": "ifly-737-max8.before-takeoff.stabilizer-trim",
        "text": "STABILIZER TRIM",
        "expect": "___ UNITS",
        "controls": [
          "stabind"
