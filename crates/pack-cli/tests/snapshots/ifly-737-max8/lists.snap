    ],
    "steps": [
      {
        "id": "ifly-737-max8.procedures.stab-trim-cutout-switches-both",
        "number": 1,
        "text": "STAB TRIM CUTOUT SWITCHES (BOTH)",
        "expect": "CUTOUT",
        "controls": [
          "stabcut"
        ],
        "targets": [
          {
            "at": "con/lo/STAB TRIM PRI/1",
            "set": "CUT OUT"
          },
          {
            "at": "con/lo/STAB TRIM B/U/1",
            "set": "CUT OUT"
          }
        ],
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.procedures.autopilot",
        "number": 2,
        "text": "AUTOPILOT",
