          },
          {
            "at": "gl/annl/ELEC/1"
          },
          {
            "at": "gl/annl/APU/1"
          },
          {
            "at": "gl/annl/OVHT/DET/1"
          },
          {
            "at": "gl/annr/ANTI-ICE/1"
          },
          {
            "at": "gl/annr/HYD/1"
          },
          {
            "at": "gl/annr/DOORS/1"
          },
          {
            "at": "gl/annr/ENG/1"
          },
          {
            "at": "gl/annr/OVERHEAD/1"
          },
          {
            "at": "gl/annr/AIR COND/1"
          }
        ],
        "why": "Shows any stored system alerts",
        "check": "No unexpected alerts",
        "how": "recall",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
