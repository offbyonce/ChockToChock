  {
    "id": "before-start-before-start-procedure",
    "title": "Before start procedure",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.before-start.landing-gear-pins",
        "text": "LANDING GEAR PINS",
        "expect": "REMOVED AND STOWED ON BOARD",
        "why": "The pins lock the gear down on the ground, so they must be out before flight and carried on board."
      },
      {
        "id": "ifly-737-max8.before-start.n1-bugs",
        "number": 1,
        "text": "N1 BUGS",
        "expect": "MATCH THE GREEN N1 REFERENCE",
        "controls": [
          "n1"
        ],
        "targets": [
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          }
        ],
        "why": "Takeoff thrust target",
        "check": "N1 bugs match the N1 reference",
        "how": "n1",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.before-start.mcp",
        "number": 2,
        "text": "MCP",
        "expect": "SET V2, HEADING, ALTITUDE, ARM A/T, ARM LNAV AND VNAV FOR AN RNAV DEPARTURE",
        "controls": [
          "mcpset"
        ],
        "targets": [
          {
            "at": "gl/mcp/A/T ARM/1",
            "set": "ARM"
          },
          {
            "at": "gl/mcp/HEADING/1"
          },
          {
            "at": "gl/mcp/ALTITUDE/1"
          }
        ],
        "quick": "always",
        "why": "Departure speed, heading and altitude",
        "check": "A/T ARM switch at ARM, green light on",
        "check_detail": "FMA shows ARM",
        "how": "mcp",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.before-start.door-lights",
        "number": 3,
        "text": "DOOR LIGHTS",
        "expect": "ALL OUT",
        "controls": [
          "doorsp"
        ],
        "targets": [
          {
            "at": "oh/door/EQUIP/1",
            "light": "out"
          },
          {
            "at": "oh/door/FWD ENTRY/1",
            "light": "out"
          },
          {
            "at": "oh/door/LEFT FWD OVERWING/1",
            "light": "out"
          },
          {
            "at": "oh/door/LEFT AFT OVERWING/1",
            "light": "out"
          },
          {
            "at": "oh/door/AFT ENTRY/1",
            "light": "out"
          },
          {
            "at": "oh/door/FWD SERVICE/1",
            "light": "out"
          },
          {
            "at": "oh/door/RIGHT FWD OVERWING/1",
            "light": "out"
          },
          {
            "at": "oh/door/RIGHT AFT OVERWING/1",
            "light": "out"
          },
          {
            "at": "oh/door/AFT SERVICE/1",
            "light": "out"
          },
          {
            "at": "oh/door/FWD CARGO/1",
            "light": "out"
          },
          {
            "at": "oh/door/AFT CARGO/1",
            "light": "out"
          }
        ],
        "quick": "always",
        "note": "Any light on means a door is not closed. All lights must be out before pushback.",
        "why": "All closed before pushback",
        "check": "All door lights OUT",
        "if_not": "Light on",
        "if_not_detail": "That door is not closed",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.before-start.terr-efis-control-panel",
        "text": "TERR (EFIS CONTROL PANEL)",
        "expect": "ON",
        "controls": [
          "efispanel"
        ],
        "targets": [
          {
            "at": "gl/efisl/TERR/1"
          },
          {
            "at": "gl/efisr/TERR/1"
          }
        ],
        "note": "Shows surrounding terrain on the ND for departure.",
        "why": "Terrain awareness for departure",
        "check": "TERR shown on the ND",
        "panel_lights": {
          "efispanel": [
            "TERR"
          ]
        }
      },
      {
        "id": "ifly-737-max8.before-start.fuel-pump-switches",
        "number": 4,
        "text": "FUEL PUMP SWITCHES",
        "expect": "ALL ON, CENTER PUMPS ON IF MORE THAN 1,000 LB (ABOUT 450 KG) IN THE CENTER TANK",
        "controls": [
          "fuelpumps"
        ],
        "targets": [
          {
            "at": "oh/fuel/CTR L/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/CTR R/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/AFT 1/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/FWD 1/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/FWD 2/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/AFT 2/1",
            "set": "ON"
          }
        ],
        "quick": "always",
        "why": "Feeds fuel to the engines under pressure",
        "check": "LOW PRESSURE lights OUT",
        "check_detail": "Center lights out only if center pumps are on",
        "if_not": "Both center lights on",
        "if_not_detail": "Normal if the center tank has less than 1,000 LB (about 450 KG) and its pumps are OFF. Otherwise check the center pumps are ON",
        "explain": "fuelq",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.before-start.electric-hydraulic-pump-switches",
        "text": "ELECTRIC HYDRAULIC PUMP SWITCHES",
        "expect": "ON",
        "controls": [
          "elechyd"
        ],
        "targets": [
          {
            "at": "oh/hyd/ELEC 2/1",
            "set": "ON"
          },
          {
            "at": "oh/hyd/ELEC 1/1",
            "set": "ON"
          }
        ],
        "quick": "always",
        "why": "System A and B pressure for brakes, steering and controls before push",
        "check": "ELEC 1 and ELEC 2 LOW PRESSURE lights OUT",
        "check_detail": "Brake pressure in the normal range",
        "if_not": "LOW PRESSURE light stays on",
        "if_not_detail": "That pump is not supplying pressure"
      },
      {
        "id": "ifly-737-max8.before-start.anti-collision-light",
        "number": 5,
        "text": "ANTI-COLLISION LIGHT",
        "expect": "ON",
        "controls": [
          "beacon"
        ],
        "targets": [
          {
            "at": "oh/lte/ANTI COLLISION/1",
            "set": "ON"
          }
        ],
        "quick": "always",
        "why": "Warns people that engines are about to start",
        "explain": "beacon",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.before-start.stabilizer-trim",
        "number": 6,
        "text": "STABILIZER TRIM",
        "expect": "SET TO TAKEOFF UNITS",
        "controls": [
          "stabind"
        ],
        "targets": [
          {
            "at": "con/st/STAB TRIM WHEEL/1"
          },
          {
            "at": "con/st/STAB TRIM WHEEL/2"
          }
        ],
        "quick": "always",
        "note": "Takeoff trim depends on weight and center of gravity. Set the units shown on the CDU.",
        "why": "Sets the pitch forces at rotation",
        "check": "Trim indicator in the green takeoff range",
        "check_detail": "Aileron and rudder trim neutral, and the controls move freely",
        "how": "stab",
        "explain": "stabt",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      }
    ]
  },
  {
    "id": "before-start-before-start-checklist",
    "title": "Before start checklist",
    "kind": "checklist",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.before-start.flight-deck-door",
