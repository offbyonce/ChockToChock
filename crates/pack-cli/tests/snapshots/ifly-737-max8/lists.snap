      {
        "id": "ifly-737-max8.memory.reliable-references",
        "number": 7,
        "text": "RELIABLE REFERENCES",
        "expect": "ATTITUDE, N1, GROUND SPEED AND RADIO ALTITUDE",
        "controls": [
