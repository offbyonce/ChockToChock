        ],
        "targets": [
          {
            "at": "mn/ctr/LANDING GEAR LEVER/1",
            "set": "UP"
          }
        ],
        "why": "Gear up and locked",
        "check": "Red and green gear lights OUT",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.after-takeoff.flaps",
        "text": "FLAPS",
        "expect": "UP, NO LIGHTS",
