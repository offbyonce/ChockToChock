  {
    "id": "before-takeoff-before-takeoff-checklist",
    "title": "Before takeoff checklist",
    "kind": "checklist",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.before-takeoff.flaps",
        "text": "FLAPS",
        "expect": "CDU ___, PWB ___, FLAPS ___ INDICATED, GREEN LIGHT",
        "controls": [
          "flaplever"
        ],
        "targets": [
          {
            "at": "con/st/FLAP LEVER/1"
          }
        ],
        "fill": [
          "takeoff_flaps",
          "takeoff_flaps",
          "takeoff_flaps"
        ],
        "why": "Must match the planned flaps",
        "check": "CDU, performance sheet (PWB) and flap indication agree",
        "check_detail": "Green light",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.before-takeoff.takeoff-data",
        "text": "TAKEOFF DATA",
        "expect": "SET, RUNWAY ___",
        "controls": [
          "cdu"
        ],
        "targets": [
          {
            "at": "con/cdul/CDU/1"
          },
          {
            "at": "con/cdur/CDU/1"
          }
        ],
        "fill": [
          "runway"
        ],
        "why": "Confirms the takeoff reference",
        "check": "Data and runway agree"
