  {
    "id": "pushback-pushback",
    "title": "Pushback",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.pushback.ice-check",
        "number": 1,
        "text": "ICE CHECK",
        "expect": "COMPLETE OR NOT REQUIRED",
        "controls": [
          "extins"
        ],
        "quick": "always",
        "note": "If it is cold or wet, confirm the wings and tail are clear of frost and ice before you leave.",
        "why": "No frost or ice before you leave",
        "check": "Wings and tail clear"
      },
      {
        "id": "ifly-737-max8.pushback.maintenance-log",
        "number": 1,
        "text": "MAINTENANCE LOG",
        "expect": "ABOARD, REVIEWED",
        "controls": [
          "mlog"
        ],
        "note": "Confirm the logbook is on board and there is nothing open that stops the flight.",
        "why": "Confirms the airplane is ready",
        "check": "Log aboard",
        "check_detail": "Nothing open that stops the flight"
      },
      {
        "id": "ifly-737-max8.pushback.tcas-and-transponder",
        "number": 1,
        "text": "TCAS AND TRANSPONDER",
        "expect": "SQUAWK SET, XPNDR AUTO",
        "controls": [
          "xpndr"
        ],
        "targets": [
          {
            "at": "con/atc/XPNDR/1",
            "set": "AUTO"
          },
          {
            "at": "con/atc/MODE/1",
            "set": "XPNDR"
          }
        ],
        "hint": [
          {
            "prefix": "SQUAWK ",
            "field": "squawk"
          }
        ],
        "note": "Squawk code set, and the transponder at AUTO so it transmits and ground controllers can see you.",
        "why": "Ground controllers can see you",
        "check": "Code set"
      },
      {
        "id": "ifly-737-max8.pushback.pushback-clearance",
        "number": 1,
        "text": "PUSHBACK CLEARANCE",
        "expect": "OBTAIN",
        "controls": [
          "atcclr"
        ],
        "targets": [
          {
            "at": "con/r1/VHF RADIO 1/1"
          }
        ],
        "why": "Request it and read it back"
      },
      {
        "id": "ifly-737-max8.pushback.wheel-chocks",
        "text": "WHEEL CHOCKS",
        "expect": "VERIFY REMOVED",
        "controls": [
          "chocks"
        ],
        "quick": "always",
        "why": "The airplane must not be pushed with chocks in",
        "check": "Chocks removed before the airplane is pushed",
        "if_not": "Chocks still in place",
        "if_not_detail": "Remove them, from the EFB ground services page in the sim, before releasing the brake"
      },
      {
        "id": "ifly-737-max8.pushback.parking-brake",
        "number": 2,
        "text": "PARKING BRAKE",
        "expect": "RELEASE WHEN TUG IS READY",
        "controls": [
          "pbrake"
        ],
        "targets": [
          {
            "at": "con/lo/PARKING BRAKE/1",
            "set": "RELEASED"
          }
        ],
        "quick": "always",
        "why": "Lets the tug move the airplane",
        "check": "Parking brake light OUT"
      },
      {
        "id": "ifly-737-max8.pushback.towing-pin-inserted",
        "text": "TOWING PIN (EFB)",
        "expect": "INSERTED",
        "note": "The iFly has no ground crew, so the EFB stands in for them.",
        "why": "Cuts hydraulic pressure to the nose wheel steering so the tug can turn it.",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ],
        "simulator_model": true
      },
      {
        "id": "ifly-737-max8.pushback.pushback",
        "number": 3,
        "text": "PUSHBACK",
        "expect": "START",
        "controls": [
          "pushsim"
        ],
        "quick": "always",
        "note": "Start your pushback tool or the EFB pushback. Watch that the parking brake is released first.",
        "why": "Moves the airplane back from the gate. A sim step, with no switch on the real panel",
        "check": "Airplane moving back",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ],
        "simulator_model": true
      },
      {
        "id": "ifly-737-max8.pushback.parking-brake-pushback",
        "number": 4,
        "text": "PARKING BRAKE",
        "expect": "SET AT END OF PUSH",
        "controls": [
          "pbrake"
        ],
        "targets": [
          {
            "at": "con/lo/PARKING BRAKE/1",
            "set": "SET"
          },
          {
            "at": "con/lo/PARK BRAKE LIGHT/1",
            "light": "on"
          }
        ],
        "quick": "always",
        "why": "Holds the airplane for start",
        "check": "Parking brake light ON"
      },
      {
        "id": "ifly-737-max8.pushback.towing-pin-removed",
        "text": "TOWING PIN (EFB)",
        "expect": "REMOVED",
        "note": "The iFly has no ground crew, so the EFB stands in for them.",
        "why": "Restores nose wheel steering after the push.",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ],
        "simulator_model": true
      }
    ]
  },
  {
    "id": "engine-start-engine-start",
    "title": "Engine start",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.engine-start.start-clearance",
        "number": 1,
        "text": "START CLEARANCE",
        "expect": "OBTAIN",
        "controls": [
          "atcclr"
        ],
        "targets": [
          {
            "at": "con/r1/VHF RADIO 1/1"
          }
        ],
        "why": "Request it and read it back"
      },
      {
        "id": "ifly-737-max8.engine-start.secondary-engine-indications",
        "text": "SECONDARY ENGINE INDICATIONS",
        "expect": "DISPLAYED",
        "why": "N2 and EGT are shown here, and both are watched during the start.",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.engine-start.pack-switches",
        "number": 2,
        "text": "PACK SWITCHES",
        "expect": "OFF",
        "controls": [
          "packs"
        ],
        "targets": [
          {
            "at": "oh/bleed/L PACK/1",
            "set": "OFF"
          },
          {
            "at": "oh/bleed/R PACK/1",
            "set": "OFF"
          }
        ],
        "quick": "always",
        "why": "With the packs off, all the APU bleed air goes to the starters",
        "explain": "packoff",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.engine-start.apu-bleed-switch",
        "number": 3,
        "text": "APU BLEED SWITCH",
        "expect": "ON",
        "controls": [
          "apubleed"
        ],
        "targets": [
          {
            "at": "oh/bleed/APU BLEED/1",
            "set": "ON"
          }
        ],
        "note": "The APU supplies the air that turns the starters. The packs stay off so that air reaches the engines.",
        "why": "APU air turns the starters",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.engine-start.ignition-selector",
        "text": "IGNITION SELECTOR",
        "expect": "BOTH",
        "controls": [
          "starts"
        ],
        "targets": [
          {
            "at": "oh/start/IGNITION/1",
            "set": "BOTH"
          }
        ],
        "quick": "always",
        "note": "Set in the preflight. Leave it at BOTH.",
        "why": "BOTH fires both igniters for the start.",
        "panel_lights": {
          "starts": [
            "IGNITION"
          ]
        },
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.engine-start.engine-1-start-switch",
        "number": 4,
        "section": "Engine 1",
        "text": "ENGINE 1 START SWITCH",
        "expect": "GRD",
        "controls": [
          "starts"
        ],
        "targets": [
          {
            "at": "oh/start/ENGINE START 1/1",
            "set": "GRD"
          },
          {
            "at": "oh/start/ENGINE START 2/1",
            "set": "GRD"
          }
        ],
        "quick": "always",
        "why": "The engine must spin before fuel is added. Order varies by airline. Many start engine 2 first because it drives hydraulic system B, which supplies the normal brakes.",
        "check": "N2 rising, START VALVE OPEN alert",
        "check_detail": "N2 and oil pressure rising",
        "if_not": "N2 does not rise",
        "if_not_detail": "Run the Aborted engine start checklist (Quick reference)",
        "explain": "grd",
        "panel_lights": {
          "starts": [
            "ENGINE START 1"
          ]
        },
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.engine-start.motoring-indication-engine-start",
        "number": 5,
        "text": "MOTORING INDICATION",
        "expect": "WAIT UNTIL IT CLEARS",
        "controls": [
          "motor"
        ],
        "targets": [
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          }
        ],
        "quick": "always",
        "note": "The MAX motors the engine first to straighten shafts bowed by heat from the last shutdown. Do not lift the start lever until this clears.",
        "why": "Straightens shafts bowed by heat",
        "check": "Motoring indication cleared",
        "if_not": "Still showing",
        "if_not_detail": "Do not lift the start lever",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.engine-start.engine-1-start-lever",
        "number": 6,
        "text": "ENGINE 1 START LEVER",
        "expect": "IDLE AT ABOUT 25% N2",
        "controls": [
          "slever"
        ],
        "targets": [
          {
            "at": "con/lo/START LEVER 1/1",
            "set": "IDLE"
          },
          {
            "at": "con/lo/START LEVER 2/1",
            "set": "IDLE"
          }
        ],
        "quick": "always",
        "note": "If 25% N2 is not reached, move to IDLE at maximum motoring, but not below 20% N2. This comes from older 737 practice and is not confirmed for the MAX.",
        "why": "Fuel only once turning fast enough to light off",
        "check": "Fuel flow, then EGT rising",
        "if_not": "EGT does not rise or nears the limit",
        "if_not_detail": "Run the Aborted engine start checklist (Quick reference)",
        "explain": "lever"
      },
      {
        "id": "ifly-737-max8.engine-start.fuel-flow-and-egt-engine-start",
        "number": 7,
        "text": "FUEL FLOW AND EGT",
        "expect": "VERIFY EGT RISES WITHIN 10 SECONDS OF START LEVER TO IDLE",
        "controls": [
          "engmon"
        ],
        "targets": [
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          },
          {
            "at": "con/ed/ENG/1"
          }
        ],
        "note": "During a short test, fuel flow reads zero and the ENG VALVE CLOSED light shows bright. Then fuel flow rises. EGT should rise within 10 seconds. If it does not, the EEC may stop the start. Otherwise, stop it yourself.",
        "why": "Confirms light-off",
        "check": "EGT rises within 10 seconds",
        "check_detail": "First a short valve test: fuel flow zero and ENG VALVE CLOSED bright. Then fuel flow rises",
        "if_not": "No EGT rise",
        "if_not_detail": "The EEC may stop the start by itself. If it does not, run the Aborted engine start checklist"
      },
      {
        "id": "ifly-737-max8.engine-start.engine-1-start-switch-engine-start",
        "number": 8,
        "text": "ENGINE 1 START SWITCH",
        "expect": "VERIFY OFF AT ABOUT 63% N2",
        "controls": [
          "starts"
        ],
        "targets": [
          {
            "at": "oh/start/ENGINE START 1/1",
            "set": "OFF"
          },
          {
            "at": "oh/start/ENGINE START 2/1",
            "set": "OFF"
          }
        ],
        "quick": "always",
        "why": "Confirms the starter has cut out",
        "check": "Switch back at OFF",
        "check_detail": "It returns from GRD by itself at about 63% N2",
        "panel_lights": {
          "starts": [
            "ENGINE START 1"
          ]
        },
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.engine-start.engine-1",
        "number": 9,
        "text": "ENGINE 1",
        "expect": "VERIFY STABLE AT IDLE",
        "controls": [
          "engmon"
        ],
        "targets": [
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          },
          {
            "at": "con/ed/ENG/1"
          }
        ],
        "quick": "always",
        "note": "N1, N2, EGT and oil pressure settle at idle with no alerts.",
        "why": "Engine settled at idle",
        "check": "N1, N2, EGT and oil pressure stable, LOW OIL PRESSURE light OUT",
        "check_detail": "No alerts",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.engine-start.engine-2-start-switch",
        "number": 10,
        "section": "Engine 2",
        "text": "ENGINE 2 START SWITCH",
        "expect": "GRD",
        "controls": [
          "starts"
        ],
        "targets": [
          {
            "at": "oh/start/ENGINE START 1/1",
            "set": "GRD"
          },
          {
            "at": "oh/start/ENGINE START 2/1",
            "set": "GRD"
          }
        ],
        "quick": "always",
        "why": "The engine must spin before fuel is added",
        "check": "N2 rising, START VALVE OPEN alert",
        "check_detail": "N2 and oil pressure rising",
        "if_not": "N2 does not rise",
        "if_not_detail": "Run the Aborted engine start checklist (Quick reference)",
        "explain": "grd",
        "panel_lights": {
          "starts": [
            "ENGINE START 2"
          ]
        },
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.engine-start.motoring-indication",
        "number": 11,
        "text": "MOTORING INDICATION",
        "expect": "WAIT UNTIL IT CLEARS",
        "controls": [
          "motor"
        ],
        "targets": [
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          }
        ],
        "quick": "always",
        "note": "The MAX motors the engine first to straighten shafts bowed by heat from the last shutdown. Do not lift the start lever until this clears.",
        "why": "Straightens shafts bowed by heat",
        "check": "Motoring indication cleared",
        "if_not": "Still showing",
        "if_not_detail": "Do not lift the start lever",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.engine-start.engine-2-start-lever",
        "number": 12,
        "text": "ENGINE 2 START LEVER",
        "expect": "IDLE AT ABOUT 25% N2",
        "controls": [
          "slever"
        ],
        "targets": [
          {
            "at": "con/lo/START LEVER 1/1",
            "set": "IDLE"
          },
          {
            "at": "con/lo/START LEVER 2/1",
            "set": "IDLE"
          }
        ],
        "quick": "always",
        "note": "If 25% N2 is not reached, move to IDLE at maximum motoring, but not below 20% N2. This comes from older 737 practice and is not confirmed for the MAX.",
        "why": "Fuel only once turning fast enough to light off",
        "check": "Fuel flow, then EGT rising",
        "if_not": "EGT does not rise or nears the limit",
        "if_not_detail": "Run the Aborted engine start checklist (Quick reference)",
        "explain": "lever"
      },
      {
        "id": "ifly-737-max8.engine-start.fuel-flow-and-egt",
        "number": 13,
        "text": "FUEL FLOW AND EGT",
        "expect": "VERIFY EGT RISES WITHIN 10 SECONDS OF START LEVER TO IDLE",
        "controls": [
          "engmon"
        ],
        "targets": [
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          },
          {
            "at": "con/ed/ENG/1"
          }
        ],
        "note": "During a short test, fuel flow reads zero and the ENG VALVE CLOSED light shows bright. Then fuel flow rises. EGT should rise within 10 seconds. If it does not, the EEC may stop the start. Otherwise, stop it yourself.",
        "why": "Confirms light-off",
        "check": "EGT rises within 10 seconds",
        "check_detail": "First a short valve test: fuel flow zero and ENG VALVE CLOSED bright. Then fuel flow rises",
        "if_not": "No EGT rise",
        "if_not_detail": "The EEC may stop the start by itself. If it does not, run the Aborted engine start checklist"
      },
      {
        "id": "ifly-737-max8.engine-start.engine-2-start-switch-engine-start",
        "number": 14,
        "text": "ENGINE 2 START SWITCH",
        "expect": "VERIFY OFF AT ABOUT 63% N2",
        "controls": [
          "starts"
        ],
        "targets": [
          {
            "at": "oh/start/ENGINE START 1/1",
            "set": "OFF"
          },
          {
            "at": "oh/start/ENGINE START 2/1",
            "set": "OFF"
          }
        ],
        "quick": "always",
        "why": "Confirms the starter has cut out",
        "check": "Switch back at OFF",
        "check_detail": "It returns from GRD by itself at about 63% N2",
        "panel_lights": {
          "starts": [
            "ENGINE START 2"
          ]
        },
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.engine-start.engine-2",
        "number": 15,
        "text": "ENGINE 2",
        "expect": "VERIFY STABLE AT IDLE",
        "controls": [
          "engmon"
        ],
        "targets": [
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          },
          {
            "at": "con/ed/ENG/1"
          }
        ],
        "quick": "always",
        "note": "N1, N2, EGT and oil pressure settle at idle with no alerts.",
        "why": "Engine settled at idle",
        "check": "N1, N2, EGT and oil pressure stable, LOW OIL PRESSURE light OUT",
        "check_detail": "No alerts",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.engine-start.ground-support-items",
        "text": "GROUND SUPPORT ITEMS (EFB)",
        "expect": "ALL REMOVED",
        "note": "The iFly has no ground crew, so the EFB stands in for them.",
        "why": "Nothing may be left attached before taxi.",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ],
        "simulator_model": true
      }
    ]
  },
  {
    "id": "before-taxi-before-taxi-procedure",
    "title": "Before taxi procedure",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.before-taxi.engine-generator-switches",
        "number": 1,
        "text": "ENGINE GENERATOR SWITCHES",
        "expect": "BOTH ON",
        "controls": [
          "engen"
        ],
        "targets": [
          {
            "at": "oh/elecl/GEN 1/1",
            "set": "ON"
          },
          {
            "at": "oh/elecl/GEN 2/1",
            "set": "ON"
          }
        ],
        "quick": "always",
        "why": "Engine generators take over the buses",
        "how": "gens",
        "explain": "gen",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.before-taxi.probe-heat",
        "number": 2,
        "text": "PROBE HEAT",
        "expect": "ON, PROBE LIGHTS OUT",
        "controls": [
          "pheat"
        ],
        "targets": [
          {
            "at": "oh/heat/PROBE A/1",
            "set": "ON"
          },
          {
            "at": "oh/heat/PROBE B/1",
            "set": "ON"
          },
          {
            "at": "oh/heat/CAPT PITOT/1",
            "light": "out"
          },
          {
            "at": "oh/heat/L ELEV PITOT/1",
            "light": "out"
          },
          {
            "at": "oh/heat/L ALPHA VANE/1",
            "light": "out"
          },
          {
            "at": "oh/heat/TEMP PROBE/1",
            "light": "out"
          },
          {
            "at": "oh/heat/F/O PITOT/1",
            "light": "out"
          },
          {
            "at": "oh/heat/R ELEV PITOT/1",
            "light": "out"
          },
          {
            "at": "oh/heat/R ALPHA VANE/1",
            "light": "out"
          },
          {
            "at": "oh/heat/AUX PITOT/1",
            "light": "out"
          }
        ],
        "quick": "always",
        "note": "ON starts heating straight away. AUTO starts it only once the engines are running.",
        "why": "Heats the probes for flight. The lights go out once heating is working.",
        "check": "Both PROBE HEAT switches ON, probe lights OUT",
        "check_detail": "Amber probe lights out once an engine is running",
        "if_not": "An amber probe light stays on with an engine running",
        "if_not_detail": "That probe is not heating. Airspeed or Mach may be wrong in icing",
        "explain": "pheat",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.before-taxi.anti-ice",
        "number": 3,
        "text": "ANTI-ICE",
        "expect": "AS REQUIRED",
        "controls": [
          "aice"
        ],
        "targets": [
          {
            "at": "oh/aice/WING ANTI-ICE/1"
          },
          {
            "at": "oh/aice/ENG 1/1"
          },
          {
            "at": "oh/aice/ENG 2/1"
          }
        ],
        "quick": "always",
        "note": "Turn ENG 1 and ENG 2 anti-ice ON when it is 10C or below with visible moisture. Otherwise leave them OFF.",
        "why": "Stops ice building in the engine inlets on the ground",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.before-taxi.pack-switches",
        "number": 4,
        "text": "PACK SWITCHES",
        "expect": "AUTO",
        "controls": [
          "packs"
        ],
