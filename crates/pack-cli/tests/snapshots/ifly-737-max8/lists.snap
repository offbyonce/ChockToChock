            "at": "mn/ctr/NOSE GEAR/2",
            "light": "on"
          },
          {
            "at": "mn/ctr/RIGHT GEAR/2",
            "light": "on"
          },
          {
            "at": "mn/ctr/LANDING GEAR LEVER/1",
            "set": "DN"
          }
        ],
        "quick": "always",
        "show_if": {
          "option": "approach",
          "equals": "ils"
        },
        "why": "Gear down before landing. Lowering it here also adds drag to help you slow down and descend. The common Boeing ILS profile is gear down and flaps 15 when the glideslope comes alive, then landing flaps, VREF + 5 and the missed approach altitude at glideslope capture.",
        "check": "3 green gear lights",
        "if_not": "Fewer than 3 green",
        "if_not_detail": "Gear not down and locked, go around",
        "explain": "gearw",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
