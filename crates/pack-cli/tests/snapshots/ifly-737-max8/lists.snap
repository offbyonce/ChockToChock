---
source: crates/pack-cli/tests/snapshot.rs
assertion_line: 34
---
[
  {
    "id": "cold-dark-if-cold-and-dark",
    "title": "If cold and dark",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "why": "These are set before ground or APU power arrives, because that power is what starts pumps, wipers and the flap drive, which can hurt ground crew. Battery time is limited, so do them promptly.",
    "steps": [
      {
        "id": "ifly-737-max8.cold-dark.battery-switch",
        "number": 1,
        "text": "BATTERY SWITCH",
        "expect": "ON, GUARD CLOSED",
        "controls": [
          "bat"
        ],
        "targets": [
          {
            "at": "oh/elecu/BATTERY/1",
            "set": "ON"
          }
        ],
        "quick": "always",
        "note": "In the iFly the guard closes by itself about a second after the switch reaches ON, and it will not close with the switch OFF.",
        "why": "Brings the battery onto the electrical system for first power. The hot battery bus stays live regardless of this switch.",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ],
        "simulator_model": true
      },
      {
        "id": "ifly-737-max8.cold-dark.standby-power-switch",
        "number": 2,
        "text": "STANDBY POWER SWITCH",
        "expect": "AUTO, GUARD CLOSED",
        "controls": [
          "stby"
        ],
        "targets": [
          {
            "at": "oh/elecm/STANDBY POWER/1",
            "set": "AUTO"
          }
        ],
        "quick": "always",
        "note": "In the iFly the guard closes by itself about a second after the switch reaches AUTO, and it will not close in BAT or OFF.",
        "why": "AUTO keeps backup power available from the battery and the transformer rectifier.",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ],
        "simulator_model": true
      },
      {
        "id": "ifly-737-max8.cold-dark.alternate-flaps-switches",
        "number": 3,
        "text": "ALTERNATE FLAPS MASTER SWITCH",
        "expect": "OFF, GUARD CLOSED",
        "controls": [
          "altflap"
        ],
        "targets": [
          {
            "at": "oh/fctl/ALT FLAPS MASTER/1",
            "set": "OFF"
          },
          {
            "at": "oh/fctl/ALT FLAPS/1",
            "set": "OFF"
          }
        ],
        "note": "The position switch beside it is checked in the preliminary preflight.",
        "why": "The backup flap drive is electric, so it must be off before normal power comes on.",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.cold-dark.wiper-selectors",
        "number": 4,
        "text": "WIPER SELECTORS",
        "expect": "PARK",
        "controls": [
          "wiper"
        ],
        "targets": [
          {
            "at": "oh/wipe/L WIPER/1",
            "set": "PARK"
          },
          {
            "at": "oh/rwip/R WIPER/1",
            "set": "PARK"
          }
        ],
        "why": "Left on, the wipers start moving as soon as power arrives.",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.cold-dark.hydraulic-pump-switches",
        "number": 5,
        "text": "ELECTRIC HYDRAULIC PUMP SWITCHES",
        "expect": "OFF",
        "controls": [
          "elechyd"
        ],
        "targets": [
          {
            "at": "oh/hyd/ELEC 2/1",
            "set": "OFF"
          },
          {
            "at": "oh/hyd/ELEC 1/1",
            "set": "OFF"
          }
        ],
        "note": "They are the two inner switches on the hydraulic panel.",
        "why": "These pumps run from the AC bus, so with the switches on they would start as soon as ground or APU power arrives, which pressurizes the hydraulic systems and can move flight controls with people near the airplane.",
        "check": "ELEC 1 and ELEC 2 OFF",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.cold-dark.landing-gear-lever",
        "number": 6,
        "text": "LANDING GEAR LEVER",
        "expect": "DN",
        "controls": [
          "gearlever"
        ],
        "targets": [
          {
            "at": "mn/ctr/LEFT GEAR/2",
            "light": "on"
          },
          {
            "at": "mn/ctr/NOSE GEAR/2",
            "light": "on"
          },
          {
            "at": "mn/ctr/RIGHT GEAR/2",
            "light": "on"
          },
          {
            "at": "mn/ctr/LANDING GEAR LEVER/1",
            "set": "DN"
          }
        ],
        "quick": "always",
        "why": "Green means the gear is down and locked. Red means a gear is unlocked or disagrees with the lever.",
        "check": "3 green gear lights, no red",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      }
    ]
  },
  {
    "id": "gpu-power-establishing-gpu-power",
    "title": "Establishing GPU power",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.gpu-power.parking-brake",
        "number": 1,
        "text": "PARKING BRAKE",
        "expect": "SET",
        "controls": [
          "pbrake"
        ],
        "targets": [
          {
            "at": "con/lo/PARKING BRAKE/1",
            "set": "SET"
          },
          {
            "at": "con/lo/PARK BRAKE LIGHT/1",
            "light": "on"
          }
        ],
        "quick": "always",
        "note": "In the iFly, ground power cannot be connected until the parking brake is set.",
        "why": "Holds the airplane while parked",
        "check": "Parking brake light ON",
        "how": "pb",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ],
        "simulator_model": true
      },
      {
        "id": "ifly-737-max8.gpu-power.ground-power-cart-efb",
        "number": 2,
        "text": "GROUND POWER CART (EFB)",
        "expect": "CONNECT",
        "controls": [
          "efbelec"
        ],
        "quick": "always",
        "note": "The iFly has no ground crew, so the EFB stands in for them. On a real airplane the crew connects the cart.",
        "why": "Ground power has to reach the airplane before its switch can do anything.",
        "check": "GRD POWER AVAILABLE light ON",
        "how": "efb",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ],
        "simulator_model": true
      },
      {
        "id": "ifly-737-max8.gpu-power.ground-power-switch",
        "number": 3,
        "text": "GROUND POWER SWITCH",
        "expect": "ON",
        "controls": [
          "grdpwr"
        ],
        "targets": [
          {
            "at": "oh/elecl/GRD PWR/1",
            "set": "ON"
          }
        ],
        "quick": "always",
        "why": "Connects ground power to the AC transfer buses.",
        "check": "TRANSFER BUS OFF, STANDBY PWR OFF and SOURCE OFF lights OUT",
        "if_not": "GRD POWER AVAILABLE out",
        "if_not_detail": "The ground power cart is not connected. Connect it on the EFB first",
        "how": "gpu",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      }
    ]
  },
  {
    "id": "apu-power-establishing-apu-power",
    "title": "Establishing APU power",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.apu-power.fire-switch-and-overheat-detector",
        "text": "APU FIRE SWITCH AND OVERHEAT DETECTOR SWITCH",
        "expect": "IN, NORMAL",
        "controls": [
          "apufire",
          "firetest"
        ],
        "targets": [
          {
            "at": "con/fi/FIRE TEST/1"
          },
          {
            "at": "con/fi/FIRE APU/1"
          }
        ],
        "quick": "always",
        "why": "Confirms the fire protection panel is in its normal state before it is tested.",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.apu-power.fire-test-switch",
        "number": 1,
        "text": "FIRE TEST SWITCH",
        "expect": "HOLD AT FAULT/INOP",
        "controls": [
          "firetest"
        ],
        "targets": [
          {
            "at": "con/fi/FIRE TEST/1",
            "set": "FAULT/INOP"
          }
        ],
        "quick": "always",
        "why": "Fire detection must work before the APU is started",
        "check": "MASTER CAUTION and OVHT/DET lights, FAULT and APU DET INOP lights on",
        "check_detail": "All go out when you release the switch",
        "if_not": "A light does not come on",
        "if_not_detail": "A detection loop has a fault, so a fire in that area may not be detected",
        "how": "fire",
        "explain": "fire",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.apu-power.fire-test-switch-establishing-apu",
        "text": "FIRE TEST SWITCH",
        "expect": "HOLD AT OVHT/FIRE",
        "controls": [
          "firetest"
        ],
        "targets": [
          {
            "at": "con/fi/FIRE TEST/1",
            "set": "OVHT/FIRE"
          }
        ],
        "quick": "always",
        "why": "Proves every fire and overheat warning works",
        "check": "Fire bell, FIRE WARN, MASTER CAUTION and OVHT/DET, engine and APU fire switch lights, ENG OVERHEAT and WHEEL WELL lights on",
        "check_detail": "Press FIRE WARN to silence the bell. All go out on release",
        "if_not": "The bell or a light is missing",
        "if_not_detail": "That warning path has failed",
        "how": "fire",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.apu-power.extinguisher-test-switch",
        "text": "EXTINGUISHER TEST SWITCH",
        "expect": "TO 1, THEN TO 2",
        "controls": [
          "exttest"
        ],
        "targets": [
          {
            "at": "con/fi/EXT TEST/1"
          }
        ],
        "quick": "always",
        "why": "Proves the discharge circuit to each fire bottle is intact.",
        "check": "Three green EXT TEST lights at each position",
        "check_detail": "The lights go out when you release the switch",
        "if_not": "A green light stays out",
        "if_not_detail": "That bottle circuit failed the test",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.apu-power.left-forward-fuel-pump",
        "text": "ONE LEFT FUEL PUMP",
        "expect": "ON (OPTIONAL)",
        "controls": [
          "fuelpumps"
        ],
        "targets": [
          {
            "at": "oh/fuel/CTR L/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/CTR R/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/AFT 1/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/FWD 1/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/FWD 2/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/AFT 2/1",
            "set": "ON"
          }
        ],
        "show_if": {
          "any_of": [
            {
              "option": "power",
              "equals": "gpu"
            },
            {
              "option": "start",
              "equals": "turn"
            }
          ]
        },
        "why": "Optional. One left fuel pump may run while the APU does, which gives it positive fuel pressure. The procedure does not require it, because the APU can draw fuel from the left tank by suction, but many airlines do it. Any left pump works; the aft one is the common choice.",
        "check": "That pump's LOW PRESSURE light OUT",
        "if_not": "LOW PRESSURE light stays on",
        "if_not_detail": "The pump is not running, or the left tank is low",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.apu-power.apu-switch",
        "number": 2,
        "text": "APU SWITCH",
        "expect": "START, THEN RELEASE TO ON",
        "controls": [
          "apusw"
        ],
        "targets": [
          {
            "at": "oh/apu/APU/1",
            "set": "ON"
          }
        ],
        "quick": "always",
        "why": "Starts the APU for power and air",
        "check": "LOW OIL PRESSURE light during the start, then APU GEN OFF BUS light on",
        "check_detail": "Shows the APU is running and ready to take the buses",
        "how": "apu",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.apu-power.apu-generator-switches",
        "number": 3,
        "text": "APU GENERATOR SWITCHES",
        "expect": "BOTH ON",
        "controls": [
          "apugen"
        ],
        "targets": [
          {
            "at": "oh/elecl/APU GEN/1",
            "set": "ON"
          },
          {
            "at": "oh/elecl/APU GEN/2",
            "set": "ON"
          }
        ],
        "quick": "always",
        "why": "Puts APU power on the transfer buses. The last source connected is the one in use, so the APU takes over from ground power.",
        "check": "TRANSFER BUS OFF, STANDBY PWR OFF and SOURCE OFF lights OUT",
        "check_detail": "APU GEN OFF BUS light goes out",
        "how": "apugen",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.apu-power.left-forward-fuel-pump-establishing-apu",
        "text": "ONE LEFT FUEL PUMP",
        "expect": "ON (OPTIONAL)",
        "controls": [
          "fuelpumps"
        ],
        "targets": [
          {
            "at": "oh/fuel/CTR L/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/CTR R/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/AFT 1/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/FWD 1/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/FWD 2/1",
            "set": "ON"
          },
          {
            "at": "oh/fuel/AFT 2/1",
            "set": "ON"
          }
        ],
        "show_if": {
          "all_of": [
            {
              "option": "power",
              "equals": "apu"
            },
            {
              "option": "start",
              "equals": "cold"
            }
          ]
        },
        "why": "Optional. One left fuel pump may run while the APU does, which gives it positive fuel pressure. The procedure does not require it, because the APU can draw fuel from the left tank by suction, but many airlines do it. Any left pump works; the aft one is the common choice.",
        "check": "That pump's LOW PRESSURE light OUT",
        "check_detail": "The pump runs on AC, so it starts once the APU generators are on",
        "if_not": "LOW PRESSURE light stays on",
        "if_not_detail": "The pump is not running, or the left tank is low",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.apu-power.ground-power-cart-efb",
        "number": 4,
        "text": "GROUND POWER CART (EFB)",
        "expect": "DISCONNECT",
        "controls": [
          "grddisc"
        ],
        "targets": [
          {
            "at": "oh/elecl/GRD PWR/1"
          }
        ],
        "quick": "always",
        "show_if": {
          "any_of": [
            {
              "option": "power",
              "equals": "gpu"
            },
            {
              "option": "start",
              "equals": "turn"
            }
          ]
        },
        "note": "The iFly has no ground crew, so the EFB stands in for them. On a real airplane the crew disconnects the cart.",
        "why": "The APU is carrying the load now, so ground power is no longer needed.",
        "check": "GRD POWER AVAILABLE light OUT",
        "how": "disc",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ],
        "simulator_model": true
      },
      {
        "id": "ifly-737-max8.apu-power.apu-bleed-switch",
        "text": "APU BLEED SWITCH",
        "expect": "ON",
        "controls": [
          "apubleed"
        ],
        "targets": [
          {
            "at": "oh/bleed/APU BLEED/1",
            "set": "ON"
          }
        ],
        "quick": "always",
        "show_if": {
          "any_of": [
            {
              "option": "power",
              "equals": "gpu"
            },
            {
              "option": "start",
              "equals": "turn"
            }
          ]
        },
        "why": "APU air for the packs now and the engine start later"
      },
      {
        "id": "ifly-737-max8.apu-power.pack-switches",
        "text": "PACK SWITCHES",
        "expect": "AUTO OR HIGH",
        "controls": [
          "packs"
        ],
        "targets": [
          {
            "at": "oh/bleed/L PACK/1"
          },
          {
            "at": "oh/bleed/R PACK/1"
          }
        ],
        "quick": "always",
        "show_if": {
          "any_of": [
            {
              "option": "power",
              "equals": "gpu"
            },
            {
              "option": "start",
              "equals": "turn"
            }
          ]
        },
        "why": "Supplies conditioned air. AUTO is normal. HIGH gives more airflow, for example with only one pack running",
        "check": "PACK lights OUT"
      },
      {
        "id": "ifly-737-max8.apu-power.isolation-valve-switch",
        "text": "ISOLATION VALVE SWITCH",
        "expect": "OPEN",
        "controls": [
          "iso"
        ],
        "targets": [
          {
            "at": "oh/bleed/ISOLATION VALVE/1",
            "set": "OPEN"
          }
        ],
        "show_if": {
          "any_of": [
            {
              "option": "power",
              "equals": "gpu"
            },
            {
              "option": "start",
              "equals": "turn"
            }
          ]
        },
        "why": "One APU feeds both packs"
      },
      {
        "id": "ifly-737-max8.apu-power.pack-lights",
        "text": "PACK LIGHTS",
        "expect": "OUT",
        "controls": [
          "packlts"
        ],
        "targets": [
          {
            "at": "oh/bleed/PACK/1",
            "light": "out"
          },
          {
            "at": "oh/bleed/PACK/2",
            "light": "out"
          }
        ],
        "show_if": {
          "any_of": [
            {
              "option": "power",
              "equals": "gpu"
            },
            {
              "option": "start",
              "equals": "turn"
            }
          ]
        },
        "why": "Out when the packs run correctly",
        "check": "PACK lights OUT"
      }
    ]
  },
  {
    "id": "exterior-exterior-inspection",
    "title": "Exterior inspection",
    "kind": "flow",
    "basis": [
      "prior-release"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.exterior.left-forward-fuselage",
        "number": 1,
        "text": "LEFT FORWARD FUSELAGE",
        "expect": "CHECKED",
        "controls": [
          "extins"
        ],
        "walkaround": {
          "x": 128,
          "y": 70
        },
        "look_for": "Temperature sensor, pitot tubes and angle of attack sensor clear and undamaged. Unused doors and access panels closed.",
        "location": "Left side, just aft of the nose near the forward entry door."
      },
      {
        "id": "ifly-737-max8.exterior.nose",
        "number": 2,
        "text": "NOSE",
        "expect": "CHECKED",
        "controls": [
          "extins"
        ],
        "walkaround": {
          "x": 160,
          "y": 16
        },
        "look_for": "Gear pin installed; the ground crew removes it before pushback. Nose wheel free of cracks or damage. Gear strut, gear door and steering undamaged. Lights intact.",
        "location": "Front of the airplane, around the nose gear."
      },
      {
        "id": "ifly-737-max8.exterior.right-forward-fuselage",
        "number": 3,
        "text": "RIGHT FORWARD FUSELAGE",
        "expect": "CHECKED",
        "controls": [
          "extins"
        ],
        "walkaround": {
          "x": 192,
          "y": 70
        },
        "look_for": "Temperature sensor, pitot tubes and angle of attack sensor clear and undamaged. Unused doors and access panels closed.",
        "location": "Right side, just aft of the nose."
      },
      {
        "id": "ifly-737-max8.exterior.right-wing-root",
        "number": 4,
        "text": "RIGHT WING ROOT",
        "expect": "CHECKED",
        "controls": [
          "extins"
        ],
        "walkaround": {
          "x": 188,
          "y": 136
        },
        "look_for": "Ram air deflector door open on the ground. Lower fuselage lights and leading edge flaps undamaged.",
        "location": "Where the right wing meets the fuselage."
      },
      {
        "id": "ifly-737-max8.exterior.engine-2",
        "number": 5,
        "text": "ENGINE 2",
        "expect": "CHECKED",
        "controls": [
          "extins"
        ],
        "walkaround": {
          "x": 234,
          "y": 150
        },
        "look_for": "Access panels closed and locked. Inlet and tailpipe clear. Fan blades and tailcone undamaged. Thrust reverser stowed.",
        "location": "Right engine, front and sides."
      },
      {
        "id": "ifly-737-max8.exterior.right-wing-and-leading-edge",
        "number": 6,
        "text": "RIGHT WING AND LEADING EDGE",
        "expect": "CHECKED",
        "controls": [
          "extins"
        ],
        "walkaround": {
          "x": 270,
          "y": 180
        },
        "look_for": "No ice, frost or contamination on the upper surface or leading edge. Leading edge flaps and slats undamaged.",
        "location": "Front edge and top of the right wing."
      },
      {
        "id": "ifly-737-max8.exterior.right-wing-tip",
        "number": 7,
        "text": "RIGHT WING TIP",
        "expect": "CHECKED",
        "controls": [
          "extins"
        ],
        "walkaround": {
          "x": 310,
          "y": 226
        },
        "look_for": "Position, strobe and winglet aft marker lights intact. Static discharge wicks in place.",
        "location": "End of the right wing."
      },
      {
        "id": "ifly-737-max8.exterior.right-trailing-edge",
        "number": 8,
        "text": "RIGHT TRAILING EDGE",
        "expect": "CHECKED",
        "controls": [
          "extins"
        ],
        "walkaround": {
          "x": 250,
