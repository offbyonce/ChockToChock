          "fltinst"
        ],
        "targets": [
          {
            "at": "mn/cd/OUTBOARD DU: PFD/1"
          },
          {
            "at": "mn/cd/INBOARD DU: ND AND ENGINES/1"
          },
          {
            "at": "mn/fd/INBOARD DU: ND/1"
          },
          {
            "at": "mn/fd/OUTBOARD DU: PFD/1"
          }
