  {
    "id": "memory-cabin-altitude-warning-or-rapid-depressurization",
    "title": "Cabin altitude warning or rapid depressurization",
    "kind": "non-normal",
    "basis": [
      "prior-release"
    ],
    "memory": true,
    "when": "A cabin altitude warning horn or light above 10,000 ft, or a cabin altitude exceedance.",
    "why": "Oxygen comes first, because you have limited time before hypoxia affects you.",
    "steps": [
      {
        "id": "ifly-737-max8.memory.oxygen-masks-and-regulators",
        "number": 1,
        "text": "OXYGEN MASKS AND REGULATORS",
        "expect": "ON, 100%",
        "controls": [
          "mask"
        ],
        "targets": [
          {
            "at": "seat/side/NORMAL/100%/1",
            "set": "100%"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.crew-communications",
        "number": 2,
        "text": "CREW COMMUNICATIONS",
        "expect": "ESTABLISH",
        "controls": [
          "mask"
        ],
        "targets": [
          {
            "at": "seat/side/MASK STOWAGE/1"
          },
          {
            "at": "seat/side/RESET/TEST/1"
          },
          {
            "at": "seat/side/EMERGENCY/TEST/1"
          },
          {
            "at": "seat/side/NORMAL/100%/1"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.pressurization-mode-selector",
        "number": 3,
        "text": "PRESSURIZATION MODE SELECTOR",
        "expect": "MAN",
        "controls": [
          "press"
        ],
        "targets": [
          {
            "at": "oh/press/MODE/1",
            "set": "MAN"
          }
        ],
        "non_recall": true,
        "panel_lights": {
          "press": [
            "MODE"
          ]
        }
      },
      {
        "id": "ifly-737-max8.memory.outflow-valve-switch",
        "number": 4,
        "text": "OUTFLOW VALVE SWITCH",
        "expect": "HOLD TO CLOSE UNTIL THE INDICATOR SHOWS FULLY SHUT",
        "controls": [
          "outflow"
        ],
        "targets": [
          {
            "at": "oh/press/VALVE/1"
          },
          {
            "at": "oh/press/OUTFLOW/1",
            "set": "CLOSE"
          }
        ],
        "non_recall": true
      },
      {
        "id": "ifly-737-max8.memory.if-cabin-altitude-is-uncontrollable",
        "number": 5,
        "text": "IF CABIN ALTITUDE IS UNCONTROLLABLE",
        "expect": "FASTEN BELTS ON",
        "controls": [
          "sblts"
        ],
        "targets": [
          {
            "at": "oh/col/FASTEN BELTS/1",
            "set": "ON"
          }
        ],
        "non_recall": true
      },
      {
        "id": "ifly-737-max8.memory.if-cabin-altitude-is-above-or-expected-to-go",
        "number": 6,
        "text": "IF CABIN ALTITUDE IS ABOVE, OR EXPECTED TO GO ABOVE, 14,000 FT",
        "expect": "PASS OXYGEN ON, GO TO EMERGENCY DESCENT",
        "controls": [
          "paxoxy"
        ],
        "targets": [
          {
            "at": "aft/oxy/PASS OXYGEN/1",
            "set": "ON"
          },
          {
            "at": "aft/oxy/PASS OXY ON/1",
            "light": "on"
          }
        ],
        "non_recall": true
      },
      {
        "id": "ifly-737-max8.memory.if-cabin-altitude-is-controllable",
        "number": 7,
        "text": "IF THE CABIN ALTITUDE RESPONDS",
        "expect": "STAY IN MANUAL. MASKS CAN COME OFF ONCE THE CABIN IS 10,000 FT OR LOWER",
        "controls": [
          "press"
        ],
        "targets": [
          {
            "at": "oh/cab/CABIN ALT/1"
          },
          {
            "at": "oh/cab/CABIN CLIMB/1"
          },
          {
            "at": "oh/press/MANUAL/1",
            "light": "out"
          },
          {
            "at": "oh/press/FLT ALT/1"
          },
          {
            "at": "oh/press/FLT ALT KNOB/1"
          },
          {
            "at": "oh/press/MODE/1"
          }
        ],
        "non_recall": true
      }
    ]
  },
  {
