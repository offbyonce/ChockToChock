  {
    "id": "preflight-preflight-checklist",
    "title": "Preflight checklist",
    "kind": "checklist",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.preflight.oxygen",
        "text": "OXYGEN",
        "expect": "TESTED, 100%",
        "controls": [
          "oxym"
        ],
        "why": "Needed at once in a decompression or smoke",
        "how": "crew",
        "explain": "crew"
      },
      {
        "id": "ifly-737-max8.preflight.navigation-transfer-and-display-switches",
        "text": "NAVIGATION TRANSFER AND DISPLAY SWITCHES",
        "expect": "NORMAL, SOURCE AUTO",
        "controls": [
          "navsw",
          "dispsw"
        ],
        "targets": [
          {
            "at": "oh/nav/VHF NAV/1",
            "set": "NORMAL"
          },
          {
            "at": "oh/nav/IRS/1",
            "set": "NORMAL"
          },
          {
            "at": "oh/nav/FMC/1",
            "set": "NORMAL"
          },
          {
            "at": "oh/disp/SOURCE/1",
            "set": "AUTO"
          },
          {
            "at": "oh/disp/CONTROL PANEL/1",
            "set": "NORMAL"
          }
        ],
        "why": "Each side uses its own source",
        "check": "All NORMAL",
        "check_detail": "SOURCE AUTO",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.window-heat",
        "text": "WINDOW HEAT",
        "expect": "ON",
        "controls": [
          "wheat"
        ],
        "targets": [
          {
            "at": "oh/heat/ON/1",
            "light": "on"
          },
          {
            "at": "oh/heat/ON/2",
            "light": "on"
          },
          {
            "at": "oh/heat/ON/3",
            "light": "on"
          },
          {
            "at": "oh/heat/ON/4",
            "light": "on"
          },
          {
            "at": "oh/heat/L SIDE/1",
            "set": "ON"
          },
          {
            "at": "oh/heat/L FWD/1",
            "set": "ON"
          },
          {
            "at": "oh/heat/R FWD/1",
            "set": "ON"
          },
          {
            "at": "oh/heat/R SIDE/1",
            "set": "ON"
          }
        ],
        "why": "Heated windows resist ice and fogging, and warm windshield panels are more resistant to bird strikes.",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.pressurization-mode-selector",
        "text": "PRESSURIZATION MODE SELECTOR",
        "expect": "AUTO",
        "controls": [
          "press"
        ],
        "targets": [
          {
            "at": "oh/press/MODE/1",
            "set": "AUTO"
          }
        ],
        "why": "Cabin pressure follows FLT ALT and LAND ALT",
        "panel_lights": {
          "press": [
            "MODE"
          ]
        },
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.flight-instruments",
        "text": "FLIGHT INSTRUMENTS",
        "expect": "HEADING ___ ALTIMETER ___",
        "controls": [
          "fltinst"
        ],
        "targets": [
          {
            "at": "mn/cd/OUTBOARD DU: PFD/1"
