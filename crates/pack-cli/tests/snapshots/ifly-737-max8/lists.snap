            "at": "oh/aice/WING ANTI-ICE/1",
            "set": "OFF"
          },
          {
            "at": "oh/aice/ENG 1/1",
            "set": "OFF"
          },
          {
            "at": "oh/aice/ENG 2/1",
            "set": "OFF"
          }
        ],
        "quick": "always",
        "note": "Engine anti-ice ON in icing conditions (TAT 10C or below with visible moisture). Turn it off once you are clear of icing.",
        "why": "Long use in dry air can overheat the inlet"
