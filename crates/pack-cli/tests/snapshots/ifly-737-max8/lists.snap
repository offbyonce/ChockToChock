          {
            "at": "oh/col/NOT ARMED/1",
            "light": "on"
          },
          {
            "at": "oh/col/EMER EXIT LIGHTS/1",
            "set": "OFF"
          }
        ],
        "why": "ARMED would light the exit lights when power goes off",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.secure.pack-switches-check",
        "text": "PACK SWITCHES",
        "expect": "OFF",
        "controls": [
          "packs"
        ],
        "targets": [
          {
            "at": "oh/bleed/L PACK/1",
            "set": "OFF"
          },
          {
            "at": "oh/bleed/R PACK/1",
            "set": "OFF"
          }
        ],
        "why": "Stops the packs before the air source goes off",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.secure.apu-or-ground-power-check",
        "text": "APU OR GROUND POWER",
        "expect": "OFF",
        "controls": [
          "apub"
        ],
        "targets": [
          {
            "at": "oh/elecl/GEN 1/1",
            "set": "OFF"
          },
          {
            "at": "oh/elecl/APU GEN/1",
            "set": "OFF"
          },
          {
            "at": "oh/elecl/APU GEN/2",
            "set": "OFF"
          },
          {
            "at": "oh/elecl/GEN 2/1",
            "set": "OFF"
          }
        ],
        "note": "Do this just before the battery goes off.",
        "why": "Removes AC power from the airplane",
        "panel_lights": {
          "apub": [
            "APU GEN"
          ]
        },
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.secure.battery-check",
        "text": "BATTERY",
        "expect": "OFF",
        "controls": [
          "bat"
        ],
        "targets": [
          {
            "at": "oh/elecu/BATTERY/1",
            "set": "OFF"
          }
        ],
        "note": "The last switch.",
        "why": "Stops battery drain",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      }
    ]
  },
  {
    "id": "memory-runaway-stabilizer",
    "title": "Runaway stabilizer",
    "kind": "non-normal",
    "basis": [
      "regulator-docs"
    ],
    "memory": true,
    "when": "Uncommanded stabilizer movement that is continuous or not appropriate for flight conditions.",
    "why": "An uncontrolled trim runaway makes the airplane harder to control. Controlling the airplane comes first, then trim cutout stops the input.",
    "steps": [
      {
        "id": "ifly-737-max8.memory.control-column",
        "number": 1,
        "text": "CONTROL COLUMN",
        "expect": "HOLD FIRMLY",
        "controls": [
          "column"
        ],
        "targets": [
          {
            "at": "seat/yoke/STAB TRIM/1"
          },
          {
            "at": "seat/yoke/A/P DISENGAGE/1"
          }
        ],
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.autopilot-if-engaged",
        "number": 2,
        "text": "AUTOPILOT (IF ENGAGED)",
        "expect": "DISENGAGE",
        "controls": [
          "apdis"
        ],
        "targets": [
          {
            "at": "gl/mcp/DISENGAGE/1"
          }
        ],
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.autothrottle-if-engaged",
        "number": 3,
        "text": "AUTOTHROTTLE (IF ENGAGED)",
        "expect": "DISENGAGE",
        "controls": [
          "apdisc"
        ],
        "targets": [
          {
            "at": "con/st/A/T DISENGAGE/1"
          }
        ],
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.column-and-thrust-levers",
        "number": 4,
        "text": "COLUMN AND THRUST LEVERS",
        "expect": "CONTROL PITCH ATTITUDE AND AIRSPEED",
        "controls": [
          "column"
        ],
        "targets": [
          {
            "at": "seat/yoke/STAB TRIM/1"
          },
          {
            "at": "seat/yoke/A/P DISENGAGE/1"
          }
        ],
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.main-electric-stabilizer-trim",
        "number": 5,
        "text": "MAIN ELECTRIC STABILIZER TRIM",
        "expect": "USE TO REDUCE COLUMN FORCES",
        "controls": [
          "column"
        ],
        "targets": [
          {
            "at": "seat/yoke/STAB TRIM/1"
          },
          {
            "at": "seat/yoke/A/P DISENGAGE/1"
          }
        ],
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.if-runaway-stops-after-autopilot-is-disengaged",
        "number": 6,
        "text": "IF RUNAWAY STOPS AFTER AUTOPILOT IS DISENGAGED",
        "expect": "DO NOT RE-ENGAGE AUTOPILOT OR AUTOTHROTTLE. END OF PROCEDURE",
        "controls": [
          "apdis"
        ],
        "targets": [
          {
            "at": "gl/mcp/DISENGAGE/1"
          }
        ],
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.if-runaway-continues",
        "number": 7,
        "text": "IF RUNAWAY CONTINUES",
        "expect": "BOTH STAB TRIM CUTOUT SWITCHES TO CUTOUT",
        "controls": [
          "stabcut"
        ],
        "targets": [
          {
            "at": "con/lo/STAB TRIM PRI/1",
            "set": "CUT OUT"
          },
          {
            "at": "con/lo/STAB TRIM B/U/1",
            "set": "CUT OUT"
          }
        ],
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.if-runaway-still-continues",
        "number": 8,
        "text": "IF RUNAWAY STILL CONTINUES",
        "expect": "GRASP AND HOLD THE STABILIZER TRIM WHEEL",
        "controls": [
          "stabwheel"
        ],
        "targets": [
          {
            "at": "con/st/STAB TRIM WHEEL/1"
          },
          {
            "at": "con/st/STAB TRIM WHEEL/2"
          }
        ],
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.stabilizer",
        "number": 9,
        "text": "STABILIZER",
        "expect": "TRIM MANUALLY",
        "controls": [
          "stabwheel"
        ],
        "targets": [
          {
            "at": "con/st/STAB TRIM WHEEL/1"
          },
          {
            "at": "con/st/STAB TRIM WHEEL/2"
          }
        ],
        "non_recall": true,
        "how": "trim",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.manual-trim",
        "number": 10,
        "text": "MANUAL TRIM",
        "expect": "TWO-PILOT EFFORT MAY BE USED. LOWER AIRSPEED EASES THE LOAD",
        "controls": [
          "stabwheel"
        ],
        "targets": [
          {
            "at": "con/st/STAB TRIM WHEEL/1"
          },
          {
            "at": "con/st/STAB TRIM WHEEL/2"
          }
        ],
        "non_recall": true,
        "note": "Anticipate trim changes, and keep the autopilot and autothrottle off.",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      },
      {
        "id": "ifly-737-max8.memory.final-approach",
        "number": 11,
        "text": "FINAL APPROACH",
        "expect": "ESTABLISH LANDING CONFIGURATION AND IN-TRIM CONDITION EARLY",
        "controls": [
          "stabind"
        ],
        "targets": [
          {
            "at": "con/st/STAB TRIM WHEEL/1"
          },
          {
            "at": "con/st/STAB TRIM WHEEL/2"
          }
        ],
        "non_recall": true,
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-10"
          }
        ]
      }
    ]
  },
  {
    "id": "memory-airspeed-unreliable",
    "title": "Airspeed unreliable",
    "kind": "non-normal",
    "basis": [
      "regulator-docs"
    ],
    "memory": true,
    "when": "You suspect one or more airspeed or Mach readings are wrong.",
    "why": "A safe pitch and thrust setting keeps the airplane flying while you work out which indications to trust.",
    "steps": [
      {
        "id": "ifly-737-max8.memory.autopilot-if-engaged-airspeed-unreliable",
        "number": 1,
        "text": "AUTOPILOT (IF ENGAGED)",
