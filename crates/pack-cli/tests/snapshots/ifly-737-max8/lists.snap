        ],
        "targets": [
          {
            "at": "oh/lte/LOGO/1",
            "set": "ON"
          },
          {
            "at": "oh/lte/WING/1",
            "set": "ON"
          },
          {
            "at": "oh/ltl/LANDING L/1",
            "set": "ON"
          },
          {
            "at": "oh/ltl/LANDING R/1",
