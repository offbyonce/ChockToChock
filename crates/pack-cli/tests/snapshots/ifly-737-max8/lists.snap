        "expect": "IF AVAILABLE, CONNECT AND VERIFY ACCEPTED, THEN APU OFF",
        "controls": [
          "grdpwr"
        ],
        "targets": [
          {
            "at": "oh/elecl/GRD PWR/1",
            "set": "OFF"
          }
        ],
        "why": "Takes over before the APU goes off",
        "check": "Ground power on the buses",
        "check_detail": "GRD POWER switch ON once the AVAILABLE light is on, then the APU switch OFF"
      },
      {
        "id": "ifly-737-max8.shutdown.irs",
        "number": 15,
        "text": "IRS",
        "expect": "OFF, OR LEAVE IN NAV FOR A QUICK TURNAROUND",
        "controls": [
          "irs"
        ],
        "targets": [
          {
            "at": "aft/irs/IRS L/1"
          },
          {
            "at": "aft/irs/IRS R/1"
          }
        ],
        "why": "Leaving NAV avoids a new alignment if you fly again soon"
      }
    ]
  },
