  {
    "id": "preflight-preliminary-preflight-procedure",
    "title": "Preliminary preflight procedure",
    "kind": "flow",
    "basis": [
      "ifly-docs"
    ],
    "steps": [
      {
        "id": "ifly-737-max8.preflight.panel-and-flood-lights",
        "text": "PANEL AND FLOOD LIGHTS",
        "expect": "AS NEEDED",
        "controls": [
          "panellts"
        ],
        "targets": [
          {
            "at": "mn/clt/MAIN PANEL/1"
          },
          {
            "at": "mn/clt/BACKGROUND/1"
          },
          {
            "at": "mn/clt/AFDS FLOOD/1"
          },
          {
            "at": "mn/gp/MAIN PANEL/1"
          }
        ],
        "why": "Comfortable lighting for the rest of the preflight, especially at night",
        "check": "Panels readable and lights not glaring"
      },
      {
        "id": "ifly-737-max8.preflight.irs",
        "number": 1,
        "text": "IRS",
        "expect": "BOTH NAV",
        "controls": [
          "irs"
        ],
        "targets": [
          {
            "at": "aft/irs/IRS L/1",
            "set": "NAV"
          },
          {
            "at": "aft/irs/IRS R/1",
            "set": "NAV"
          }
        ],
        "quick": "always",
        "why": "Must align while the airplane is still",
        "how": "irs",
        "explain": "irs",
        "timer": {
          "seconds": 600,
          "label": "IRS alignment",
          "note": "A typical time. The ALIGN light going out is what counts."
        },
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.elt-switch",
        "number": 2,
        "text": "ELT SWITCH",
        "expect": "GUARD CLOSED, LIGHT OUT",
        "controls": [
          "elt"
        ],
        "targets": [
          {
            "at": "aft/elt/ELT/1",
            "light": "out"
          },
          {
            "at": "aft/elt/ELT SWITCH/1"
          }
        ],
        "note": "The iFly does not simulate the ELT. The switch and light only respond to clicks.",
        "why": "Stops an accidental distress signal",
        "check": "Guard closed",
        "check_detail": "Light OUT",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ],
        "simulator_model": true
      },
      {
        "id": "ifly-737-max8.preflight.elevator-jam-landing-assist",
        "number": 3,
        "text": "ELEVATOR JAM LANDING ASSIST",
        "expect": "GUARD CLOSED, LIGHTS OUT",
        "controls": [
          "elevjam"
        ],
        "targets": [
          {
            "at": "aft/jam/ASSIST ON/1",
            "light": "out"
          },
          {
            "at": "aft/jam/ELEV JAM LANDING ASSIST/1"
          }
        ],
        "why": "Not simulated in the iFly. Just confirm the guard is closed and the lights are out",
        "not_simulated": true,
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.gps-ils-gls-and-maint-lights",
        "number": 4,
        "text": "GPS, ILS, GLS AND MAINT LIGHTS",
        "expect": "OUT",
        "controls": [
          "gpslts"
        ],
        "targets": [
          {
            "at": "aft/irs/GPS/1",
            "light": "out"
          },
          {
            "at": "aft/irs/ILS/1",
            "light": "out"
          },
          {
            "at": "aft/irs/GLS/1",
            "light": "out"
          },
          {
            "at": "aft/mnt/MAINT/1",
            "light": "out"
          }
        ],
        "why": "A lit light means a GPS, ILS, GLS or maintenance fault",
        "check": "GPS, ILS, GLS and MAINT OUT",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.eec-switches",
        "number": 5,
        "text": "EEC SWITCHES",
        "expect": "ON, ENGINE CONTROL, REVERSER LIMITED, REVERSER COMMAND AND REVERSER AIR/GRD LIGHTS OUT",
        "controls": [
          "eec"
        ],
        "targets": [
          {
            "at": "aft/eng/REVERSER LIMITED/1",
            "light": "out"
          },
          {
            "at": "aft/eng/ENGINE CONTROL/1",
            "light": "out"
          },
          {
            "at": "aft/eng/REVERSER LIMITED/2",
            "light": "out"
          },
          {
            "at": "aft/eng/ENGINE CONTROL/2",
            "light": "out"
          },
          {
            "at": "aft/eng/EEC 1/1",
            "set": "ON"
          },
          {
            "at": "aft/eng/EEC 2/1",
            "set": "ON"
          }
        ],
        "note": "The electronic engine control protects the engine limits. Check that both show ON, with no ALTN light.",
        "why": "Protects the engine limits",
        "check": "Both EEC buttons show ON",
        "check_detail": "No ALTN shown",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.passenger-oxygen-switch",
        "number": 6,
        "text": "PASSENGER OXYGEN SWITCH",
        "expect": "GUARD CLOSED, PASS OXY ON LIGHT OUT",
        "controls": [
          "paxoxy"
        ],
        "targets": [
          {
            "at": "aft/oxy/PASS OXYGEN/1"
          },
          {
            "at": "aft/oxy/PASS OXY ON/1",
            "light": "out"
          }
        ],
        "note": "Check that the guard is closed so the cabin masks cannot be dropped by accident.",
        "why": "Stops cabin masks dropping by accident",
        "check": "Guard closed",
        "check_detail": "PASS OXY ON light OUT",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.crew-oxygen-pressure",
        "number": 7,
        "text": "CREW OXYGEN PRESSURE",
        "expect": "SUFFICIENT FOR THE FLIGHT",
        "controls": [
          "crewoxy"
        ],
        "targets": [
          {
            "at": "aft/oxy/CREW OXYGEN/1"
          }
        ],
        "why": "Needed at once in a decompression or smoke",
        "check": "Crew oxygen pressure read on the gauge",
        "check_detail": "Enough for the flight",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.landing-gear-indicator-lights-ovhd",
        "number": 8,
        "text": "LANDING GEAR INDICATOR LIGHTS (OVHD)",
        "expect": "3 GREEN",
        "controls": [
          "gearovhd"
        ],
        "targets": [
          {
            "at": "aft/gear/LEFT GEAR/1",
            "light": "on"
          },
          {
            "at": "aft/gear/RIGHT GEAR/1",
            "light": "on"
          },
          {
            "at": "aft/gear/NOSE GEAR/1",
            "light": "on"
          }
        ],
        "why": "Second set of lights, green is down and locked",
        "check": "3 green lights",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.flight-recorder-switch",
        "number": 9,
        "text": "FLIGHT RECORDER SWITCH",
        "expect": "GUARD CLOSED",
        "controls": [
          "fltrec"
        ],
        "targets": [
          {
            "at": "aft/rec/FLIGHT RECORDER/1"
          }
        ],
        "why": "Recorder runs automatically",
        "check": "Guard closed",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.mach-airspeed-warning-test",
        "number": 10,
        "text": "MACH AIRSPEED WARNING TEST",
        "expect": "TEST EACH, CLACKER SOUNDS",
        "controls": [
          "mach"
        ],
        "targets": [
          {
            "at": "aft/rec/MACH TEST 1/1"
          },
          {
            "at": "aft/rec/MACH TEST 2/1"
          }
        ],
        "why": "The clacker warns when you exceed the maximum operating speed (VMO/MMO)",
        "check": "Clacker sounds",
        "check_detail": "For each switch",
        "how": "mach",
        "explain": "mach",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.stall-warning-test",
        "text": "STALL WARNING TEST",
        "expect": "TEST EACH, COLUMN SHAKES",
        "controls": [
          "stalltest"
        ],
        "targets": [
          {
            "at": "aft/stall/STALL TEST 1/1"
          },
          {
            "at": "aft/stall/STALL TEST 2/1"
          }
        ],
        "why": "Stick shaker warns of an approaching stall",
        "how": "stall",
        "explain": "stall"
      },
      {
        "id": "ifly-737-max8.preflight.manual-gear-extension-access-door",
        "number": 11,
        "text": "MANUAL GEAR EXTENSION ACCESS DOOR",
        "expect": "CLOSED",
        "controls": [
          "mangear"
        ],
        "why": "Covers the manual gear release handles",
        "check": "Door closed",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.cdu",
        "number": 12,
        "text": "CDU",
        "expect": "PROGRAM FOR FLIGHT",
        "controls": [
          "cdu"
        ],
        "targets": [
          {
            "at": "con/cdul/CDU/1"
          },
          {
            "at": "con/cdur/CDU/1"
          }
        ],
        "opens": "preflight-setup",
        "quick": "always",
        "why": "Route, performance, N1 limit and takeoff reference",
        "check": "Route, performance, N1 limit and TAKEOFF REF pages complete",
        "how": "cdu",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.flight-control-switches",
        "number": 13,
        "section": "Overhead panel",
        "text": "FLIGHT CONTROL SWITCHES",
        "expect": "A ON, B ON, GUARDS CLOSED",
        "controls": [
          "fltctrl"
        ],
        "targets": [
          {
            "at": "oh/fctl/FLT CONTROL A/1",
            "set": "A ON"
          },
          {
            "at": "oh/fctl/FLT CONTROL B/1",
            "set": "B ON"
          }
        ],
        "note": "These give hydraulic power to the flight controls. Both must be on for flight.",
        "why": "Hydraulic power to the flight controls",
        "check": "LOW PRESSURE lights ON",
        "check_detail": "Normal until hydraulic pressure is up",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.spoiler-switches",
        "number": 14,
        "text": "SPOILER SWITCHES",
        "expect": "ON, GUARDS CLOSED",
        "controls": [
          "spoilsw"
        ],
        "targets": [
          {
            "at": "oh/fctl/SPOILER A/1",
            "set": "ON"
          },
          {
            "at": "oh/fctl/SPOILER B/1",
            "set": "ON"
          }
        ],
        "why": "Hydraulic power to the flight spoilers",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.yaw-damper-switch",
        "number": 15,
        "text": "YAW DAMPER SWITCH",
        "expect": "ON, LIGHT OUT",
        "controls": [
          "yawd"
        ],
        "targets": [
          {
            "at": "oh/fctl/YAW DAMPER/1",
            "light": "out"
          },
          {
            "at": "oh/fctl/YAW DAMPER/2",
            "set": "ON"
          }
        ],
        "quick": "always",
        "note": "Check that the amber YAW DAMPER light goes out. The yaw damper engages only with the B FLT CONTROL switch ON.",
        "why": "Must be on for flight",
        "check": "YAW DAMPER light OUT",
        "if_not": "Light stays on",
        "if_not_detail": "Check the B FLT CONTROL switch is ON. The yaw damper engages only then",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.standby-hydraulic-lights",
        "number": 16,
        "text": "STANDBY HYDRAULIC LIGHTS",
        "expect": "OUT",
        "controls": [
          "stbyhyd"
        ],
        "targets": [
          {
            "at": "oh/fctl/LOW QUANTITY/1",
            "light": "out"
          },
          {
            "at": "oh/fctl/LOW PRESSURE/1",
            "light": "out"
          },
          {
            "at": "oh/fctl/STBY RUD ON/1",
            "light": "out"
          }
        ],
        "why": "A lit light means a standby hydraulic fault",
        "check": "LOW QUANTITY, LOW PRESSURE and STBY RUD ON OUT",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.alternate-flaps-switches",
        "number": 17,
        "text": "ALTERNATE FLAPS MASTER AND POSITION SWITCHES",
        "expect": "MASTER OFF, GUARD CLOSED, POSITION OFF",
        "controls": [
          "altflap"
        ],
        "targets": [
          {
            "at": "oh/fctl/ALT FLAPS MASTER/1",
            "set": "OFF"
          },
          {
            "at": "oh/fctl/ALT FLAPS/1",
            "set": "OFF"
          }
        ],
        "why": "Electric flap backup, off in normal use",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.feel-diff-press-speed-trim-fail-mach-trim-fail",
        "number": 18,
        "text": "FEEL DIFF PRESS, SPEED TRIM FAIL, MACH TRIM FAIL, AUTO SLAT FAIL AND SPOILERS LIGHTS",
        "expect": "OUT",
        "controls": [
          "fctllts"
        ],
        "targets": [
          {
            "at": "oh/fctl/FEEL DIFF PRESS/1",
            "light": "out"
          },
          {
            "at": "oh/fctl/SPEED TRIM FAIL/1",
            "light": "out"
          },
          {
            "at": "oh/fctl/MACH TRIM FAIL/1",
            "light": "out"
          },
          {
            "at": "oh/fctl/AUTO SLAT FAIL/1",
            "light": "out"
          },
          {
            "at": "oh/fctl/SPOILERS/1",
            "light": "out"
          }
        ],
        "note": "The iFly does not model the FEEL DIFF PRESS light.",
        "why": "A lit light is a flight control fault to sort out before flight",
        "check": "All five lights OUT",
        "panel_lights": {
          "fctllts": [
            "FEEL DIFF PRESS",
            "SPEED TRIM FAIL",
            "MACH TRIM FAIL",
            "AUTO SLAT FAIL",
            "SPOILERS"
          ]
        },
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ],
        "simulator_model": true
      },
      {
        "id": "ifly-737-max8.preflight.navigation-transfer-switches",
        "number": 19,
        "text": "NAVIGATION TRANSFER SWITCHES",
        "expect": "VHF NAV, IRS AND FMC NORMAL",
        "controls": [
          "navsw"
        ],
        "targets": [
          {
            "at": "oh/nav/VHF NAV/1",
            "set": "NORMAL"
          },
          {
            "at": "oh/nav/IRS/1",
            "set": "NORMAL"
          },
          {
            "at": "oh/nav/FMC/1",
            "set": "NORMAL"
          }
        ],
        "why": "Each side uses its own navigation source",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.display-source-switches",
        "number": 20,
        "text": "DISPLAY SOURCE SWITCHES",
        "expect": "SOURCE AUTO, CONTROL PANEL NORMAL",
        "controls": [
          "dispsw"
        ],
        "targets": [
          {
            "at": "oh/disp/SOURCE/1",
            "set": "AUTO"
          },
          {
            "at": "oh/disp/CONTROL PANEL/1",
            "set": "NORMAL"
          }
        ],
        "why": "Each side's displays run from their own computer",
        "confirmed_by": [
          {
            "kind": "vendor-docs",
            "date": "2026-11-09"
          }
        ]
      },
      {
        "id": "ifly-737-max8.preflight.fuel-valve-and-filter-lights",
        "text": "ENG VALVE CLOSED, SPAR VALVE CLOSED AND FILTER BYPASS LIGHTS",
        "expect": "VALVE LIGHTS ON, FILTER BYPASS OUT",
        "controls": [
          "fuellts"
        ],
        "targets": [
          {
            "at": "oh/fuel/ENG VALVE CLOSED/1",
            "light": "on"
          },
          {
            "at": "oh/fuel/SPAR VALVE CLOSED/1",
            "light": "on"
          },
