  "controls": [
    {
      "id": "bat",
      "name": "Battery switch",
      "zone": "elecu",
      "location": "Upper section of the electrical panel, under a red guard.",
      "function": "Connects the battery to the electrical system. This is the first switch in a cold and dark start."
    },
    {
      "id": "stby",
      "name": "Standby power switch",
      "zone": "elecl",
      "location": "Electrical panel, next to the generator drive disconnects. Guarded.",
      "function": "Three positions: BAT, OFF, AUTO. Leave it in AUTO with the guard down so standby power switches itself over."
    },
    {
      "id": "altflap",
      "name": "Alternate flaps switches",
      "zone": "fctl",
      "location": "Flight control panel, right side. The arm switch is guarded and sits beside the UP/OFF/DOWN position switch.",
      "function": "Moves the flaps electrically if hydraulics fail. Stays off in normal use."
    },
    {
      "id": "wiper",
      "name": "Wiper selectors",
      "zone": "wipe",
      "location": "Low on the forward overhead, just above the engine start row. One knob for each side.",
      "function": "Rotary knobs for each windshield wiper: PARK, INT, LOW, HIGH."
    },
    {
      "id": "hydpumps",
      "name": "Hydraulic pump switches",
      "zone": "hyd",
      "location": "Hydraulic panel, right of center on the forward overhead. Four switches in a row.",
      "function": "ENG 1 and ELEC 2 feed system A. ELEC 1 and ENG 2 feed system B."
    },
    {
      "id": "gearlever",
      "name": "Landing gear lever",
      "zone": "gear",
      "location": "Center panel (P2). The lever with the wheel-shaped knob.",
      "function": "The MAX lever has two positions, UP and DN. There is no OFF position as on the NG."
    },
    {
      "id": "pbrake",
      "name": "Parking brake lever",
      "zone": "pb",
      "location": "Aft left of the control stand. A red PARKING BRAKE PULL handle, with the PARK BRAKE LIGHT beside it.",
      "function": "Hold the toe brakes and pull the handle to set it, or click it in the sim."
    },
    {
      "id": "efbelec",
      "name": "EFB ground power",
      "zone": "efb",
      "location": "Open the tablet on the side wall and find the ground services page.",
      "function": "The sim tablet requests the ground power cart. It is a sim step, so there is no switch for it on the real panel."
    },
    {
      "id": "grdpwr",
      "name": "Ground power switch",
      "zone": "elecl",
      "location": "Lower section of the electrical panel, above the generator switches.",
      "function": "Puts external power on the buses. Wait for the GRD POWER AVAILABLE light before switching on."
    },
    {
      "id": "ovhtdet",
      "name": "Overheat detector switches",
      "zone": "fire",
      "location": "Fire protection panel on the aft electronic panel, one switch for each engine: A, NORMAL or B.",
      "function": "Chooses which detector loop warns of an engine overheat or fire. NORMAL uses both."
    },
    {
      "id": "firetest",
      "name": "Fire test switch",
      "zone": "fire",
      "location": "Overheat/fire protection panel on the aft pedestal.",
      "function": "Tests the engine, APU and wheel well fire warnings. Expect the bell, master FIRE WARN lights and the fire handle lights."
    },
    {
      "id": "apusw",
      "name": "APU switch",
      "zone": "apu",
      "location": "Bottom row of the forward overhead, between the TAXI light switch and the engine start switches.",
      "function": "OFF, ON and START. Hold to START, release to ON. START is spring-loaded back to ON."
    },
    {
      "id": "apugen",
      "name": "APU generator switches",
      "zone": "elecl",
      "location": "Electrical panel, between the two engine generator switches.",
      "function": "Two switches that put APU power on each AC transfer bus."
    },
    {
      "id": "grddisc",
      "name": "Ground power disconnect",
      "zone": "elecl",
      "location": "GRD POWER switch on the electrical panel. The cart itself is removed from the EFB ground services page.",
      "function": "Switching the APU generators on takes ground power off the buses. Then remove the cart from the EFB."
    },
    {
      "id": "irs",
      "name": "IRS mode selectors",
      "zone": "airs",
      "location": "Aft overhead. Left and right rotary selectors under the IRS display.",
      "function": "OFF, ALIGN, NAV, ATT. Set both to NAV and let them align before moving."
    },
    {
      "id": "elt",
      "name": "ELT switch",
      "zone": "aelt",
      "location": "ELT control panel on the aft overhead.",
      "function": "Emergency locator transmitter. It stays guarded unless needed."
    },
    {
      "id": "elevjam",
      "name": "Elevator jam landing assist",
      "zone": "ajam",
      "location": "Aft overhead, forward edge on the captain side, with its own ASSIST ON light and switch. MAX only.",
      "function": "Helps land with a jammed elevator. Not simulated in the iFly."
    },
    {
      "id": "gpslts",
      "name": "GPS, ILS, GLS and MAINT lights",
      "zone": "alights",
      "location": "Aft overhead. GPS, ILS and GLS lights sit above the IRS status lights; the amber MAINT light is on the forward edge strip.",
      "function": "Amber caution lights. All should be out on the ground before flight."
    },
    {
      "id": "eec",
      "name": "EEC switches",
      "zone": "aeng",
      "location": "Engine panel on the aft overhead. One ON/ALTN button for each engine, with REVERSER LIMITED and ENGINE CONTROL lights.",
      "function": "Electronic engine control. Normal is ON with the lights out. ALTN means alternate mode, automatic or selected."
    },
    {
      "id": "paxoxy",
      "name": "Passenger oxygen switch",
      "zone": "aoxy",
      "location": "Oxygen panel on the aft overhead. Guarded.",
      "function": "Manually drops the cabin masks. Stays guarded, with PASS OXY ON light out."
    },
    {
      "id": "crewoxy",
      "name": "Crew oxygen gauge",
      "zone": "aoxy",
      "location": "Oxygen panel on the aft overhead.",
      "function": "Needle gauge showing crew oxygen pressure. Read it and confirm it is enough for the flight."
    },
    {
      "id": "gearovhd",
      "name": "Overhead gear indicator lights",
      "zone": "agear",
      "location": "Aft overhead, forward edge. LEFT and RIGHT GEAR side by side with NOSE GEAR below. Separate from the main gear lights.",
      "function": "A second set of gear position lights. Green means down and locked."
    },
    {
      "id": "fltrec",
      "name": "Flight recorder switch",
      "zone": "arec",
      "location": "Flight recorder panel on the aft overhead. Guarded.",
      "function": "Stays guard closed so the recorder runs automatically."
    },
    {
      "id": "mach",
      "name": "Mach airspeed warning test",
      "zone": "atest",
      "location": "Aft overhead, captain-side of the stall warning tests: two small round buttons, NO. 1 and NO. 2, beside the flight recorder switch.",
      "function": "Hold each switch and listen for the clacker overspeed warning."
    },
    {
      "id": "mangear",
      "name": "Manual gear extension access",
      "zone": "floor",
      "location": "Access door in the floor behind the first officer seat.",
      "function": "Holds the three manual gear release handles. Confirm the door is closed."
    },
    {
      "id": "cdu",
      "name": "Control display units",
      "zone": "cdu",
      "location": "Forward electronic panel. One CDU in front of each pilot, either side of the pedestal.",
      "function": "Flight management system entry. Program route, performance, N1 limit and takeoff reference."
    },
    {
      "id": "fltctrl",
      "name": "Flight control switches",
      "zone": "fctl",
      "location": "Top left of the flight control panel. Two guarded switches, A and B.",
      "function": "OFF, STBY RUD and ON. Normal is ON with guards closed."
    },
    {
      "id": "spoilsw",
      "name": "Spoiler switches",
      "zone": "fctl",
      "location": "Flight control panel, next to the flight control switches. Two guarded switches.",
      "function": "Controls hydraulic power to the flight spoilers. Normal is ON with guards closed."
    },
    {
      "id": "yawd",
      "name": "Yaw damper switch",
      "zone": "fctl",
      "location": "Bottom of the flight control panel, with an amber YAW DAMPER light above it.",
      "function": "Damps Dutch roll. Engages only with the B FLT CONTROL switch ON. The amber YAW DAMPER light shows it is not engaged."
    },
    {
      "id": "stbyhyd",
      "name": "Standby hydraulic lights",
      "zone": "fctl",
      "location": "Flight control panel, under the flight control switches.",
      "function": "LOW QUANTITY, LOW PRESSURE and STBY RUD ON lights. All should be off."
    },
    {
      "id": "fctllts",
      "name": "Flight control warning lights",
      "zone": "fctl",
      "location": "Right side of the flight control panel. A stack of amber lights.",
      "function": "FEEL DIFF PRESS, SPEED TRIM FAIL, MACH TRIM FAIL, AUTO SLAT FAIL and the MAX-only SPOILERS light."
    },
    {
      "id": "navsw",
      "name": "Navigation transfer switches",
      "zone": "nav",
      "location": "Below the flight control panel. VHF NAV, IRS and FMC switches.",
      "function": "Lets one side use the other side's navigation source. Normal is NORMAL on all three."
    },
    {
      "id": "dispsw",
      "name": "Display source switches",
      "zone": "nav",
      "location": "Next to the navigation switches. SOURCE and CONTROL PANEL.",
      "function": "SOURCE goes to AUTO, CONTROL PANEL to NORMAL."
    },
    {
      "id": "xfeed",
      "name": "Crossfeed selector",
      "zone": "fuel",
      "location": "Center of the fuel panel, with a VALVE OPEN light.",
      "function": "Connects the left and right fuel manifolds. Closed for normal flight."
    },
    {
      "id": "fuellts",
      "name": "Fuel valve and filter lights",
      "zone": "fuel",
      "location": "Top of the fuel panel, one set for each engine: ENG VALVE CLOSED, SPAR VALVE CLOSED and FILTER BYPASS.",
      "function": "The valve lights show each engine's fuel valve and spar valve closed, bright while a valve moves. FILTER BYPASS shows a clogging fuel filter."
    },
    {
      "id": "fuelpumps",
      "name": "Fuel pump switches",
      "zone": "fuel",
      "location": "Fuel panel, left side of the forward overhead, below the navigation switches. Six switches: L and R forward and aft, plus two center tank switches.",
      "function": "Each tank has pumps feeding the engines. Low pressure lights sit beside each switch."
    },
    {
      "id": "cabutil",
      "name": "CAB/UTIL and IFE/PASS SEAT switches",
      "zone": "elecu",
      "location": "Top of the electrical panel, close to the battery switch.",
      "function": "Power to galleys, cabin utility and seat equipment."
    },
    {
      "id": "eleclts",
      "name": "Electrical warning lights",
      "zone": "elecu",
      "location": "Electrical panel. BAT DISCHARGE, TR UNIT and ELEC.",
      "function": "Amber fault lights. All should be off."
    },
    {
      "id": "gendrive",
      "name": "Generator drive disconnects",
      "zone": "elecl",
      "location": "Electrical panel, under red guards. An amber DRIVE light sits above each switch.",
      "function": "Disconnects a failed generator drive. It cannot be reconnected in flight, so leave the guards closed. The DRIVE light shows low oil pressure in the drive, so it is on whenever that engine is stopped."
    },
    {
      "id": "genbus",
      "name": "GEN OFF BUS lights (engine and APU)",
      "zone": "elecl",
      "location": "Electrical panel, by the generator switches.",
      "function": "Blue lights. An engine GEN OFF BUS light means that generator is not powering its bus. APU GEN OFF BUS means the APU is running and ready, but not powering the buses."
    },
    {
      "id": "lavsmoke",
      "name": "Lavatory smoke light",
      "zone": "cool",
      "location": "Forward overhead, amber light.",
      "function": "Amber warning that a smoke detector in a lavatory has gone off. It should be out on the ground."
    },
    {
      "id": "equip",
      "name": "Equipment cooling switches",
      "zone": "cool",
      "location": "Top center of the forward overhead. SUPPLY and EXHAUST.",
      "function": "Cooling fans for the avionics. NORM with OFF lights out."
    },
    {
      "id": "emerext",
      "name": "Emergency exit lights switch",
      "zone": "cool",
      "location": "Forward overhead, guarded. OFF, ARMED and ON.",
      "function": "Guard down holds it in ARMED so the lights come on with a power loss."
    },
    {
      "id": "signs",
      "name": "Passenger signs",
      "zone": "cool",
      "location": "Forward overhead, near the emergency exit lights switch. NO SMOKING and FASTEN BELTS selectors.",
      "function": "NO SMOKING and FASTEN BELTS each have OFF, AUTO and ON. AUTO switches the sign with gear or flap position and cabin altitude. FASTEN BELTS ON tells the cabin to sit down."
    },
    {
      "id": "wheat",
      "name": "Window heat switches",
      "zone": "heat",
      "location": "Window heat panel, forward overhead. Four switches: L SIDE, L FWD, R FWD and R SIDE.",
      "function": "Heats the flight deck windows so they resist bird strikes and stay clear of ice and fog."
    },
    {
      "id": "pheat",
      "name": "Probe heat switches",
      "zone": "heat",
      "location": "Beside the window heat switches.",
      "function": "Heats the pitot tubes, AOA vanes and temperature probe. AUTO heats them while either engine runs. ON heats them at once."
    },
    {
      "id": "aice",
      "name": "Engine and wing anti-ice switches",
      "zone": "aice",
      "location": "Anti-ice panel on the forward overhead. WING plus ENG 1 and ENG 2.",
      "function": "Uses bleed air to keep ice off the wing and engine inlets."
    },
    {
      "id": "elechyd",
      "name": "Electric hydraulic pump switches",
      "zone": "hyd",
      "location": "Middle two switches of the hydraulic panel.",
      "function": "ELEC 2 feeds system A, ELEC 1 feeds system B. OFF before power up, ON before engine start, OFF at shutdown."
    },
    {
      "id": "trimair",
      "name": "Trim air switch",
      "zone": "air",
      "location": "Air conditioning panel, by the temperature selectors.",
      "function": "Adds hot air to the pack output to fine-tune each zone temperature."
    },
    {
      "id": "tempsw",
      "name": "Temperature selectors",
      "zone": "air",
      "location": "Top row of the air conditioning panel.",
      "function": "Set the temperature for the flight deck and the two cabin zones. AUTO is normal, C cooler, W warmer."
    },
    {
      "id": "recirc",
      "name": "Recirculation fan switches",
      "zone": "air",
      "location": "Air conditioning panel, above the packs.",
      "function": "Reuses cabin air to reduce pack load. Normal is AUTO."
    },
    {
      "id": "packs",
      "name": "Pack switches",
      "zone": "bleed",
      "location": "Bleed air panel. L and R.",
      "function": "OFF, AUTO and HIGH. Supplies conditioned air to the cabin. HIGH gives more flow, used with one pack or on the ground with the APU."
    },
    {
      "id": "iso",
      "name": "Isolation valve switch",
      "zone": "bleed",
      "location": "Bleed air panel, between the two pack switches.",
      "function": "CLOSE, AUTO and OPEN. AUTO closes the valve when both engine bleeds and both packs are on, and opens it if any of them is off."
    },
    {
      "id": "apubleed",
      "name": "APU bleed switch",
      "zone": "bleed",
      "location": "Bleed air panel, between the engine bleed switches.",
      "function": "Feeds APU air into the bleed ducts for engine start and the packs on the ground. Works only with the APU running."
    },
    {
      "id": "packlts",
      "name": "Pack warning lights",
      "zone": "bleed",
      "location": "Bleed air panel, by the pack switches.",
      "function": "Amber PACK lights. They go out when the packs run correctly."
    },
    {
      "id": "engbleed",
      "name": "Engine bleed switches",
      "zone": "bleed",
      "location": "Bleed air panel, ENG 1 and ENG 2.",
      "function": "Takes engine bleed air into the pneumatic system."
    },
    {
      "id": "press",
      "name": "Cabin pressure panel",
      "zone": "press",
      "location": "Right side of the forward overhead. FLT ALT and LAND ALT windows, with the mode selector below.",
      "function": "Set cruise and landing altitude. The mode selector has AUTO, ALTN and MAN positions."
    },
    {
      "id": "lldg",
      "name": "Taxi light switch",
      "zone": "ltl",
      "location": "Bottom row of the forward overhead, right of the runway turnoff switches.",
      "function": "OFF and ON. Lights the taxiway ahead of the nose gear."
    },
    {
      "id": "starts",
      "name": "Engine start switches and ignition selector",
      "zone": "start",
      "location": "Bottom row of the forward overhead, center. The ignition selector sits between the two start switches.",
      "function": "GRD, OFF, CONT and FLT for each engine. The ignition selector chooses IGN L, BOTH or IGN R."
    },
    {
      "id": "logo",
      "name": "Logo light switch",
      "zone": "lte",
      "location": "Exterior light row, bottom right of the forward overhead.",
      "function": "Lights the airline logo on the tail so the airplane can be seen at night."
    },
    {
      "id": "poslt",
      "name": "Position light switch",
      "zone": "lte",
      "location": "Exterior light row.",
      "function": "STROBE & STEADY for takeoff and flight, STEADY on the ground while parked or taxiing, or OFF."
    },
    {
      "id": "beacon",
      "name": "Anti-collision light switch",
      "zone": "lte",
      "location": "Exterior light row.",
      "function": "Red beacon. On before engine start or any movement."
    },
    {
      "id": "wingww",
      "name": "Wing and wheel well light switches",
      "zone": "lte",
      "location": "Exterior light row, right side.",
      "function": "WING lights the wing leading edge, for ice checks at night. WHEEL WELL lights the gear bays for ground crew."
    },
    {
      "id": "fd",
      "name": "Flight director switches",
      "zone": "mcp",
      "location": "Each end of the MCP. One F/D switch per pilot.",
      "function": "Shows flight director guidance on the PFD. The first switch on becomes master, shown by the MA light."
    },
    {
      "id": "hdgsel",
      "name": "Heading selector and bank angle selector",
      "zone": "mcp",
      "location": "Center of the MCP. The bank angle selector is the outer ring around the heading knob.",
      "function": "Limits bank in HDG SEL and VOR modes. Set it to 25 degrees, one notch left of 30."
    },
    {
      "id": "apdis",
      "name": "Autopilot disengage bar",
      "zone": "mcp",
      "location": "Right side of the MCP, below the CMD A and CMD B buttons.",
      "function": "Pull down to disconnect the autopilot. Normal is UP."
    },
    {
      "id": "efispanel",
      "name": "EFIS control panels",
      "zone": "efis",
      "location": "Glareshield, one panel at each end.",
      "function": "Sets baro, minimums, range and ND options such as WXR and TERR. Weather radar is not simulated in the iFly."
    },
    {
      "id": "ltest",
      "name": "Lights test switches",
      "zone": "p1",
      "location": "Main panel, left of the standby display. The LIGHTS switch has TEST, BRT and DIM. The A/P and A/T TEST switch is further left, with positions 1 and 2.",
      "function": "Tests annunciators. Master LIGHTS test also covers most warning lights."
    },
    {
      "id": "stabout",
      "name": "STAB OUT OF TRIM light",
      "zone": "p1",
      "location": "Captain panel (P1), main panel left of the standby display, next to the SPEED BRAKE lights.",
      "function": "Amber light for autopilot trim problems. Should be off."
    },
    {
      "id": "fltinst",
      "name": "Primary flight and navigation displays",
      "zone": "du",
      "location": "Outboard and inboard display units (DUs), one pair for each pilot.",
      "function": "The MAX Display System uses four large display units. Check the primary flight display (PFD) and navigation display (ND) for correct indications."
    },
    {
      "id": "gpwssw",
      "name": "GPWS test switch",
      "zone": "gpws",
      "location": "Ground proximity panel on the lower strip under the first officer's displays.",
      "function": "Tests the ground proximity warnings."
    },
    {
      "id": "isfdc",
      "name": "Integrated standby flight display",
      "zone": "isfd",
      "location": "Center panel (P2).",
      "function": "Standby attitude, speed and altitude. Set the BARO here."
    },
    {
      "id": "fuelflow",
      "name": "Fuel flow switch",
      "zone": "edcp",
      "location": "Engine display control panel, top left.",
      "function": "Spring-loaded switch. RATE is normal, USED shows fuel used, RESET zeros the fuel used counter. It springs back to RATE."
    },
    {
      "id": "abrake",
      "name": "Autobrake selector",
      "zone": "edcp",
      "location": "Forward electronic panel, between the two CDUs, next to the FUEL FLOW switch.",
      "function": "RTO for takeoff. OFF, 1, 2, 3 or MAX for landing."
    },
    {
      "id": "cr",
      "name": "C/R switch",
      "zone": "edcp",
      "location": "Engine display controls on the pedestal.",
      "function": "Cancel/recall for engine alerts. Used here to check for autoland fault messages."
    },
    {
      "id": "sel",
      "name": "Display selectors (L/C/R)",
      "zone": "edcp",
      "location": "Engine display control panel, adjacent to the right CDU. One selector for each pilot.",
      "function": "Each outer selector has L, C and R. C places the cursor on the inboard half of the inboard display. L and R are for maintenance formats."
    },
    {
      "id": "speedbrake",
      "name": "Speedbrake lever",
      "zone": "sb",
      "location": "Left side of the control stand.",
      "function": "Positions include DOWN, ARMED, FLIGHT and UP. ARMED deploys spoilers on landing."
    },
    {
      "id": "thrust",
      "name": "Thrust and reverse levers",
      "zone": "thr",
      "location": "Center of the control stand.",
      "function": "The forward levers set thrust. The smaller reverse levers on top lift to deploy reverse thrust after landing."
    },
    {
      "id": "flaplever",
      "name": "Flap lever and indication",
      "zone": "flap",
      "location": "Right side of the control stand. The MAX shows flap position on the inboard display unit.",
      "function": "Sets the flaps: UP, 1, 2, 5, 10, 15, 25, 30, 40. Flap position shows on the inboard display with the engine indications."
    },
    {
      "id": "slever",
      "name": "Engine start levers",
      "zone": "sl",
      "location": "Control stand, aft of the thrust levers.",
      "function": "CUTOFF and IDLE. IDLE opens the fuel valves and fires the selected igniter during start."
    },
    {
      "id": "stabcut",
      "name": "Stabilizer trim cutout switches",
      "zone": "stab",
      "location": "Aft end of the control stand, right side. Guarded.",
      "function": "PRI and B/U on the MAX. They are wired in series and do the same job: CUTOUT on either one stops stabilizer trim motor inputs, including MCAS. Normal is NORMAL with guards closed."
    },
    {
      "id": "staboverride",
      "name": "Stabilizer trim override switch",
      "zone": "stabo",
      "location": "Aft electronic panel, right side at the back, next to the flight deck door panel. Guarded.",
      "function": "Bypasses the control column cutout switches. Normal is NORM with the guard closed."
    },
    {
      "id": "cargofire",
      "name": "Cargo fire panel",
      "zone": "cargo",
      "location": "Aft electronic panel on the pedestal.",
      "function": "Test detectors and extinguisher readiness."
    },
    {
      "id": "radios",
      "name": "Radio tuning panels",
      "zone": "radio",
      "location": "Aft electronic panel on the pedestal, one panel beside each pilot.",
      "function": "Sets the active and standby VHF frequencies. The transfer switch swaps them."
    },
    {
      "id": "mmr",
      "name": "Multi-mode receiver panel",
      "zone": "navr",
      "location": "Navigation control panel on the aft pedestal.",
      "function": "Tunes ILS frequency and course for the runway."
    },
    {
      "id": "adf",
      "name": "ADF selector panel",
      "zone": "adfp",
      "location": "Aft electronic panel, center, below the transponder.",
      "function": "Tunes the two ADF receivers, which point the bearing needles at a ground beacon. Most modern procedures do not need them."
    },
    {
      "id": "wxrp",
      "name": "Weather radar panel",
      "zone": "wxr",
      "location": "Aft electronic panel on the pedestal.",
      "function": "Sets the mode and tilt of the weather radar. Not simulated in the iFly, so leave it in its normal position."
    },
    {
      "id": "xpndr",
      "name": "Transponder panel",
      "zone": "xpdr",
      "location": "ATC/TCAS panel on the aft pedestal.",
      "function": "The mode selector has ALT OFF, XPNDR, TA ONLY and TA/RA. Separate XPNDR and ALT SOURCE controls choose STBY or AUTO, and source 1 or 2."
    },
    {
      "id": "n1",
      "name": "N1 bugs",
      "zone": "du",
      "location": "Engine indications on the inboard display unit.",
      "function": "Green references for the takeoff thrust target. Compare with the CDU."
    },
    {
      "id": "mcpset",
      "name": "MCP speed, heading, altitude and modes",
      "zone": "mcp",
      "location": "Mode control panel, center of the glareshield.",
      "function": "Set V2, runway heading and initial altitude, then arm the autothrottle and the departure mode."
    },
    {
      "id": "doorsp",
      "name": "Exterior doors panel",
      "zone": "door",
      "location": "Door warning panel on the forward overhead.",
      "function": "One light for each door. All lights should be out before push."
    },
    {
      "id": "stabind",
      "name": "Stabilizer trim indicator",
      "zone": "stab",
      "location": "Control stand, beside the trim wheel.",
      "function": "Green band and pointer in units. Must match takeoff data."
    },
    {
      "id": "fdd",
      "name": "Flight deck door",
      "zone": "dkdoor",
      "location": "Door at the back of the flight deck. Its FLT DK DOOR selector is on the aft electronic panel, bottom right.",
      "function": "The reinforced door between the cabin and the flight deck. Close it before departure. The FLT DK DOOR selector (UNLKD, AUTO, DENY) stays in AUTO, its default, which keeps the door locked."
    },
    {
      "id": "fuelq",
      "name": "Fuel quantity",
      "zone": "du",
      "location": "Fuel indications on the display units, compared with the CDU.",
      "function": "Compare minimum takeoff fuel with departing fuel."
    },
    {
      "id": "windows",
      "name": "Flight deck windows",
      "zone": "side",
      "location": "Sliding windows beside each pilot.",
      "function": "Close and lock them before departure."
    },
    {
      "id": "trimp",
      "name": "Rudder and aileron trim",
      "zone": "trim",
      "location": "Trim panel, aft end of the pedestal.",
      "function": "Aileron and rudder trim. Both at zero for takeoff."
    },
    {
      "id": "brief",
      "name": "Taxi and takeoff briefing",
      "location": "Not a switch. The briefing is on this page.",
      "function": "A short review between pilots of the taxi route, the departure and what to do if something goes wrong."
    },
    {
      "id": "engen",
      "name": "Engine generator switches",
      "zone": "elecl",
      "location": "Electrical panel, left and right of the APU generator switches.",
      "function": "Puts engine generator power on the buses."
    },
    {
      "id": "sysp",
      "name": "SYS switch",
      "zone": "edcp",
      "location": "Engine display control panel.",
      "function": "Shows system information on the inboard display."
    },
    {
      "id": "fltcon",
      "name": "Flight controls",
      "zone": "yoke",
      "location": "Yoke, column and rudder pedals, while watching the flight control indication on the display.",
      "function": "Check full, free movement in all directions."
    },
    {
      "id": "recall",
      "name": "System annunciator panels (recall)",
      "zone": "ann",
      "location": "Glareshield, left and right of the MCP.",
      "function": "Pressing an annunciator panel shows any stored system alerts, so you can confirm nothing is waiting for you."
    },
    {
      "id": "grnd",
      "name": "Ground equipment",
      "zone": "out",
      "location": "Outside. Ground crew shows the bypass pin.",
      "function": "Confirm the bypass pin is shown and equipment is clear."
    },
    {
      "id": "oil",
      "name": "Engine oil temperature",
      "zone": "du",
      "location": "Secondary engine indications on the display units. Press ENG on the engine display control panel to show them.",
      "function": "Must be above 31C before takeoff."
    },
    {
      "id": "gearup",
      "name": "Landing gear lever",
      "zone": "gear",
      "location": "Center panel (P2). The lever with the wheel-shaped knob.",
      "function": "Raises the gear. Pull the lever out and move it UP. The red and green gear lights go out when the gear is up and locked."
    },
    {
      "id": "speedt",
      "name": "Speed tape",
      "zone": "du",
      "location": "Primary flight display.",
      "function": "The airspeed scale on the left of the PFD. It shows V speeds, flap retraction marks and limit speeds."
    },
    {
      "id": "sblts",
      "name": "FASTEN BELTS selector",
      "zone": "cool",
      "location": "Forward overhead, FASTEN BELTS selector.",
      "function": "Controls the FASTEN BELTS sign in the cabin. ON tells passengers to sit down with belts fastened."
    },
    {
      "id": "baro",
      "name": "Baro setting",
      "zone": "efis",
      "location": "BARO control on each EFIS panel. Inner knob sets the value, outer ring selects IN or HPA, center button is STD.",
      "function": "Sets the air pressure the altimeters read from. Use local QNH down low, and STD above the transition altitude."
    },
    {
      "id": "ldgalt",
      "name": "Landing altitude window",
      "zone": "press",
      "location": "Cabin pressure panel, LAND ALT.",
      "function": "Set the airport elevation. It should match the destination."
    },
    {
      "id": "vref",
      "name": "Landing data on the CDU",
      "zone": "cdu",
      "location": "CDU APPROACH REF page.",
      "function": "VREF is the target landing reference speed for the flap setting and weight. Select it here so it shows on the speed tape."
    },
    {
      "id": "mins",
      "name": "Minimums selector",
      "zone": "efis",
      "location": "MINS control on each EFIS panel. Outer ring selects RADIO or BARO, inner knob sets the value, center button is RST.",
      "function": "Choose baro or radio, then set the chart value."
    },
    {
      "id": "crs",
      "name": "Course selector",
      "zone": "mcp",
      "location": "Course knobs at each end of the MCP.",
      "function": "Sets the final approach course shown on the ND, so the localizer is compared with the course you expect."
    },
    {
      "id": "clear",
      "name": "Landing clearance",
      "zone": "radio",
      "location": "By radio with air traffic control.",
      "function": "Tower permission to land. Do not land without it."
    },
    {
      "id": "chocks",
      "name": "Chocks and cones",
      "zone": "out",
      "location": "Outside, set by the ground crew or through the EFB in the sim.",
      "function": "Blocks placed against the tires so the airplane stays put when the parking brake is released."
    },
    {
      "id": "apub",
      "name": "APU or ground power",
      "zone": "elecl",
      "location": "Electrical panel, generator switches.",
      "function": "Switch off the power source for the airplane before the battery goes off."
    },
    {
      "id": "oxym",
      "name": "Oxygen masks",
      "zone": "side",
      "location": "Stowed at the outboard side of each pilot seat.",
      "function": "Each pilot has a quick-donning mask. Test it, and leave the regulator on 100% ready for use."
    },
    {
      "id": "briefa",
      "name": "Approach briefing",
      "location": "Not a switch. The briefing is on this page.",
      "function": "A short review of the approach chart, minimums, the missed approach and the plan after landing."
    },
    {
      "id": "pushsim",
      "name": "Pushback controls",
      "zone": "efb",
      "location": "Your pushback tool or the EFB.",
      "function": "Starts and steers the tug. It is a sim step, so there is no switch for it on the real panel."
    },
    {
      "id": "atcclr",
      "name": "ATC clearance",
      "zone": "radio",
      "location": "By radio with air traffic control.",
      "function": "Request the clearance and read it back."
    },
    {
      "id": "engmon",
      "name": "Engine indications",
      "zone": "du",
      "location": "Engine indications on the inboard display unit. Press ENG on the engine display control panel for the secondary indications.",
      "function": "Shows N1, N2, EGT, fuel flow and oil pressure. During engine start, abort if EGT does not rise, N1 or N2 does not rise after EGT rises, EGT nears the start limit, or there is no oil pressure by the time the engine is stable."
    },
    {
      "id": "motor",
      "name": "MOTORING indication",
      "zone": "du",
      "location": "Next to N2 in the engine indications on the inboard display unit.",
      "function": "Shows while the engine is being motored by the starter. Keep the start lever in CUTOFF until this clears. It shows over the N2 readout, typically at about 18 to 24% N2."
    },
    {
      "id": "toga",
      "name": "TO/GA switches",
      "zone": "thr",
      "location": "On the thrust lever handles themselves: a button on the front of each handle, under your fingers as you hold the levers. Not a separate panel.",
      "function": "Engages takeoff or go-around thrust and guidance."
    },
    {
      "id": "rollmode",
      "name": "MCP roll modes",
      "zone": "mcp",
      "location": "LNAV and HDG SEL buttons on the MCP.",
      "function": "Sets lateral guidance after takeoff or a go-around."
    },
    {
      "id": "ap",
      "name": "Autopilot engage (CMD)",
      "zone": "mcp",
      "location": "CMD A and CMD B buttons on the right side of the MCP.",
      "function": "Engages autopilot A or B to fly the modes shown on the top of the PFD. Check the FMA after you press it."
    },
    {
      "id": "fma",
      "name": "Flight mode annunciations",
      "zone": "du",
      "location": "Top of each PFD.",
      "function": "The three boxes at the top of each PFD show what the autothrottle, roll and pitch modes are doing now. Always read them after you change a mode."
    },
    {
      "id": "mcpalt",
      "name": "MCP altitude selector",
      "zone": "mcp",
      "location": "Altitude window and knob on the MCP.",
      "function": "Sets the cleared or missed approach altitude."
    },
    {
      "id": "fmc",
      "name": "CDU descent and arrival data",
      "zone": "cdu",
      "location": "CDU legs, descent forecast and arrival pages.",
      "function": "Enter the arrival, approach and descent winds."
    },
    {
      "id": "brefp",
      "name": "Approach preparation",
      "location": "Not a switch. The briefing is on this page.",
      "function": "Gather what you need for the arrival: weather from ATIS, the landing runway, the approach chart and any notices."
    },
    {
      "id": "pfdhdg",
      "name": "Heading and runway display",
      "zone": "du",
      "location": "Heading on the PFD and ND.",
      "function": "Confirm your heading agrees with the runway."
    },
    {
      "id": "nws",
      "name": "Nose wheel steering switch",
      "zone": "gear",
      "location": "On the landing gear panel on the MAX. On the NG it is on the left forward panel.",
      "function": "Guarded. NORM steers with hydraulic system A, ALT with system B. Leave at NORM."
    },
    {
      "id": "dsel",
      "name": "PFD/MFD selectors",
      "zone": "dselp",
      "location": "Lower strip under each pilot's displays. Selectors for the outboard and inboard display units.",
      "function": "NORM shows the PFD and MFD in their usual places. OUTBD and INBD move them if a display fails."
    },
    {
      "id": "audio",
      "name": "Audio control panels",
      "zone": "acp",
      "location": "Aft electronic panel, one audio control panel on each side, below the NAV radios.",
      "function": "Selects which radios and navigation audio you hear."
    },
    {
      "id": "extins",
      "name": "Exterior inspection",
      "zone": "out",
      "location": "Walk around the airplane. Use the EFB or external views in the sim.",
      "function": "Check condition, security and that nothing is blocked."
    },
    {
      "id": "firesw",
      "name": "Engine fire switches",
      "zone": "fire",
      "location": "Overheat/fire protection panel on the aft pedestal.",
      "function": "Pull to arm and shut off the engine. Rotate to discharge a bottle. Press the override to unlock a switch if needed."
    },
    {
      "id": "apufire",
      "name": "APU fire switch",
      "zone": "fire",
      "location": "Between the engine fire switches on the fire panel.",
      "function": "Pull and rotate to shut down the APU and discharge its bottle."
    },
    {
      "id": "column",
      "name": "Control column",
      "zone": "yoke",
      "location": "In front of each pilot. The main electric trim switches are on the control wheel.",
      "function": "Hold the column firmly, and use main electric trim to reduce forces."
    },
    {
      "id": "stabtrim",
      "name": "Main electric stabilizer trim switches",
      "zone": "yoke",
      "location": "On the outboard grip of each control wheel: two thumb switches, moved together.",
      "function": "Trims the stabilizer nose down or nose up while held."
    },
    {
      "id": "stabwheel",
      "name": "Stabilizer trim wheel",
      "zone": "stab",
      "location": "Control stand, each side.",
      "function": "Grasp and hold to stop a runaway. Use the handle to trim manually."
    },
    {
      "id": "outflow",
      "name": "Outflow valve switch",
      "zone": "press",
      "location": "Cabin pressure panel.",
      "function": "Used in MAN mode. Hold CLOSE until the valve shows closed."
    },
    {
      "id": "mask",
      "name": "Oxygen masks",
      "zone": "side",
      "location": "Stowed at the outboard side of each pilot seat.",
      "function": "Don the mask and set the regulator to 100%."
    },
    {
      "id": "stalltest",
      "name": "Stall warning test switches",
      "zone": "atest",
      "location": "Aft overhead, below the Mach airspeed warning test: two small round buttons, NO. 1 and NO. 2.",
      "function": "Tests the stick shaker on each side."
    },
    {
      "id": "bustrans",
      "name": "Bus transfer switch",
      "zone": "elecl",
      "location": "Electrical panel, lower section, between the two sets of generator lights. Guarded.",
      "function": "OFF and AUTO. Leave it in AUTO with the guard closed so the transfer buses can switch power source automatically."
    },
    {
      "id": "vrec",
      "name": "Voice recorder switch",
      "zone": "vrecz",
      "location": "Top right of the forward overhead, above the air temperature panel.",
      "function": "AUTO and ON. AUTO records without crew action. ON forces recording."
    },
    {
      "id": "hal",
      "name": "High altitude landing switch",
      "zone": "press",
      "location": "Not fitted in the iFly MAX 8. On airplanes that have it, it sits below ALT HORN CUTOUT.",
      "function": "Changes the cabin pressure settings for an airport above 10,000 ft. Not simulated in the iFly."
    },
    {
      "id": "landlt",
      "name": "Landing light switches",
      "zone": "ltl",
      "location": "Bottom row of the forward overhead, left side. LANDING L and R.",
      "function": "OFF, FLASH and ON. On for takeoff and landing, off above 10,000 ft."
    },
    {
      "id": "turnoff",
      "name": "Runway turnoff light switches",
      "zone": "ltl",
      "location": "Bottom row of the forward overhead, right of the landing light switches. TURNOFF L and R.",
      "function": "OFF and ON. Light the ground to each side of the nose for turns."
    },
    {
      "id": "winglt",
      "name": "Wing light switch",
      "zone": "lte",
      "location": "Exterior light row, right side, next to WHEEL WELL.",
      "function": "OFF and ON. Lights the wing leading edge, for ice checks at night."
    },
    {
      "id": "apdisc",
      "name": "Autopilot and autothrottle disconnect switches",
      "zone": "yoke",
      "location": "Autopilot: a button on the outer horn of each control wheel. Autothrottle: a button on the outer end of each thrust lever handle, where the A/T DISENGAGE arrows point.",
      "function": "Disengages the autopilot or the autothrottle. A warning sounds or flashes; press the same switch again to silence it."
    },
    {
      "id": "appmode",
      "name": "Approach mode (APP)",
      "zone": "mcp",
      "location": "APP button on the MCP, below VOR LOC.",
      "function": "Arms the localizer and glideslope for an ILS. VOR/LOC and G/S show white on the FMA when armed, then green when each one captures."
    },
    {
      "id": "cvrpanel",
      "name": "Cockpit voice recorder panel",
      "zone": "cvr",
      "location": "Forward overhead, below the doors lights and above the cabin pressure gauges.",
      "function": "STATUS light, ERASE and TEST buttons and a HEADPHONE jack for the cockpit voice recorder. The VOICE RECORDER switch itself is at the top right of the forward overhead."
    },
    {
      "id": "pitchmode",
      "name": "MCP pitch modes",
      "zone": "mcp",
      "location": "LVL CHG and VNAV buttons on the MCP, left of the heading knob.",
      "function": "Sets vertical guidance: LVL CHG climbs or descends at the MCP speed, VNAV follows the FMC path."
    },
    {
      "id": "exttest",
      "name": "Extinguisher test switch",
      "zone": "fire",
      "location": "Overheat/fire protection panel on the aft pedestal, right of the APU fire switch.",
      "function": "Tests the squib circuits of the engine and APU fire bottles. Spring-loaded to the center; hold at 1, then at 2."
    },
    {
      "id": "panellts",
      "name": "Panel and flood light controls",
      "zone": "dselp",
      "location": "Main panel lower strip on each side: MAIN PANEL, BACKGROUND and AFDS FLOOD knobs. Also the PANEL and CIRCUIT BREAKER knobs on the forward overhead, FLOOD and PANEL on the aft pedestal, and the DOME WHITE switch on the aft overhead.",
      "function": "Sets the brightness of the panel backlighting and flood lights. Turn up for a night or dim flight deck, down in daylight."
    },
    {
      "id": "pa",
      "name": "Passenger address (PA)",
      "zone": "acp",
      "location": "Audio control panel: select PA, then use the push-to-talk switch or the handset.",
      "function": "Talks to the cabin over the speakers."
    },
    {
      "id": "mlog",
      "name": "Maintenance log",
      "zone": "out",
      "location": "Not a switch. The logbook is aboard the airplane; in the sim there is nothing to find.",
      "function": "A paperwork check: confirm nothing open stops the flight."
    }
  ],
