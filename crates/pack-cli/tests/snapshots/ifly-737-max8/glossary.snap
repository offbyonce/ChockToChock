---
source: crates/pack-cli/tests/snapshot.rs
---
{
  "terms": [
    {
      "term": "ADF",
      "meaning": "Automatic direction finder. Points a needle at an NDB ground station."
    },
    {
      "term": "AOA",
      "meaning": "Angle of attack. The angle between the wing and the oncoming air."
    },
    {
      "term": "APU",
      "meaning": "Auxiliary power unit. A small turbine in the tail that supplies electrical power and bleed air."
    },
    {
      "term": "A/P",
      "meaning": "Autopilot."
    },
    {
      "term": "A/T",
      "meaning": "Autothrottle. It moves the thrust levers automatically."
    },
    {
      "term": "ATC",
      "meaning": "Air traffic control."
    },
    {
      "term": "ATIS",
      "meaning": "Automatic Terminal Information Service. A recorded airport weather and information broadcast."
    },
    {
      "term": "BARO",
      "meaning": "Barometric altimeter setting, or barometric minimums."
    },
    {
      "term": "CDL",
      "meaning": "Configuration deviation list. Parts that may be missing for flight."
    },
    {
      "term": "CDU",
      "meaning": "Control display unit. The keypad and screen used to program the flight management computer."
    },
    {
      "term": "CG",
      "meaning": "Center of gravity."
    },
    {
      "term": "CONT",
      "meaning": "Continuous ignition. The selected igniters fire while the engine runs."
    },
    {
      "term": "DU",
      "meaning": "Display unit. One of the large screens on the main panel."
    },
    {
      "term": "EEC",
      "meaning": "Electronic engine control. The computer that manages each engine."
    },
    {
      "term": "EFB",
      "meaning": "Electronic flight bag. The tablet used for charts and performance."
    },
    {
      "term": "EFIS",
      "meaning": "Electronic flight instrument system. The glareshield panels set altimeter, minimums and navigation display options."
    },
    {
      "term": "EGT",
      "meaning": "Exhaust gas temperature. A key engine limit."
    },
    {
      "term": "ELT",
      "meaning": "Emergency locator transmitter."
    },
    {
      "term": "F/D",
      "meaning": "Flight director. Guidance cues shown on the primary flight display."
    },
    {
      "term": "FCOM",
      "meaning": "Flight Crew Operations Manual."
    },
    {
      "term": "FLT ALT",
      "meaning": "Flight altitude. The cruise altitude set on the pressurization panel."
    },
    {
      "term": "FMA",
      "meaning": "Flight mode annunciator. The top of the primary flight display, showing active modes."
    },
    {
      "term": "FMC",
      "meaning": "Flight management computer."
    },
    {
      "term": "FO",
      "meaning": "First officer.",
      "step_term": false
    },
    {
      "term": "GLS",
      "meaning": "GBAS landing system. A satellite-based precision approach."
    },
    {
      "term": "GPS",
      "meaning": "Global Positioning System."
    },
    {
      "term": "GPWS",
      "meaning": "Ground proximity warning system."
    },
    {
      "term": "GRD",
      "meaning": "Ground. The engine start switch position that opens the start valve."
    },
    {
      "term": "HDG SEL",
      "meaning": "Heading select. An autopilot mode that follows the MCP heading."
    },
    {
      "term": "IFE",
      "meaning": "In-flight entertainment."
    },
    {
      "term": "ILS",
      "meaning": "Instrument landing system."
    },
    {
      "term": "IRS",
      "meaning": "Inertial reference system. It provides position, heading and attitude."
    },
    {
      "term": "LAND ALT",
      "meaning": "Landing altitude. The destination elevation set on the pressurization panel."
    },
    {
      "term": "LNAV",
      "meaning": "Lateral navigation. Follows the FMC route."
    },
    {
      "term": "MAINT",
      "meaning": "Maintenance."
    },
    {
      "term": "MCAS",
      "meaning": "Maneuvering Characteristics Augmentation System. Flight control software that adds nose-down trim at high angle of attack, in manual flight with flaps up."
    },
    {
      "term": "MCP",
      "meaning": "Mode control panel. The autopilot panel on the glareshield."
    },
    {
      "term": "MEL",
      "meaning": "Minimum equipment list. Items that may be inoperative for flight."
    },
    {
      "term": "MMO",
      "meaning": "Maximum operating Mach number."
    },
    {
      "term": "MMR",
      "meaning": "Multi-mode receiver. Receives ILS, GLS and GPS."
    },
    {
      "term": "N1",
      "meaning": "Fan speed, shown as a percentage. The main thrust indication."
    },
    {
      "term": "N2",
      "meaning": "Core speed, shown as a percentage."
    },
    {
      "term": "ND",
      "meaning": "Navigation display."
    },
    {
      "term": "NOTAMS",
      "meaning": "Notices to Airmen. Current hazards and changes."
    },
    {
      "term": "PA",
      "meaning": "Passenger address system."
    },
    {
      "term": "PDC",
      "meaning": "Pre-departure clearance."
    },
    {
      "term": "PFD",
      "meaning": "Primary flight display."
    },
    {
      "term": "PWB",
      "meaning": "Performance and weight and balance data. The takeoff data sheet: weights, trim, flaps and speeds."
    },
    {
      "term": "QNH",
      "meaning": "Altimeter setting that makes the altimeter show height above sea level."
    },
    {
      "term": "QRH",
      "meaning": "Quick Reference Handbook."
    },
    {
      "term": "RA",
      "meaning": "Resolution advisory. A TCAS command to climb, descend or hold vertical speed."
    },
    {
      "term": "RNAV",
      "meaning": "Area navigation. Flying a path of waypoints, not tied to ground stations."
    },
    {
      "term": "RNP",
      "meaning": "Required navigation performance. RNAV with on-board accuracy monitoring and alerts."
    },
    {
      "term": "RTO",
      "meaning": "Rejected takeoff."
    },
    {
      "term": "STS",
      "meaning": "Speed trim system. Adds stabilizer trim for speed stability. On the MAX it includes MCAS."
    },
    {
      "term": "TA",
      "meaning": "Traffic advisory. A TCAS alert to look for traffic."
    },
    {
      "term": "TCAS",
      "meaning": "Traffic alert and collision avoidance system."
    },
    {
      "term": "TO/GA",
      "meaning": "Takeoff/go-around. Switches on the thrust levers."
    },
    {
      "term": "V1",
      "meaning": "Takeoff decision speed. The latest speed to start a rejected takeoff. After it, continue."
    },
    {
      "term": "V2",
      "meaning": "Takeoff safety speed. The minimum climb speed with one engine failed."
    },
    {
      "term": "VMO",
      "meaning": "Maximum operating airspeed."
    },
    {
      "term": "VNAV",
      "meaning": "Vertical navigation. Follows the FMC vertical path."
    },
    {
      "term": "VR",
      "meaning": "Rotation speed."
    },
    {
      "term": "VREF",
      "meaning": "Landing reference speed for the landing flaps and weight."
    },
    {
      "term": "WXR",
      "meaning": "Weather radar."
    },
    {
      "term": "STD",
      "meaning": "Standard altimeter setting, 29.92 in or 1013 hPa, used above the transition altitude."
    },
    {
      "term": "TRANSITION ALTITUDE",
      "meaning": "The altitude where you change from QNH to STD in the climb. On descent you go back to QNH at the transition level."
    },
    {
      "term": "IMC",
      "meaning": "Instrument meteorological conditions. Flying by instruments, in cloud or poor visibility."
    },
    {
      "term": "VMC",
      "meaning": "Visual meteorological conditions. Good enough visibility to fly by looking outside."
    },
    {
      "term": "AGL",
      "meaning": "Above ground level."
    },
    {
      "term": "G/S",
      "meaning": "Glideslope. The vertical part of an ILS."
    },
    {
      "term": "LOC",
      "meaning": "Localizer. The lateral part of an ILS."
    },
    {
      "term": "VOR/LOC",
      "meaning": "The MCP mode that tracks a VOR course or a localizer. The button is labeled VOR LOC."
    },
    {
      "term": "APP",
      "meaning": "MCP approach mode. Arms the localizer and glideslope."
    },
    {
      "term": "LVL CHG",
      "meaning": "Level change. MCP mode that climbs or descends to the MCP altitude at the MCP speed."
    },
    {
      "term": "CMD",
      "meaning": "Autopilot engage buttons on the MCP, CMD A and CMD B."
    },
    {
      "term": "MA",
      "meaning": "Master light by the F/D switch. Shows which flight director is master."
    },
    {
      "term": "IAS",
      "meaning": "Indicated airspeed."
    },
    {
      "term": "KT",
      "meaning": "Knots. Nautical miles per hour.",
      "step_term": false
    },
    {
      "term": "FT",
      "meaning": "Feet.",
      "step_term": false
    },
    {
      "term": "LB",
      "meaning": "Pounds.",
      "step_term": false
    },
    {
      "term": "KG",
      "meaning": "Kilograms.",
      "step_term": false
    },
    {
      "term": "FL",
      "meaning": "Flight level. Altitude in hundreds of feet on STD."
    },
    {
      "term": "FAF",
      "meaning": "Final approach fix."
    },
    {
      "term": "PACK",
      "meaning": "Air conditioning unit that cools bleed air for the cabin."
    },
    {
      "term": "Bleed air",
      "meaning": "Hot compressed air taken from the engines or the APU."
    },
    {
      "term": "ISOLATION VALVE",
      "meaning": "Valve that joins or splits the left and right bleed ducts."
    },
    {
      "term": "DUAL BLEED",
      "meaning": "Light showing APU and engine bleed connected together."
    },
    {
      "term": "GEN",
      "meaning": "Generator."
    },
    {
      "term": "GEN OFF BUS",
      "meaning": "Blue light meaning that generator is not powering its bus."
    },
    {
      "term": "AC",
      "meaning": "Alternating current."
    },
    {
      "term": "DC",
      "meaning": "Direct current."
    },
    {
      "term": "TR",
      "meaning": "Transformer rectifier. Changes AC to DC."
    },
    {
      "term": "Transfer bus",
      "meaning": "The main AC buses. Each generator powers one."
    },
    {
      "term": "DRIVE",
      "meaning": "The generator drive light. Low oil pressure in the drive, normal before the engine runs."
    },
    {
      "term": "ALTN",
      "meaning": "Alternate mode, as on the EEC, flaps or pressurization."
    },
    {
      "term": "IGN L",
      "meaning": "Ignition selector position for the left igniter."
    },
    {
      "term": "IGN R",
      "meaning": "Ignition selector position for the right igniter."
    },
    {
      "term": "FLT",
      "meaning": "Flight. Also the engine start switch position that fires both igniters."
    },
    {
      "term": "MOTORING",
      "meaning": "MAX start display while the starter turns the engine to straighten a bowed rotor."
    },
    {
      "term": "MASTER CAUTION",
      "meaning": "Amber light that comes on with any system caution."
    },
    {
      "term": "RECALL",
      "meaning": "Shows stored cautions again, by pressing the system annunciator panel."
    },
    {
      "term": "ISFD",
      "meaning": "Integrated standby flight display."
    },
    {
      "term": "MFD",
      "meaning": "Multi-function display."
    },
    {
      "term": "SYS",
      "meaning": "System. Also the engine display control button that shows the systems page."
    },
    {
      "term": "ENG",
      "meaning": "Engine. Also the engine display control button that shows the secondary engine page."
    },
    {
      "term": "C/R",
      "meaning": "Cancel and recall button on the engine display control panel."
    },
    {
      "term": "TERR",
      "meaning": "Terrain shown on the ND."
    },
    {
      "term": "TFC",
      "meaning": "Traffic shown on the ND."
    },
    {
      "term": "XPNDR",
      "meaning": "Transponder. Sends your code and altitude to ATC."
    },
    {
      "term": "ALT OFF",
      "meaning": "Transponder mode that sends your code but not your altitude."
    },
    {
      "term": "TA ONLY",
      "meaning": "TCAS mode that gives traffic alerts but no climb or descend commands."
    },
    {
      "term": "ELEC",
      "meaning": "Electrical.",
      "step_term": false
    },
    {
      "term": "HYD",
      "meaning": "Hydraulic. The 737 has systems A, B and standby.",
      "step_term": false
    },
    {
      "term": "STAB",
      "meaning": "Stabilizer. The movable horizontal tail that trims pitch."
    },
    {
      "term": "STAB TRIM CUTOUT",
      "meaning": "Switches that stop electric stabilizer trim. PRI cuts the primary trim, B/U the backup."
    },
    {
      "term": "PRI",
      "meaning": "Primary."
    },
    {
      "term": "B/U",
      "meaning": "Backup."
    },
    {
      "term": "FCC",
      "meaning": "Flight control computer."
    },
    {
      "term": "FMS",
      "meaning": "Flight management system. The FMC and its CDUs."
    },
    {
      "term": "LEGS",
      "meaning": "CDU page that lists the route waypoints."
    },
    {
      "term": "EXEC",
      "meaning": "CDU key that makes a route change active."
    },
    {
      "term": "POS INIT",
      "meaning": "CDU page to set the IRS starting position."
    },
    {
      "term": "PERF INIT",
      "meaning": "CDU page for weights, reserves and cruise altitude."
    },
    {
      "term": "TAKEOFF REF",
      "meaning": "CDU page for takeoff flaps, trim and V speeds."
    },
    {
      "term": "Acceleration height",
      "meaning": "Height where you lower the nose to gain speed and retract flaps."
    },
    {
      "term": "TOD",
      "meaning": "Top of descent. Where the descent starts."
    },
    {
      "term": "BYPASS PIN",
      "meaning": "Ground crew pin that disables nose wheel steering for towing."
    },
    {
      "term": "SPEEDBRAKE",
      "meaning": "Lever that raises the spoilers. ARMED raises them on landing."
    },
    {
      "term": "Spoilers",
      "meaning": "Panels on top of the wing that cut lift and add drag."
    },
    {
      "term": "IGN",
      "meaning": "Ignition. IGN L and IGN R choose which igniter fires during an engine start; BOTH uses both."
    },
    {
      "term": "NAV",
      "meaning": "Navigation. On the radio panels it means the VOR/ILS receivers."
    },
    {
      "term": "MACH",
      "meaning": "Speed as a fraction of the speed of sound. Used instead of knots at high altitude."
    },
    {
      "term": "CAB/UTIL",
      "meaning": "Cabin and utility power. Powers the galleys and other cabin equipment."
    },
    {
      "term": "P1",
      "meaning": "Captain panel: the part of the main instrument panel in front of the captain."
    },
    {
      "term": "P2",
      "meaning": "Center panel: the middle of the main instrument panel, with the landing gear lever and the engine display."
    },
    {
      "term": "P3",
      "meaning": "First officer panel: the part of the main instrument panel in front of the first officer."
    },
    {
      "term": "P5",
      "meaning": "The overhead panel above both pilots, in two parts: forward, nearest the windshield, and aft."
    },
    {
      "term": "P7",
      "meaning": "Glareshield panel: the shelf under the windshield with the mode control panel and the EFIS control panels."
    },
    {
      "term": "P9",
      "meaning": "Forward electronic panel: below the center panel at the front of the control stand, with the lower display."
    },
    {
      "term": "center tank",
      "meaning": "The fuel tank in the fuselage between the wings. Its fuel is used first when it holds enough."
    },
    {
      "term": "main tank",
      "meaning": "One of the two fuel tanks inside the wings, one per side."
    },
    {
      "term": "crossfeed",
      "meaning": "A valve that joins the left and right fuel manifolds, so either side's tanks can feed either engine."
    },
    {
      "term": "autobrake",
      "meaning": "Brakes the airplane automatically after landing at a chosen rate, or at full pressure in a rejected takeoff."
    },
    {
      "term": "start lever",
      "meaning": "One lever per engine on the control stand: IDLE lets fuel in and the igniters fire; CUTOFF shuts the engine down."
    },
    {
      "term": "probe heat",
      "meaning": "Heaters that keep the airspeed and other air data probes free of ice."
    },
    {
      "term": "window heat",
      "meaning": "Heaters in the flight deck windows that prevent ice and fogging and make the glass tougher against bird strikes."
    },
    {
      "term": "outflow valve",
      "meaning": "The valve that lets cabin air out; opening and closing it sets the cabin pressure."
    },
    {
      "term": "standby power",
      "meaning": "Power for the most important instruments and radios when the normal supply fails, from the battery if need be."
    },
    {
      "term": "yaw damper",
      "meaning": "Moves the rudder automatically to damp the airplane's side-to-side swaying."
    },
    {
      "term": "trim air",
      "meaning": "Hot bleed air added to each cabin zone's supply to fine-tune its temperature."
    },
    {
      "term": "anti-ice",
      "meaning": "Hot bleed air that keeps ice off the engine inlets and the wing leading edges."
    }
  ]
}
