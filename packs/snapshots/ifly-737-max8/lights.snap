      "action": "Correct back to the glideslope, or go around if you cannot. Below 1,000 ft you can press the light to cancel the alert if you mean to be low.",
      "normal": false
    },
    {
      "locator": "mn/cl/TAKEOFF CONFIG/1",
      "meaning": "When thrust went up for takeoff, an item such as the flaps, speedbrake, stabilizer trim or parking brake was not set for takeoff.",
      "when": "Abnormal.",
      "action": "Stop the takeoff, then fix the item before you try again.",
      "normal": false
    },
    {
      "locator": "mn/fl/TAKEOFF CONFIG/1",
      "meaning": "When thrust went up for takeoff, an item such as the flaps, speedbrake, stabilizer trim or parking brake was not set for takeoff.",
      "when": "Abnormal.",
      "action": "Stop the takeoff, then fix the item before you try again.",
      "normal": false
    },
    {
      "locator": "mn/cl/CABIN ALTITUDE/1",
      "meaning": "The cabin altitude has climbed above about 10,000 ft.",
      "when": "Abnormal.",
      "action": "Put on your oxygen mask at once and do the cabin altitude memory items.",
      "normal": false
    },
    {
      "locator": "mn/fl/CABIN ALTITUDE/1",
      "meaning": "The cabin altitude has climbed above about 10,000 ft.",
      "when": "Abnormal.",
      "action": "Put on your oxygen mask at once and do the cabin altitude memory items.",
      "normal": false
    },
    {
      "locator": "mn/cl/SPEED BRAKE DO NOT ARM/1",
      "meaning": "The automatic speedbrake has a fault, so arming it may not work.",
      "when": "Abnormal. Also lights in the lights test.",
      "action": "Leave the lever DOWN and raise it by hand after touchdown.",
      "normal": false
    },
    {
      "locator": "mn/cl/STAB OUT OF TRIM/1",
      "meaning": "With the autopilot on, the stabilizer is not trimming correctly, so the airplane may be out of trim when the autopilot comes off.",
      "when": "Abnormal. Only works with the autopilot engaged, except after landing below 30 knots, when it shows a partial flight computer fault.",
      "action": "Hold the column firmly before you disconnect the autopilot, and be ready to trim by hand. If it lights on the ground after landing, do not take off again until it is fixed.",
      "normal": false
    },
    {
      "locator": "mn/cl/SPEED BRAKE ARMED/1",
      "meaning": "The speedbrake is armed and will deploy by itself on touchdown.",
      "when": "Normal on the approach once you arm the lever.",
      "action": "No action needed.",
      "normal": true
    },
    {
      "locator": "mn/ctr/LEFT GEAR/1",
      "meaning": "The left main gear is moving or not where the gear lever says, or it is not down and locked with a thrust lever at idle below 800 ft.",
      "when": "Normal while the gear is moving. Abnormal if it stays on.",
      "action": "If it stays on, run the gear checklist. Do not land until you have three green lights.",
      "normal": true
    },
    {
      "locator": "mn/ctr/LEFT GEAR/2",
      "meaning": "The left main gear is down and locked.",
      "when": "Normal on the ground and with the gear down.",
      "action": "No action needed.",
      "normal": true
    },
    {
      "locator": "mn/ctr/NOSE GEAR/1",
      "meaning": "The nose gear is moving or not where the gear lever says, or it is not down and locked with a thrust lever at idle below 800 ft.",
      "when": "Normal while the gear is moving. Abnormal if it stays on.",
      "action": "If it stays on, run the gear checklist. Do not land until you have three green lights.",
      "normal": true
    },
    {
      "locator": "mn/ctr/NOSE GEAR/2",
      "meaning": "The nose gear is down and locked.",
      "when": "Normal on the ground and with the gear down.",
      "action": "No action needed.",
      "normal": true
    },
    {
      "locator": "mn/ctr/RIGHT GEAR/1",
      "meaning": "The right main gear is moving or not where the gear lever says, or it is not down and locked with a thrust lever at idle below 800 ft.",
      "when": "Normal while the gear is moving. Abnormal if it stays on.",
      "action": "If it stays on, run the gear checklist. Do not land until you have three green lights.",
      "normal": true
    },
    {
      "locator": "mn/ctr/RIGHT GEAR/2",
      "meaning": "The right main gear is down and locked.",
      "when": "Normal on the ground and with the gear down.",
      "action": "No action needed.",
      "normal": true
    },
    {
      "locator": "mn/fl/SPEEDBRAKES EXTENDED/1",
      "meaning": "In flight, the speedbrake lever is beyond ARMED while below 800 ft, with flaps beyond 10, or with thrust held above idle for more than a few seconds. On the ground, the lever is DOWN but the ground spoilers have not stowed.",
      "when": "Abnormal.",
      "action": "In flight, stow the speedbrake lever. On the ground, run the checklist.",
      "normal": false
    },
    {
      "locator": "mn/gp/GND PROX INOP/1",
      "meaning": "The ground proximity warning system has a fault, so terrain warnings may not work.",
      "when": "Abnormal. It may show briefly at power up.",
      "action": "Fly with extra care near terrain and check the GPWS switches.",
      "normal": false
    },
    {
      "locator": "con/ed/AUTO BRAKE DISARM/1",
      "meaning": "The autobrake has disarmed, for example after manual braking, thrust being advanced or the speedbrake lever going down, or it has a fault.",
      "when": "Normal for 1 to 2 seconds when you select RTO, and when you brake by hand after landing.",
      "action": "Turn the autobrake selector OFF to clear the light, then brake by hand. If it stays on with RTO selected before takeoff, the autobrake has a fault.",
      "normal": true
    },
    {
      "locator": "con/lo/PARK BRAKE LIGHT/1",
      "meaning": "The parking brake is holding the airplane.",
      "when": "Normal at the gate and during engine start. It must be out before taxi.",
      "action": "Release the parking brake before you taxi.",
      "normal": true
    },
    {
      "locator": "con/fi/ENG 1 OVERHEAT/1",
      "meaning": "The detectors around engine 1 sense more heat than normal, but not a fire.",
      "when": "Abnormal. Also lights in the fire test.",
      "action": "Disconnect the autothrottle and slowly close the engine 1 thrust lever. If the light stays on, run the rest of the engine overheat checklist, which may lead to shutting the engine down.",
      "normal": false
    },
    {
      "locator": "con/fi/ENG 2 OVERHEAT/1",
      "meaning": "The detectors around engine 2 sense more heat than normal, but not a fire.",
      "when": "Abnormal. Also lights in the fire test.",
      "action": "Disconnect the autothrottle and slowly close the engine 2 thrust lever. If the light stays on, run the rest of the engine overheat checklist, which may lead to shutting the engine down.",
      "normal": false
    },
    {
      "locator": "con/fi/FAULT/1",
      "meaning": "With the detection switch at NORMAL, both detector loops on one engine have failed. With A or B selected, that loop has failed. A fire there may not be detected. It does not light MASTER CAUTION.",
      "when": "Abnormal. Also lights in the FAULT/INOP test.",
      "action": "Run the checklist and watch that engine closely.",
      "normal": false
    },
    {
      "locator": "con/fi/APU DET INOP/1",
      "meaning": "The APU fire detector loop has failed, so an APU fire may not be detected.",
      "when": "Abnormal. Also lights in the FAULT/INOP test.",
      "action": "Run the APU detection checklist.",
      "normal": false
    },
    {
      "locator": "con/fi/APU BOTTLE DISCHARGE/1",
      "meaning": "The APU fire bottle is empty or has lost pressure.",
      "when": "Normal only after you have fired it.",
      "action": "There is no extinguisher left for the APU. If you fired it for a fire, leave the APU off. Otherwise it needs servicing before flight.",
      "normal": false
    },
    {
      "locator": "con/fi/L BOTTLE DISCHARGE/1",
      "meaning": "The left engine fire bottle has been fired or has lost pressure.",
      "when": "Normal only after you have fired it.",
      "action": "That bottle cannot be used again. The right bottle may still be available.",
      "normal": false
    },
    {
      "locator": "con/fi/R BOTTLE DISCHARGE/1",
      "meaning": "The right engine fire bottle has been fired or has lost pressure.",
      "when": "Normal only after you have fired it.",
      "action": "That bottle cannot be used again. The left bottle may still be available.",
      "normal": false
    },
    {
      "locator": "con/fi/L/1",
      "meaning": "The firing circuit for the left engine bottle tested good.",
      "when": "Normal only during the extinguisher test.",
      "action": "No action. If it stays dark during the test, report the fault.",
      "normal": true
    },
    {
      "locator": "con/fi/R/1",
      "meaning": "The firing circuit for the right engine bottle tested good.",
      "when": "Normal only during the extinguisher test.",
      "action": "No action. If it stays dark during the test, report the fault.",
      "normal": true
    },
    {
      "locator": "con/fi/APU/1",
