    {
      "locator": "oh/air/ZONE TEMP/1",
      "meaning": "The duct air going to the flight deck has overheated, or that zone's temperature control has failed.",
      "when": "Abnormal.",
      "action": "Run the zone temperature checklist. After a duct overheat, select a cooler temperature and press TRIP RESET once it has cooled.",
      "normal": false
    },
    {
      "locator": "oh/air/ZONE TEMP/2",
      "meaning": "The duct air going to the forward cabin has overheated, or that zone's temperature control has failed.",
      "when": "Abnormal.",
      "action": "Run the zone temperature checklist. After a duct overheat, select a cooler temperature and press TRIP RESET once it has cooled.",
      "normal": false
    },
    {
      "locator": "oh/air/ZONE TEMP/3",
      "meaning": "The duct air going to the rear cabin has overheated, or that zone's temperature control has failed.",
      "when": "Abnormal.",
      "action": "Run the zone temperature checklist. After a duct overheat, select a cooler temperature and press TRIP RESET once it has cooled.",
      "normal": false
    },
    {
      "locator": "oh/bleed/DUAL BLEED/1",
      "meaning": "The APU bleed valve is open while engine 1 bleed is ON, or engine 2 bleed is ON with the isolation valve open, so engine air could push back into the APU.",
      "when": "Normal at the gate and during engine start whenever the APU bleed is on with the engine bleed switches ON. It goes out when the APU bleed goes off.",
      "action": "Keep the thrust near idle while it is on, and switch the APU bleed off after start.",
      "normal": true
    },
    {
      "locator": "oh/bleed/PACK/1",
      "meaning": "That air conditioning pack has shut down from overheating, or has failed.",
      "when": "Abnormal.",
      "action": "Run the pack checklist. Once it has cooled, select a warmer temperature and press TRIP RESET. A control failure may not reset.",
      "normal": false
    },
    {
      "locator": "oh/bleed/PACK/2",
      "meaning": "That air conditioning pack has shut down from overheating, or has failed.",
      "when": "Abnormal.",
      "action": "Run the pack checklist. Once it has cooled, select a warmer temperature and press TRIP RESET. A control failure may not reset.",
      "normal": false
    },
    {
      "locator": "oh/bleed/WING-BODY OVERHEAT/1",
      "meaning": "Hot bleed air is leaking from a duct on the left side: the left engine strut, left wing, left air conditioning bay, the area under the cabin floor, or the APU bleed duct.",
      "when": "Abnormal.",
      "action": "Run the wing-body overheat checklist. It usually means shutting off that side's bleed air.",
      "normal": false
    },
    {
      "locator": "oh/bleed/WING-BODY OVERHEAT/2",
      "meaning": "Hot bleed air is leaking from a duct on the right side: the right engine strut, right wing or right air conditioning bay.",
      "when": "Abnormal.",
      "action": "Run the wing-body overheat checklist. It usually means shutting off that side's bleed air.",
      "normal": false
    },
    {
      "locator": "oh/bleed/BLEED/1",
      "meaning": "That engine bleed valve has shut because the bleed air was too hot, or its pressure too high or too low, or the bleed system has failed. It can also mean the bleeds are set wrong after takeoff or a go-around.",
      "when": "Abnormal.",
      "action": "Check both engine BLEED switches are ON. Then run the bleed checklist, and press TRIP RESET once it has cooled. A system failure may not reset.",
      "normal": false
    },
    {
      "locator": "oh/bleed/BLEED/2",
      "meaning": "That engine bleed valve has shut because the bleed air was too hot, or its pressure too high or too low, or the bleed system has failed. It can also mean the bleeds are set wrong after takeoff or a go-around.",
      "when": "Abnormal.",
      "action": "Check both engine BLEED switches are ON. Then run the bleed checklist, and press TRIP RESET once it has cooled. A system failure may not reset.",
      "normal": false
    },
    {
      "locator": "oh/press/AUTO FAIL/1",
      "meaning": "An automatic pressure controller has failed. With ALTN also lit, one controller failed and the other took over. Lit alone, both have failed.",
      "when": "Abnormal.",
      "action": "If ALTN is also lit, the standby controller has taken over: set the mode selector to ALTN. If AUTO FAIL is lit alone, control the cabin in MAN and run the checklist.",
      "normal": false
    },
    {
      "locator": "oh/press/OFF SCHED DESCENT/1",
      "meaning": "You started down before reaching the cruise altitude set on the panel. The controller assumes you are going back, and takes the cabin toward the departure airport's elevation.",
      "when": "Happens after an early descent, for example a return to the departure airport.",
      "action": "If you are returning to the departure airport, no action is needed. If you will land somewhere else or climb again, reset FLT ALT and LAND ALT and watch the cabin.",
      "normal": true
    },
    {
      "locator": "oh/press/ALTN/1",
      "meaning": "The standby pressure controller is in use, after a fault or because you selected it.",
      "when": "Can show after a controller fault.",
      "action": "No action while the cabin is under control. Monitor it.",
      "normal": true
    },
    {
      "locator": "oh/press/MANUAL/1",
      "meaning": "Pressurization is in manual mode, so you move the outflow valve yourself.",
      "when": "Normal only when you have selected MAN.",
      "action": "Control the outflow valve with its switch, or go back to AUTO if you did not mean to select MAN.",
      "normal": true
    },
    {
      "locator": "aft/elt/ELT/1",
      "meaning": "The emergency locator transmitter is sending a distress signal.",
      "when": "Abnormal, unless during a short test.",
      "action": "Set the ELT switch back to ARMED and tell ATC if it went off by accident.",
      "normal": false
    },
    {
      "locator": "aft/irs/GPS/1",
      "meaning": "Both GPS receivers have failed. A failure of only one shows only on MASTER CAUTION recall.",
      "when": "Abnormal.",
      "action": "Check the FMC position. RNAV approaches may not be available.",
      "normal": false
    },
    {
      "locator": "aft/irs/ILS/1",
      "meaning": "Both ILS receivers have failed, so the localizer and glideslope are not usable. A failure of only one shows only on MASTER CAUTION recall.",
      "when": "Abnormal.",
      "action": "Plan a different approach. After a single failure on recall, use the side that still works.",
      "normal": false
    },
    {
      "locator": "aft/irs/GLS/1",
      "meaning": "Both GLS receivers have failed, so satellite based landing guidance is not available. A single failure shows only on recall.",
      "when": "Abnormal.",
      "action": "Plan an ILS or another approach.",
      "normal": false
    },
    {
      "locator": "aft/irs/ALIGN/1",
      "meaning": "The left IRS is still finding its position and heading, so the airplane must stay still.",
      "when": "Normal for several minutes after you select NAV. Flashing means alignment cannot finish, for example no position was entered or it differs a lot from the last one.",
      "action": "Wait without moving the airplane. If it flashes, check the position entered in the FMC.",
      "normal": true
    },
    {
      "locator": "aft/irs/ALIGN/2",
      "meaning": "The right IRS is still finding its position and heading, so the airplane must stay still.",
      "when": "Normal for several minutes after you select NAV. Flashing means alignment cannot finish, for example no position was entered or it differs a lot from the last one.",
      "action": "Wait without moving the airplane. If it flashes, check the position entered in the FMC.",
      "normal": true
    },
    {
      "locator": "aft/irs/ON DC/1",
      "meaning": "The left IRS is running on battery power because its normal AC power is lost.",
      "when": "Normal for a few seconds at switch on during the self test. Abnormal later.",
      "action": "If it stays on, get AC power on the buses, because the battery will run down. On the ground a horn in the nose wheel well warns of this.",
      "normal": true
    },
    {
      "locator": "aft/irs/ON DC/2",
      "meaning": "The right IRS is running on battery power because its normal AC power is lost.",
      "when": "Normal for a few seconds at switch on during the self test. Abnormal later.",
      "action": "If it stays on, get AC power on the buses, because the battery will run down. On the ground a horn in the nose wheel well warns of this.",
      "normal": true
    },
    {
      "locator": "aft/irs/FAULT/1",
      "meaning": "The left IRS has a fault and its attitude or navigation data may be lost.",
      "when": "Abnormal.",
      "action": "Run the IRS fault checklist. You may need to realign it or use the other IRS.",
      "normal": false
    },
    {
      "locator": "aft/irs/FAULT/2",
      "meaning": "The right IRS has a fault and its attitude or navigation data may be lost.",
      "when": "Abnormal.",
      "action": "Run the IRS fault checklist. You may need to realign it or use the other IRS.",
      "normal": false
    },
    {
      "locator": "aft/irs/DC FAIL/1",
      "meaning": "The left IRS has lost its battery backup.",
      "when": "Abnormal.",
      "action": "It keeps running on AC. Note it, and watch for an ON DC light.",
      "normal": false
    },
    {
      "locator": "aft/irs/DC FAIL/2",
      "meaning": "The right IRS has lost its battery backup.",
      "when": "Abnormal.",
      "action": "It keeps running on AC. Note it, and watch for an ON DC light.",
      "normal": false
    },
