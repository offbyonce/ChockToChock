      "action": "You can now switch ground power on.",
      "normal": true
    },
    {
      "locator": "oh/elecl/GEN OFF BUS/1",
      "meaning": "The engine 1 generator is not powering its transfer bus.",
      "when": "Normal before engine start and after shutdown. Abnormal with the engine running and the switch on.",
      "action": "After start, switch the generator on. If it stays on, check the DRIVE light and run the checklist.",
      "normal": true
    },
    {
      "locator": "oh/elecl/GEN OFF BUS/2",
      "meaning": "The engine 2 generator is not powering its transfer bus.",
      "when": "Normal before engine start and after shutdown. Abnormal with the engine running and the switch on.",
      "action": "After start, switch the generator on. If it stays on, check the DRIVE light and run the checklist.",
      "normal": true
    },
    {
      "locator": "oh/elecl/APU GEN OFF BUS/1",
