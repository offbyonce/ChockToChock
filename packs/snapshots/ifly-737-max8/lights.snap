      "action": "No action. If it stays dark during the test, report the fault.",
      "normal": true
    },
    {
      "locator": "con/cf/EXT FWD/1",
      "meaning": "The firing circuit for the forward hold fire bottle tested good.",
      "when": "Normal only during the cargo fire test.",
      "action": "No action needed.",
      "normal": true
    },
