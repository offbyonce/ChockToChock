---
source: crates/pack-cli/tests/snapshot.rs
---
{
  "lights": [
    {
      "locator": "oh/fctl/LOW QUANTITY/1",
      "meaning": "The standby hydraulic reservoir is running low on fluid.",
      "when": "Abnormal at any time.",
      "action": "Check the hydraulic quantities and run the standby hydraulic checklist.",
      "normal": false
    },
    {
      "locator": "oh/fctl/LOW PRESSURE/1",
      "meaning": "The standby hydraulic pump is selected to run but is not giving pressure.",
      "when": "Abnormal. Normally out, because the standby pump only runs when needed.",
      "action": "If you need the standby system, run the standby hydraulic checklist.",
      "normal": false
    },
    {
      "locator": "oh/fctl/STBY RUD ON/1",
      "meaning": "The standby hydraulic system is powering the rudder, because a flight control switch is at STBY RUD or it switched on by itself.",
      "when": "Normal when you select STBY RUD during the flight control check. If you did not select it, it came on by itself, usually because system A or B lost pressure, or because of a rudder fault.",
      "action": "If you did not select it, check hydraulic systems A and B and run the related checklist.",
      "normal": true
    },
    {
      "locator": "oh/fctl/LOW PRESSURE/2",
      "meaning": "Hydraulic system A is not giving pressure to the ailerons, elevator and rudder.",
      "when": "Normal before the hydraulic pumps are on, or with FLT CONTROL A switched OFF. It goes out with the switch at STBY RUD, once the standby rudder valve opens. Abnormal in flight.",
      "action": "On the ground, switch the hydraulic pumps on. In flight, check system A pressure and quantity and run the checklist.",
      "normal": true
    },
    {
      "locator": "oh/fctl/LOW PRESSURE/3",
      "meaning": "Hydraulic system B is not giving pressure to the ailerons, elevator and rudder.",
      "when": "Normal before the hydraulic pumps are on, or with FLT CONTROL B switched OFF. It goes out with the switch at STBY RUD, once the standby rudder valve opens. Abnormal in flight.",
      "action": "On the ground, switch the hydraulic pumps on. In flight, check system B pressure and quantity and run the checklist.",
      "normal": true
    },
    {
      "locator": "oh/fctl/FEEL DIFF PRESS/1",
      "meaning": "The elevator feel computer senses too big a pressure difference between its two hydraulic inputs, so the column feel may be wrong.",
      "when": "Abnormal.",
      "action": "Run the feel differential pressure checklist.",
      "normal": false
    },
    {
      "locator": "oh/fctl/SPEED TRIM FAIL/1",
      "meaning": "Speed trim and MCAS are both off. On the MAX this happens if either one fails, or if the two angle of attack vanes disagree by more than about 5.5 degrees. It then stays on for the rest of the flight.",
      "when": "Abnormal. A fault in only one channel shows only when you press MASTER CAUTION to recall.",
      "action": "Run the speed trim fail checklist and expect to trim more by hand.",
      "normal": false
    },
    {
      "locator": "oh/fctl/MACH TRIM FAIL/1",
      "meaning": "Mach trim, which stops the nose tucking down at high Mach, is not working.",
      "when": "Abnormal. A fault in only one channel shows only on MASTER CAUTION recall.",
      "action": "Run the checklist and keep your speed within the limit it gives.",
      "normal": false
    },
    {
      "locator": "oh/fctl/AUTO SLAT FAIL/1",
      "meaning": "The system that moves the slats to full extend near the stall is not working.",
      "when": "Abnormal. A fault in only one stall management computer shows only on MASTER CAUTION recall.",
      "action": "Run the checklist and keep good speed margins, especially with flaps out.",
      "normal": false
    },
    {
      "locator": "oh/fctl/SPOILERS/1",
      "meaning": "A fault in spoiler control, so some spoilers may not move.",
      "when": "Abnormal. Normally out.",
      "action": "Run the checklist and expect less roll help and less speedbrake effect.",
      "normal": false
    },
    {
      "locator": "oh/fctl/YAW DAMPER/1",
      "meaning": "Nothing is damping Dutch roll, because the yaw damper is not engaged.",
      "when": "Normal before hydraulic system B has pressure and the switch is ON. Abnormal in flight.",
      "action": "Check FLT CONTROL B and system B pressure, then switch the yaw damper off and on. In flight, fly smoothly and run the checklist.",
      "normal": true
    },
    {
      "locator": "oh/fuel/FILTER BYPASS/1",
      "meaning": "The engine 1 fuel filter is clogging, often from contamination or ice, and fuel may soon go around it.",
      "when": "Abnormal.",
      "action": "Run the filter bypass checklist and watch engine 1 closely.",
      "normal": false
    },
    {
      "locator": "oh/fuel/FILTER BYPASS/2",
      "meaning": "The engine 2 fuel filter is clogging, often from contamination or ice, and fuel may soon go around it.",
      "when": "Abnormal.",
      "action": "Run the filter bypass checklist and watch engine 2 closely.",
      "normal": false
    },
    {
      "locator": "oh/fuel/LOW PRESSURE/1",
      "meaning": "This center tank pump is switched on but not delivering fuel. With both center lights on, the center tank is empty.",
      "when": "Expected near the end of the center tank fuel.",
      "action": "When both center lights are on, switch both center pumps OFF.",
      "normal": true
    },
    {
      "locator": "oh/fuel/LOW PRESSURE/2",
      "meaning": "This center tank pump is switched on but not delivering fuel. With both center lights on, the center tank is empty.",
      "when": "Expected near the end of the center tank fuel.",
      "action": "When both center lights are on, switch both center pumps OFF.",
      "normal": true
    },
    {
      "locator": "oh/fuel/LOW PRESSURE/3",
      "meaning": "This wing tank pump is not delivering fuel, or it is switched off.",
      "when": "Normal before start with the pumps off. Abnormal with the pump on. One light alone does not set MASTER CAUTION; both lights in the same tank do.",
      "action": "Before start, switch the pumps on and check the light goes out. In flight, switch that pump OFF and run the fuel pump low pressure checklist.",
      "normal": true
    },
    {
      "locator": "oh/fuel/LOW PRESSURE/4",
      "meaning": "This wing tank pump is not delivering fuel, or it is switched off.",
      "when": "Normal before start with the pumps off. Abnormal with the pump on. One light alone does not set MASTER CAUTION; both lights in the same tank do.",
      "action": "Before start, switch the pumps on and check the light goes out. In flight, switch that pump OFF and run the fuel pump low pressure checklist.",
      "normal": true
    },
    {
      "locator": "oh/fuel/LOW PRESSURE/5",
      "meaning": "This wing tank pump is not delivering fuel, or it is switched off.",
      "when": "Normal before start with the pumps off. Abnormal with the pump on. One light alone does not set MASTER CAUTION; both lights in the same tank do.",
      "action": "Before start, switch the pumps on and check the light goes out. In flight, switch that pump OFF and run the fuel pump low pressure checklist.",
      "normal": true
    },
    {
      "locator": "oh/fuel/LOW PRESSURE/6",
      "meaning": "This wing tank pump is not delivering fuel, or it is switched off.",
      "when": "Normal before start with the pumps off. Abnormal with the pump on. One light alone does not set MASTER CAUTION; both lights in the same tank do.",
      "action": "Before start, switch the pumps on and check the light goes out. In flight, switch that pump OFF and run the fuel pump low pressure checklist.",
      "normal": true
    },
    {
      "locator": "oh/fuel/ENG VALVE CLOSED/1",
      "meaning": "Shows the engine 1 fuel valve: dim when closed, out when open, bright while moving or if it disagrees with the start lever.",
      "when": "Dim with the start lever at CUTOFF, out with it at IDLE.",
      "action": "If it stays bright, run the fuel valve checklist.",
      "normal": true
    },
    {
      "locator": "oh/fuel/SPAR VALVE CLOSED/1",
      "meaning": "Shows the engine 1 spar valve: dim when closed, out when open, bright while moving or if it disagrees with the start lever.",
      "when": "Dim with the start lever at CUTOFF, out with it at IDLE.",
      "action": "If it stays bright, run the fuel valve checklist.",
      "normal": true
    },
    {
      "locator": "oh/fuel/ENG VALVE CLOSED/2",
      "meaning": "Shows the engine 2 fuel valve: dim when closed, out when open, bright while moving or if it disagrees with the start lever.",
      "when": "Dim with the start lever at CUTOFF, out with it at IDLE.",
      "action": "If it stays bright, run the fuel valve checklist.",
      "normal": true
    },
    {
      "locator": "oh/fuel/SPAR VALVE CLOSED/2",
      "meaning": "Shows the engine 2 spar valve: dim when closed, out when open, bright while moving or if it disagrees with the start lever.",
      "when": "Dim with the start lever at CUTOFF, out with it at IDLE.",
      "action": "If it stays bright, run the fuel valve checklist.",
      "normal": true
    },
    {
      "locator": "oh/fuel/VALVE OPEN/1",
      "meaning": "The fuel crossfeed valve is open (dim), or moving or not matching the selector (bright).",
      "when": "Dim only while you are balancing fuel.",
      "action": "Keep crossfeed closed unless you are balancing fuel. If it stays bright, run the checklist.",
      "normal": true
    },
    {
      "locator": "oh/elecu/BAT DISCHARGE/1",
      "meaning": "Current is flowing out of the battery faster than normal, so it is running down.",
      "when": "Can show on battery power alone during a cold start. Abnormal once other power is on.",
      "action": "Get ground power or the APU generator on the buses quickly. In flight, run the checklist.",
      "normal": true,
      "status": "draft"
    },
    {
      "locator": "oh/elecu/TR UNIT/1",
      "meaning": "A unit that turns AC into DC power has failed. On the ground any one of the three lights it. In flight it lights only if TR 1 fails, or if TR 2 and TR 3 both fail.",
      "when": "Abnormal.",
      "action": "Run the TR unit checklist and expect less DC power redundancy.",
      "normal": false
    },
    {
      "locator": "oh/elecu/ELEC/1",
      "meaning": "A DC or standby power fault that must be fixed before flight. It only shows on the ground.",
      "when": "Abnormal, ground only.",
      "action": "Do not take off. Check the electrical panel and, in the sim, any failures you have set.",
      "normal": false
    },
    {
      "locator": "oh/elecm/DRIVE 1/1",
      "meaning": "Generator drive 1 has low oil pressure or low speed: engine 1 is stopped, or the drive has failed or been disconnected.",
      "when": "Normal before start with engine 1 stopped. Abnormal with the engine running.",
      "action": "Before start, ignore it. With the engine running, run the drive checklist. If it tells you to disconnect, use the guarded drive disconnect switch. The drive cannot be reconnected in flight.",
      "normal": true
    },
    {
      "locator": "oh/elecm/DRIVE 2/1",
      "meaning": "Generator drive 2 has low oil pressure or low speed: engine 2 is stopped, or the drive has failed or been disconnected.",
      "when": "Normal before start with engine 2 stopped. Abnormal with the engine running.",
      "action": "Before start, ignore it. With the engine running, run the drive checklist. If it tells you to disconnect, use the guarded drive disconnect switch. The drive cannot be reconnected in flight.",
      "normal": true
    },
    {
      "locator": "oh/elecm/STANDBY PWR OFF/1",
      "meaning": "The AC standby bus, DC standby bus or battery bus has no power, or the STANDBY POWER switch is OFF. Some essential instruments may be dark.",
      "when": "Abnormal. Normally out with the battery on and the standby power switch at AUTO.",
      "action": "Check the standby power switch is at AUTO and the battery is on, then run the checklist.",
      "normal": false,
      "status": "draft"
    },
    {
      "locator": "oh/elecl/TRANSFER BUS OFF/1",
      "meaning": "Transfer bus 1 has no power, so the systems on it are off.",
      "when": "Normal before any AC power is selected. Abnormal once a generator or ground power is on.",
      "action": "Select a power source for that bus: ground power, the APU generator or an engine generator.",
      "normal": true
    },
    {
      "locator": "oh/elecl/TRANSFER BUS OFF/2",
      "meaning": "Transfer bus 2 has no power, so the systems on it are off.",
      "when": "Normal before any AC power is selected. Abnormal once a generator or ground power is on.",
      "action": "Select a power source for that bus: ground power, the APU generator or an engine generator.",
      "normal": true
    },
    {
      "locator": "oh/elecl/SOURCE OFF/1",
      "meaning": "No source has been selected for transfer bus 1, or the source you selected has been disconnected.",
      "when": "Normal on battery power before you select ground power or the APU generator.",
      "action": "Switch ground power, the APU generator or the engine 1 generator onto the bus.",
      "normal": true
    },
    {
      "locator": "oh/elecl/SOURCE OFF/2",
      "meaning": "No source has been selected for transfer bus 2, or the source you selected has been disconnected.",
      "when": "Normal on battery power before you select ground power or the APU generator.",
      "action": "Switch ground power, the APU generator or the engine 2 generator onto the bus.",
      "normal": true
    },
    {
      "locator": "oh/elecl/GRD POWER AVAILABLE/1",
