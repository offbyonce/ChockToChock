    "size": { "caption": 12, "secondary": 14, "body": 16, "panel-title": 20, "section-title": 24, "page-title": 32, "value-mono": 15, "flow-title": 48, "flow-value": 32 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "drawing": { "$comment": "Minimum rendered sizes inside drawings at the smallest size each drawing is shown.", "label-min": 11, "light-legend-min": 10 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "10": 40 },
  "radius": { "small": 6, "control": 10, "segment": 12, "panel": 12, "sheet": 16, "pill": 999 },
  "size": {
    "touch-min": 44,
    "header": 60,
    "phase-row": 60,
    "flight-strip": 48,
    "side-pane": 520,
    "flight-section-nav": 232,
    "row-padding-y": 12,
    "content-max": 1040,
    "toggle": { "width": 52, "height": 30, "knob": 24 },
    "focus-ring": 1.5
  },
  "layout": {
    "breakpoints": { "phone-max": 599, "tablet-portrait-max": 899, "tablet-landscape-max": 1439 },
    "scale": "max(1, min(width / 1440, height / 900))",
    "gutter": { "desktop": 32, "tablet": 20, "phone": 16 }
  }
